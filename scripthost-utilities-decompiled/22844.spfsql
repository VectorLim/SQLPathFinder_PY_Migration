# ---- boundary_evidence.config ----

DARK_BOUNDARY_SENSITIVITY = 1.0

DARK_BOUNDARY_ANCHOR_DEPTH_PX = 10


# ---- core.masks ----

LOCALISATION_DARKNESS_LEVEL = 0.95

def centered_slice(center: int, half: int, limit: int) -> slice:
    return slice(max(0, center - half), min(limit, center + half + 1))

def is_border_clipped_rectangle(
    x: int,
    y: int,
    width: int,
    height: int,
    image_shape: tuple[int, int],
    min_side: int,
    tolerance: int,
) -> bool:
    """Accept a substantial rectangle shortened only by the image boundary."""
    image_height, image_width = image_shape
    if (
        min(width, height) < max(2, 2 * tolerance)
        or max(width, height) < min_side
    ):
        return False
    return (
        height < min_side and (y == 0 or y + height == image_height)
    ) or (
        width < min_side and (x == 0 or x + width == image_width)
    )

def robust_level(values: np.ndarray) -> tuple[float, float]:
    """Median level and a seed-relative tolerance covering its normal variation."""
    values = np.asarray(values, dtype=np.float32)
    level = float(np.median(values))
    tolerance = float(np.quantile(np.abs(values - level), LOCALISATION_DARKNESS_LEVEL))
    return level, tolerance

def touches_image_frame(mask: np.ndarray) -> bool:
    """Return whether foreground reaches any physical image edge."""
    if cv2.countNonZero(mask) == 0:
        return False
    x, y, width, height = cv2.boundingRect(mask)
    image_height, image_width = mask.shape
    return x == 0 or y == 0 or x + width == image_width or y + height == image_height

def is_compact_component(mask: np.ndarray, minimum_fill: float) -> bool:
    """Return whether foreground substantially fills its own bounding box."""
    x, y, width, height = cv2.boundingRect(mask)
    if width == 0 or height == 0:
        return False
    return cv2.countNonZero(mask) >= width * height * minimum_fill

def component_connected_to_seed(mask: np.ndarray, seed: np.ndarray) -> np.ndarray:
    count, labels = cv2.connectedComponents(mask)
    if count <= 1:
        return seed
    connected = np.bincount(labels[seed > 0], minlength=count) > 0
    connected[0] = False
    if not np.any(connected):
        return seed
    return np.where(connected[labels], 255, 0).astype(np.uint8)

def fill_enclosed_holes(mask: np.ndarray, close_size: int = 5) -> np.ndarray:
    """Connect nearby sparse pixels, then fill the enclosed region."""
    binary = np.where(mask > 0, 255, 0).astype(np.uint8)
    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (close_size, close_size))
    closed = cv2.morphologyEx(binary, cv2.MORPH_CLOSE, kernel)

    padded = cv2.copyMakeBorder(
        closed, 1, 1, 1, 1, cv2.BORDER_CONSTANT, value=0
    )
    flooded = padded.copy()
    flood_mask = np.zeros(
        (padded.shape[0] + 2, padded.shape[1] + 2), dtype=np.uint8
    )
    cv2.floodFill(flooded, flood_mask, seedPoint=(0, 0), newVal=255)

    holes = cv2.bitwise_not(flooded)
    return cv2.bitwise_or(padded, holes)[1:-1, 1:-1]


# ---- debug.config ----

RED = (0, 0, 255)

