# ---- boundary_evidence.frame_filter ----

_MIN_FRAME_CONTACT_PX = 2

def _dark_boundary_long_frame_runs(values: np.ndarray, minimum: int) -> np.ndarray:
    """Keep only contiguous transverse runs long enough to establish a corridor."""
    kept = np.zeros_like(values, dtype=bool)
    indices = np.flatnonzero(values)
    if not len(indices):
        return kept
    cuts = np.flatnonzero(np.diff(indices) > 1) + 1
    for run in np.split(indices, cuts):
        if len(run) >= minimum:
            kept[run] = True
    return kept

def _dark_boundary_frame_corridor(
    region: np.ndarray,
    die: np.ndarray,
    tolerance: int,
    *,
    axis: int,
    reverse: bool,
) -> np.ndarray:
    """Return the frame-to-die part of a strong candidate along one axis."""
    oriented_region = np.flip(region, axis=axis) if reverse else region
    oriented_die = np.flip(die, axis=axis) if reverse else die
    depth = np.count_nonzero(np.cumprod(oriented_region, axis=axis), axis=axis)
    transverse = np.arange(depth.size)
    limit = oriented_region.shape[axis]
    # Some transverse positions may be candidate-filled all the way to the
    # opposite image side.  They cannot form a frame-to-die corridor, but must
    # be clipped before indexing the next pixel.
    next_depth = np.minimum(depth, limit - 1)
    next_is_die = (
        oriented_die[next_depth, transverse]
        if axis == 0
        else oriented_die[transverse, next_depth]
    )
    valid = (depth > 0) & (depth < limit) & next_is_die
    valid = _dark_boundary_long_frame_runs(
        valid,
        max(_MIN_FRAME_CONTACT_PX, tolerance + 1),
    )
    if not np.any(valid):
        return np.zeros_like(region, dtype=bool)

    normal = np.arange(limit)
    corridor = (
        normal[:, None] < depth[None, :]
        if axis == 0
        else normal[None, :] < depth[:, None]
    )
    corridor &= valid[None, :] if axis == 0 else valid[:, None]
    corridor &= oriented_region
    return np.flip(corridor, axis=axis) if reverse else corridor

def _dark_boundary_reaches_opposite_side(
    candidates: np.ndarray,
    region: np.ndarray,
    inside: np.ndarray,
    radius: int,
    tolerance: int,
    *,
    axis: int,
    reverse: bool,
) -> bool:
    """Whether a frame-connected candidate also reaches the opposing die side."""
    connected = component_connected_to_seed(
        candidates.astype(np.uint8), region.astype(np.uint8)
    ) > 0
    oriented_connected = np.flip(connected, axis=axis) if reverse else connected
    oriented_inside = np.flip(inside, axis=axis) if reverse else inside
    if axis == 1:
        oriented_connected = oriented_connected.T
        oriented_inside = oriented_inside.T

    positions = np.arange(oriented_inside.shape[0])[:, None]
    opposite_die = np.max(
        np.where(oriented_inside, positions, -1), axis=0
    )
    opposite_candidate = np.max(
        np.where(oriented_connected, positions, -1), axis=0
    )
    reaches = (opposite_die >= 0) & (
        opposite_candidate >= opposite_die - radius + 1
    )
    reaches = _dark_boundary_long_frame_runs(
        reaches, max(_MIN_FRAME_CONTACT_PX, tolerance + 1)
    )
    return bool(np.any(reaches))

def _frame_die_context(inside: np.ndarray, tolerance: int) -> np.ndarray:
    """Stabilize silhouette context without removing source or evidence pixels."""
    reach = max(1, tolerance)
    kernel = np.ones((2 * reach + 1,) * 2, np.uint8)
    padded = np.pad(inside.astype(np.uint8), reach)
    opened = cv2.morphologyEx(padded, cv2.MORPH_OPEN, kernel)
    return opened[reach:-reach, reach:-reach] > 0

def _coincident_frame_span(
    context: np.ndarray, tolerance: int, axis: int, reverse: bool,
) -> tuple[int, int] | None:
    """Find the main die span if most of its side reaches the image frame.

    Median row extents keep a local side nodule outside the main die span.
    Stabilized context prevents a thin exported-image stripe from establishing
    frame coincidence across the entire die width.
    """
    oriented = context.T if axis == 1 else context
    if reverse:
        oriented = oriented[::-1]
    occupied = np.any(oriented, axis=1)
    if not np.any(occupied):
        return None
    rows = oriented[occupied]
    start = int(np.median(np.argmax(rows, axis=1)))
    stop = int(np.median(rows.shape[1] - np.argmax(rows[:, ::-1], axis=1)))
    if stop <= start:
        return None
    contact = np.any(oriented[:tolerance + 1, start:stop], axis=0)
    if np.count_nonzero(contact) * 2 <= stop - start:
        return None
    return start, stop

def _dark_boundary_frame_sandwich_rejects(
    candidates: np.ndarray,
    strong: np.ndarray,
    inside: np.ndarray,
    tolerance: int,
    radius: int | None = None,
) -> np.ndarray:
    """Reject interior corridors on mostly frame-coincident die sides.

    ``candidates`` has already been restricted to the detector's boundary search
    band.  A frame artefact can nevertheless join valid evidence on the
    opposite die side into one connected component.  In that case, frame
    contact is evidence only for the corridor normal to that frame side; it
    must not discard every pixel in the connected component. Frame contact alone
    does not reject an outward nodule or a protrusion beyond the main die side.
    """
    seeds = candidates & strong
    count, labels, stats, _ = cv2.connectedComponentsWithStats(
        seeds.astype(np.uint8), 8
    )
    rejected = np.zeros_like(candidates, dtype=bool)
    image_height, image_width = candidates.shape
    context: np.ndarray | None = None
    spans: dict[tuple[int, bool], tuple[int, int] | None] = {}

    for region_id in range(1, count):
        x, y, width, height, _ = map(int, stats[region_id])
        if width == height:
            continue

        sides: list[tuple[int, bool]] = []
        if width > height:
            if y == 0:
                sides.append((0, False))
            if y + height == image_height:
                sides.append((0, True))
        else:
            if x == 0:
                sides.append((1, False))
            if x + width == image_width:
                sides.append((1, True))
        if not sides:
            continue

        region = labels == region_id
        die = inside & ~region
        corridor = np.zeros_like(region, dtype=bool)
        preserves_opposite_side = False
        for axis, reverse in sides:
            corridor |= _dark_boundary_frame_corridor(
                region, die, tolerance, axis=axis, reverse=reverse
            )
            preserves_opposite_side |= radius is not None and (
                _dark_boundary_reaches_opposite_side(
                    candidates, region, inside, radius, tolerance,
                    axis=axis, reverse=reverse,
                )
            )
        if not np.any(corridor):
            continue

        # Evaluate the corridor once, then restrict rejection to the main die's
        # coincident side. Cross-axis and opposing-side evidence stay intact.
        trapped = corridor if preserves_opposite_side else region
        if context is None:
            context = _frame_die_context(inside, tolerance)
        for side in sides:
            axis, reverse = side
            if side not in spans:
                spans[side] = _coincident_frame_span(context, tolerance, axis, reverse)
            span = spans[side]
            if span is None:
                continue
            start, stop = span
            if axis == 0:
                rejected[:, start:stop] |= trapped[:, start:stop]
            else:
                rejected[start:stop, :] |= trapped[start:stop, :]
    return rejected


# ---- boundary_evidence.density ----

_CLUSTER_REACH_RADIUS_RATIO = 0.25

_CORE_WINDOW_RADIUS_RATIO = 0.75

_BOUNDARY_CORE_DEPTH_RADIUS_RATIO = 0.15

_MIN_CORE_OCCUPANCY = 0.75

_MIN_CORE_AREA_RADIUS_SQUARED_RATIO = 0.04

_LOCAL_WINDOW_RADIUS_RATIO = 0.20

_MIN_LOCAL_WINDOW_PX = 5

_FULL_DENSITY_DEPTH_RADIUS_RATIO = 0.50

_BOUNDARY_DENSITY_QUANTILE = 0.90

def _local_occupancy(
    candidates: np.ndarray, domain: np.ndarray, window: int
) -> np.ndarray:
    """Occupancy within observable domain, excluding exterior and image padding."""
    size = (window | 1,) * 2
    sums = [
        cv2.boxFilter(
            mask.astype(np.float32), -1, size, normalize=False,
            borderType=cv2.BORDER_CONSTANT,
        )
        for mask in (candidates, domain)
    ]
    return sums[0] / np.maximum(sums[1], 1.0)

def _substantial_cores(cores: np.ndarray, min_area: int) -> np.ndarray:
    _, labels, stats, _ = cv2.connectedComponentsWithStats(
        cores.astype(np.uint8), connectivity=8
    )
    substantial = stats[:, cv2.CC_STAT_AREA] >= min_area
    substantial[0] = False
    return substantial[labels]

def coherent_candidate_domain(
    candidates: np.ndarray,
    strong: np.ndarray,
    support: np.ndarray,
    labels: np.ndarray,
    stats: np.ndarray,
    boundary_distance: np.ndarray,
    boundary_depth: float,
    radius: int,
) -> np.ndarray:
    """Return density-qualified pixels; the caller enforces original anchoring.

    Labels/stats describe intact candidates and are reused from retention. Dense
    local cores seed bounded growth through original candidate pixels. Sparse
    branches cannot dilute a core's score or be rescued arbitrarily far from it.
    Strong pixels still support weak inward propagation, but do not bypass the
    cluster requirement. The caller reconnects the result to original anchors.
    """
    if not np.any(candidates):
        return np.zeros_like(candidates, dtype=bool)

    reach = max(1, round(_CLUSTER_REACH_RADIUS_RATIO * radius))
    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * reach + 1,) * 2)
    # Explicit zero padding makes closing extensive even at the image frame.
    padded = np.pad(candidates.astype(np.uint8), reach)
    closed = cv2.morphologyEx(padded, cv2.MORPH_CLOSE, kernel)
    envelope = (closed[reach:-reach, reach:-reach] > 0) & support
    envelope |= candidates
    _, clusters = cv2.connectedComponents(envelope.astype(np.uint8), connectivity=8)

    # Count distinct original members once, without component-pair searches.
    member_cluster = np.zeros(len(stats), dtype=np.int32)
    member_cluster[labels[candidates]] = clusters[candidates]
    members = np.bincount(member_cluster[1:], minlength=int(clusters.max()) + 1)
    window = max(3, round(_CORE_WINDOW_RADIUS_RATIO * radius)) | 1
    occupancy = _local_occupancy(candidates, envelope, window)
    min_core_area = max(2, round(_MIN_CORE_AREA_RADIUS_SQUARED_RATIO * radius**2))
    core_seeds = _substantial_cores(
        envelope & (occupancy >= _MIN_CORE_OCCUPANCY), min_core_area
    ) & candidates
    # Thin material can follow the observed contour at any anchoring depth.
    # Assess narrow depth strips separately so adjacent inward texture cannot
    # inflate its denominator. The same core-area requirement still applies.
    strip_depth = max(1, round(_BOUNDARY_CORE_DEPTH_RADIUS_RATIO * radius))
    contour_cores = np.zeros_like(candidates, dtype=bool)
    for start in range(0, int(np.ceil(boundary_depth)), strip_depth):
        boundary_strip = (boundary_distance > start) & (
            boundary_distance <= min(boundary_depth, start + strip_depth)
        )
        edge_occupancy = _local_occupancy(
            candidates & boundary_strip, envelope & boundary_strip, window
        )
        contour_cores |= candidates & boundary_strip & (edge_occupancy >= _MIN_CORE_OCCUPANCY)
    # Count coherent support along each original continuous boundary run. A
    # jagged rim can cross depth strips or have small breaks in its occupancy
    # score; envelope gaps must not authorize a disconnected neighbour.
    anchored_candidates = candidates & (boundary_distance <= boundary_depth)
    _, anchor_labels = cv2.connectedComponents(anchored_candidates.astype(np.uint8))
    core_area = np.bincount(anchor_labels[contour_cores], minlength=int(anchor_labels.max()) + 1)
    core_seeds |= contour_cores & (core_area[anchor_labels] >= min_core_area)
    # An isolated tiny component supplies no cluster-density evidence either way;
    # leave its local-edge/photometry decision to the existing filters.
    isolated_small = (
        (members[member_cluster] == 1)
        & (stats[:, cv2.CC_STAT_AREA] < min_core_area)
    )
    isolated_small[0] = False
    seeds = core_seeds | (isolated_small[labels] & candidates)
    clustered_domain = seeds.astype(np.uint8)
    adjacency = np.ones((3, 3), np.uint8)
    for _ in range(radius):
        grown = cv2.dilate(clustered_domain, adjacency) & candidates
        if np.array_equal(grown, clustered_domain):
            break
        clustered_domain = grown
    clustered_domain = clustered_domain > 0
    # A continuous rim may be much longer than the local growth radius. Follow
    # its original boundary-band connection without opening a route through a
    # sparse inward branch or across a gap to another candidate.
    clustered_domain |= component_connected_to_seed(
        anchored_candidates.astype(np.uint8),
        (clustered_domain & anchored_candidates).astype(np.uint8),
    ) > 0

    local_density = _local_occupancy(
        candidates, support,
        max(_MIN_LOCAL_WINDOW_PX, round(_LOCAL_WINDOW_RADIUS_RATIO * radius)),
    )
    full_depth = max(boundary_depth + 1.0, _FULL_DENSITY_DEPTH_RADIUS_RATIO * radius)
    weight = np.clip(
        (boundary_distance - boundary_depth) / (full_depth - boundary_depth), 0.0, 1.0
    )
    coherent = np.zeros_like(candidates, dtype=bool)
    debug = DEBUG.buffers(candidates, "weak")

    for region_id in range(1, len(stats)):
        x, y, width, height, _ = map(int, stats[region_id])
        crop = np.s_[y:y + height, x:x + width]
        region = labels[crop] == region_id
        anchors = region & (boundary_distance[crop] <= boundary_depth)
        if not np.any(anchors):
            continue
        reference = float(
            np.quantile(local_density[crop][anchors], _BOUNDARY_DENSITY_QUANTILE)
        )
        qualified = region & (
            strong[crop] | anchors | (local_density[crop] >= reference * weight[crop])
        )
        coherent[crop] |= qualified & clustered_domain[crop]
        if DEBUG.active:
            debug.mask("weak")[crop] |= region & ~qualified

    if DEBUG.active:
        DEBUG.show(
            "dark boundary density", envelope, "Local cluster envelope", CYAN,
            style="outline", notes=[
                f"closing reach {reach}px; occupancy window {window}px",
                f"core occupancy >= {_MIN_CORE_OCCUPANCY:.2f}; core area >= {min_core_area}px",
                f"candidate growth <= {radius}px; clusters {len(members) - 1}",
            ],
        )
        DEBUG.show("dark boundary density", core_seeds, "Coherent local cores", CYAN)
        DEBUG.show(
            "dark boundary density", candidates & ~clustered_domain,
            "Sparse cluster regions", MAGENTA,
        )
        DEBUG.show(
            "dark boundary density", debug.mask("weak"), "Weak inward density", BLUE,
        )
    return coherent


# ---- debug.capture ----

Color = tuple[int, int, int]

OverlayStyle = Literal["fill", "outline", "dotted"]

@dataclass(frozen=True)
class DebugOverlay:
    """One labelled mask shown in a debug pane."""

    mask: np.ndarray
    color: Color
    label: str
    style: OverlayStyle = "fill"
    alpha: float | None = None

@dataclass
class DebugPane:
    """A captured image and its grouped labelled overlays."""

    name: str
    image: np.ndarray | None = None
    overlays: list[DebugOverlay] = field(default_factory=list)
    notes: list[str] = field(default_factory=list)
    final: bool = False

class DebugBuffers:
    """Lazily allocated scratch masks for one debug capture session."""

    def __init__(self, reference: np.ndarray, names: tuple[str, ...], active: bool) -> None:
        self._masks = {
            name: np.zeros_like(reference) if active else None for name in names
        }
        self._notes: list[str] | None = [] if active else None

    def paint(self, name: str, mask: np.ndarray) -> None:
        target = self._masks[name]
        if target is not None:
            target[mask > 0] = 255

    def mask(self, name: str) -> np.ndarray | None:
        return self._masks[name]

    def note(self, text: str) -> None:
        if self._notes is not None:
            self._notes.append(text)

    @property
    def notes(self) -> list[str]:
        return [] if self._notes is None else self._notes

class DebugCapture:
    """Module-global facade with worker-local active capture sessions."""

    def __init__(self) -> None:
        self._active: ContextVar[OrderedDict[str, DebugPane] | None] = ContextVar(
            "debug_panes", default=None
        )

    @property
    def active(self) -> bool:
        return self._active.get() is not None

    @contextmanager
    def recording(self) -> Iterator[list[DebugPane]]:
        panes: OrderedDict[str, DebugPane] = OrderedDict()
        captured: list[DebugPane] = []
        token = self._active.set(panes)
        try:
            yield captured
        finally:
            captured[:] = self.panes(panes)
            self._active.reset(token)

    def panes(
        self, panes: OrderedDict[str, DebugPane] | None = None
    ) -> list[DebugPane]:
        captured = self._active.get() if panes is None else panes
        if captured is None:
            return []
        values = list(captured.values())
        return [pane for pane in values if not pane.final] + [
            pane for pane in values if pane.final
        ]

    def buffers(self, reference: np.ndarray, *names: str) -> DebugBuffers:
        return DebugBuffers(reference, names, self.active)

    def show(
        self,
        pane: str,
        mask: np.ndarray | None = None,
        label: str = "",
        color: Color = BLUE,
        *,
        style: OverlayStyle = "fill",
        alpha: float | None = None,
        image: np.ndarray | None = None,
        notes: tuple[str, ...] | list[str] = (),
        final: bool = False,
    ) -> None:
        """Store one mask under a named pane only while capture is active."""
        panes = self._active.get()
        if panes is None:
            return
        captured = panes.setdefault(pane, DebugPane(pane))
        if image is not None:
            captured.image = image.copy()
        if mask is not None:
            captured.overlays.append(DebugOverlay(mask.copy(), color, label, style, alpha))
        captured.notes.extend(notes)
        captured.final |= final

DEBUG = DebugCapture()


# ---- core.models ----

@dataclass(frozen=True)
class Sample:
    path: Path
    label: int | None
    prodgroup3: str | None = None
    lot: str | None = None
    vid: str | None = None
    site_work_week: int | None = None

@dataclass(frozen=True)
class Measurement:
    """Observed material geometry and independent evidence channels for one image."""

    sample: Sample
    gray: np.ndarray
    localized_mask: np.ndarray
    dark_boundary_mask: np.ndarray | None = None
    interdie_material_mask: np.ndarray | None = None
    has_product_reference: bool = False
    registered_gap_overflow: bool = False
    analysis_failed: bool = False
    expected_interdie_gap_missing: bool = False
    interdie_horizontal_gap_count: int = 0
    interdie_vertical_gap_count: int = 0
    interdie_gaps: tuple[LocalizedInterdieGap, ...] = ()
    expected_interdie_horizontal_gap_count: int | None = None
    expected_interdie_vertical_gap_count: int | None = None
    missing_interdie_horizontal_gap_count: int = 0
    missing_interdie_vertical_gap_count: int = 0
    detected_registered_gap_mask: np.ndarray | None = None
    evaluated_interdie_gap_mask: np.ndarray | None = None
    source_gray: np.ndarray | None = None
    boundary_material_mask: np.ndarray | None = None

    @property
    def boundary_source(self) -> np.ndarray:
        """Material used for dark evidence; localized_mask remains gap geometry."""
        if self.boundary_material_mask is not None:
            return self.boundary_material_mask
        return self.localized_mask

def label_name(label: int | None) -> str:
    if label is None:
        return "unlabelled"
    return "bad" if label == BAD else "good"


# ---- input.config ----

IMAGE_SIZE = 400

INPAINT_RADIUS = 3.0

LOCALIZATION_DARK_CENTER_MEDIAN_THRESHOLD = 100

NETWORK_PRODUCT_PATH_PATTERN = (
    rf"^{re.escape(str(NETWORK_STORAGE_ROOT))}\\(?P<product>[^\\]+)(?:\\|$)"
)


# ---- reference.models ----

@dataclass(frozen=True)
class Node:
    id: int
    x0: float
    y0: float
    x1: float
    y1: float

@dataclass(frozen=True)
class Separator:
    node_a: int
    node_b: int
    orientation: str
    x0: float
    y0: float
    x1: float
    y1: float

@dataclass(frozen=True)
class GapSpec:
    orientation: str
    count: int

@dataclass(frozen=True)
class MultiDieReference:
    product: str
    nodes: tuple[Node, ...]
    separators: tuple[Separator, ...]
    gap_specs: tuple[GapSpec, ...] = ()

    @property
    def gap_count(self) -> int | None:
        return sum(spec.count for spec in self.gap_specs) or None

    @property
    def gap_orientation(self) -> str | None:
        return self.gap_specs[0].orientation if len(self.gap_specs) == 1 else None

def manual_reference_counts(
    product: str, horizontal: int = 0, vertical: int = 0
) -> MultiDieReference:
    """Create a topology-only reference from expected gap-line counts."""
    counts = {"horizontal": horizontal, "vertical": vertical}
    if any(count < 0 for count in counts.values()):
        raise ValueError("gap count cannot be negative")
    specs = tuple(
        GapSpec(orientation, count)
        for orientation in ORIENTATIONS
        if (count := counts[orientation]) > 0
    )
    if not specs:
        raise ValueError("at least one gap count must be positive")
    return MultiDieReference(product, (), (), specs)

def manual_reference(
    product: str, gap_count: int, gap_orientation: str
) -> MultiDieReference:
    """Backward-compatible single-orientation manual reference helper."""
    if gap_orientation not in ORIENTATIONS:
        raise ValueError("gap orientation must be horizontal or vertical")
    return manual_reference_counts(product, **{gap_orientation: gap_count})

def _gap_axes(separator: Separator) -> tuple[tuple[float, float], tuple[float, float]]:
    if separator.orientation == "vertical":
        return (separator.x0, separator.x1), (separator.y0, separator.y1)
    return (separator.y0, separator.y1), (separator.x0, separator.x1)

def _interval_distance(
    first: tuple[float, float], second: tuple[float, float]
) -> float:
    if first[1] < second[0]:
        return second[0] - first[1]
    if second[1] < first[0]:
        return first[0] - second[1]
    return 0.0

def _boxes_overlap(
    first: tuple[float, float, float, float],
    second: tuple[float, float, float, float],
) -> bool:
    return min(first[2], second[2]) > max(first[0], second[0]) and min(
        first[3], second[3]
    ) > max(first[1], second[1])

def _same_physical_gap(
    first: Separator, second: Separator, nodes: tuple[Node, ...]
) -> bool:
    """Return whether two registered segments join along one clear centerline."""
    if first.orientation != second.orientation:
        return False

    first_cross, first_long = _gap_axes(first)
    second_cross, second_long = _gap_axes(second)
    first_center = sum(first_cross) / 2.0
    second_center = sum(second_cross) / 2.0
    alignment_tolerance = max(
        first_cross[1] - first_cross[0],
        second_cross[1] - second_cross[0],
        1e-9,
    )
    if abs(first_center - second_center) > alignment_tolerance:
        return False
    if _interval_distance(first_long, second_long) == 0:
        return True

    if first_long[0] <= second_long[0]:
        long_start, long_stop = first_long[1], second_long[0]
    else:
        long_start, long_stop = second_long[1], first_long[0]

    cross_start = max(first_cross[0], second_cross[0])
    cross_stop = min(first_cross[1], second_cross[1])
    if cross_stop <= cross_start:
        center = (first_center + second_center) / 2.0
        half_width = alignment_tolerance / 2.0
        cross_start, cross_stop = center - half_width, center + half_width

    connector = (
        (cross_start, long_start, cross_stop, long_stop)
        if first.orientation == "vertical"
        else (long_start, cross_start, long_stop, cross_stop)
    )
    return not any(
        _boxes_overlap(connector, (node.x0, node.y0, node.x1, node.y1))
        for node in nodes
    )

def reference_gap_counts(reference: MultiDieReference) -> dict[str, int]:
    """Count physical registered gap corridors, respecting intervening die nodes."""
    if reference.gap_specs:
        return {spec.orientation: spec.count for spec in reference.gap_specs}

    counts: dict[str, int] = {}
    for orientation in ORIENTATIONS:
        groups: list[list[Separator]] = []
        for separator in (
            item for item in reference.separators if item.orientation == orientation
        ):
            matching = [
                index
                for index, group in enumerate(groups)
                if any(
                    _same_physical_gap(separator, item, reference.nodes)
                    for item in group
                )
            ]
            if not matching:
                groups.append([separator])
                continue
            target = matching[0]
            groups[target].append(separator)
            for index in reversed(matching[1:]):
                groups[target].extend(groups.pop(index))

        changed = True
        while changed:
            changed = False
            for first in range(len(groups)):
                for second in range(first + 1, len(groups)):
                    if any(
                        _same_physical_gap(a, b, reference.nodes)
                        for a in groups[first]
                        for b in groups[second]
                    ):
                        groups[first].extend(groups.pop(second))
                        changed = True
                        break
                if changed:
                    break
        counts[orientation] = len(groups)
    return counts


# ---- boundary_evidence.retention ----

def _dark_boundary_retain_boundary_components(
    values: np.ndarray,
    candidates: np.ndarray,
    strong: np.ndarray,
    support: np.ndarray,
    boundary: np.ndarray,
    radius: int,
) -> np.ndarray:
    """Keep density-qualified evidence connected to its original boundary anchor."""
    if not np.any(candidates):
        return np.zeros_like(candidates, dtype=bool)

    rim_filtered = suppress_weak_optical_rim(values, candidates, support, boundary, radius)
    if DEBUG.active:
        DEBUG.show(
            "optical rim assessment",
            candidates & ~rim_filtered,
            "Weak optical rim background",
            MAGENTA,
        )
    candidates = rim_filtered

    count, labels, stats, _ = cv2.connectedComponentsWithStats(
        candidates.astype(np.uint8), 8
    )
    kept = np.zeros_like(candidates, dtype=bool)
    # Candidate evidence cannot be farther inward than the search radius that found it.
    boundary_depth = max(
        1.0,
        min(float(radius), float(DARK_BOUNDARY_ANCHOR_DEPTH_PX)),
    )
    boundary_distance = cv2.distanceTransform(
        support.astype(np.uint8), cv2.DIST_L1, 3
    )
    boundary_neighbourhood = boundary_distance <= boundary_depth
    coherent = coherent_candidate_domain(
        candidates, strong, support, labels, stats,
        boundary_distance, boundary_depth, radius,
    )
    outlines, _ = cv2.findContours(
        boundary.astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE
    )
    contours = [outline[:, 0, :].astype(float) for outline in outlines]
    debug = DEBUG.buffers(candidates, "spots")

    for region_id in range(1, count):
        x, y, width, height, _ = map(int, stats[region_id])
        crop = np.s_[y : y + height, x : x + width]
        region = labels[crop] == region_id
        boundary_support = region & boundary_neighbourhood[crop]
        strong_region = region & strong[crop]

        if not np.any(boundary_support) or not np.any(strong_region):
            continue

        # Evaluate the intact component: density pruning must not turn a large
        # defect into several apparently small nuisance spots.
        yy, xx = np.where(region)
        points = np.column_stack((xx + x, yy + y))
        if is_small_spot_on_straight_edge(points, contours, candidates.shape, radius):
            if DEBUG.active:
                rejected = np.zeros_like(candidates)
                rejected[crop] = region
                debug.paint("spots", rejected)
            continue

        coherent_domain = region & coherent[crop]
        boundary_support &= coherent_domain
        if not np.any(boundary_support):
            continue
        region = (
            component_connected_to_seed(
                coherent_domain.astype(np.uint8),
                boundary_support.astype(np.uint8),
            )
            > 0
        )
        if not np.any(region):
            continue

        kept[crop] |= region

    if DEBUG.active:
        DEBUG.show(
            "local edge assessment",
            debug.mask("spots"),
            "Small spots on a straight edge",
            MAGENTA,
        )
    return kept


# ---- core.metrics ----

@dataclass
class _Counters:
    total_images: int = 0
    predicted_bad: int = 0
    predicted_good: int = 0
    true_positives: int = 0
    true_negatives: int = 0
    false_negatives: int = 0
    false_positives: int = 0

    def add(self, actual: int | None, predicted: int) -> None:
        self.total_images += 1
        self.predicted_bad += predicted == BAD
        self.predicted_good += predicted == GOOD
        if actual is None:
            return
        if actual == BAD and predicted == BAD:
            self.true_positives += 1
        elif actual == GOOD and predicted == GOOD:
            self.true_negatives += 1
        elif actual == BAD:
            self.false_negatives += 1
        else:
            self.false_positives += 1

    def copy(self) -> "_Counters":
        return _Counters(**vars(self))

class RunStats:
    """Accumulate bounded cumulative and per-product run metrics safely."""

    def __init__(self) -> None:
        self._lock = Lock()
        self._all = _Counters()
        self._products: dict[str, _Counters] = {}
        self._product_directories: dict[str, str] = {}
        self._product_lots: dict[str, set[str]] = {}
        self._product_work_weeks: dict[str, set[int]] = {}
        self._all_seconds = 0.0
        self._product_seconds: dict[str, float] = {}

    @staticmethod
    def _validate(actual: int | None, predicted: int) -> None:
        if predicted not in (GOOD, BAD):
            raise ValueError(f"invalid prediction: {predicted}")
        if actual is not None and actual not in (GOOD, BAD):
            raise ValueError(f"invalid label: {actual}")

    @staticmethod
    def _fallback_product(sample: Sample) -> str:
        if sample.prodgroup3:
            return sample.prodgroup3
        parent = sample.path.parent
        return (
            parent.parent.name
            if parent.name.casefold() in {"bad", "good"}
            else parent.name
        )

    def record(
        self,
        sample: Sample,
        predicted: int,
        product: str | None = None,
    ) -> None:
        """Record one completed image without retaining the sample or prediction."""
        actual = sample.label
        predicted = int(predicted)
        product = product or self._fallback_product(sample)
        self._validate(actual, predicted)
        if not product:
            raise ValueError("product name must not be empty")

        with self._lock:
            self._all.add(actual, predicted)
            self._products.setdefault(product, _Counters()).add(actual, predicted)
            self._product_directories.setdefault(product, str(sample.path.parent))
            if sample.lot:
                self._product_lots.setdefault(product, set()).add(sample.lot)
            if sample.site_work_week is not None:
                self._product_work_weeks.setdefault(product, set()).add(
                    sample.site_work_week
                )

    def extend(
        self,
        samples: Sequence[Sample],
        predicted: Sequence[int],
        products: Sequence[str] | None = None,
    ) -> None:
        if len(samples) != len(predicted):
            raise ValueError("samples and predictions must have the same length")
        if products is not None and len(products) != len(samples):
            raise ValueError("samples and products must have the same length")

        for index, (sample, label) in enumerate(zip(samples, predicted, strict=True)):
            self.record(
                sample,
                int(label),
                products[index] if products is not None else None,
            )

    def set_elapsed(self, elapsed: float, product: str | None = None) -> None:
        if elapsed < 0:
            raise ValueError("elapsed time must be non-negative")
        with self._lock:
            if product is None:
                self._all_seconds = elapsed
            else:
                self._product_seconds[product] = elapsed

    @staticmethod
    def _ratio(numerator: float, denominator: int) -> float | None:
        return numerator / denominator if denominator else None

    @classmethod
    def _summary(
        cls,
        counters: _Counters,
        elapsed: float,
        unique_lots: int,
        valid_processed_work_weeks: tuple[int, ...],
    ) -> dict[str, int | float | None | tuple[int, ...]]:
        labelled = (
            counters.true_positives
            + counters.true_negatives
            + counters.false_negatives
            + counters.false_positives
        )
        return {
            "total_images": counters.total_images,
            "total_seconds": elapsed,
            "average_seconds_per_image": cls._ratio(elapsed, counters.total_images),
            "unique_lots": unique_lots,
            "valid_processed_work_weeks": valid_processed_work_weeks,
            "predicted_good": counters.predicted_good,
            "predicted_bad": counters.predicted_bad,
            "true_positives": counters.true_positives,
            "true_negatives": counters.true_negatives,
            "false_negatives": counters.false_negatives,
            "false_positives": counters.false_positives,
            "recall": cls._ratio(
                counters.true_positives,
                counters.true_positives + counters.false_negatives,
            ),
            "precision": cls._ratio(
                counters.true_positives,
                counters.true_positives + counters.false_positives,
            ),
            "accuracy": cls._ratio(
                counters.true_positives + counters.true_negatives,
                labelled,
            ),
        }

    def summary(
        self, product: str | None = None
    ) -> dict[str, int | float | None | tuple[int, ...]]:
        with self._lock:
            counters = (
                self._all.copy()
                if product is None
                else self._products.get(product, _Counters()).copy()
            )
            elapsed = (
                self._all_seconds
                if product is None
                else self._product_seconds.get(product, 0.0)
            )
            lots = (
                set().union(*self._product_lots.values())
                if product is None
                else self._product_lots.get(product, set()).copy()
            )
            work_weeks = (
                set().union(*self._product_work_weeks.values())
                if product is None
                else self._product_work_weeks.get(product, set()).copy()
            )
        return self._summary(counters, elapsed, len(lots), tuple(sorted(work_weeks)))

    def summaries(
        self,
    ) -> tuple[tuple[str, dict[str, int | float | None | tuple[int, ...]]], ...]:
        with self._lock:
            all_counters = self._all.copy()
            all_seconds = self._all_seconds
            all_lots = set().union(*self._product_lots.values())
            all_work_weeks = set().union(*self._product_work_weeks.values())
            products = tuple(
                (
                    name,
                    counters.copy(),
                    self._product_seconds.get(name, 0.0),
                    len(self._product_lots.get(name, set())),
                    tuple(sorted(self._product_work_weeks.get(name, set()))),
                )
                for name, counters in sorted(
                    self._products.items(), key=lambda item: item[0].casefold()
                )
            )
        return (
            (
                "All Products",
                self._summary(
                    all_counters,
                    all_seconds,
                    len(all_lots),
                    tuple(sorted(all_work_weeks)),
                ),
            ),
            *(
                (name, self._summary(counters, elapsed, unique_lots, work_weeks))
                for name, counters, elapsed, unique_lots, work_weeks in products
            ),
        )

    def top_products_by_bad(self, limit: int = 5) -> tuple[tuple[str, int], ...]:
        """Return products with BAD predictions, ranked deterministically."""
        if limit < 1:
            return ()
        with self._lock:
            ranked = sorted(
                (
                    (name, counters.predicted_bad)
                    for name, counters in self._products.items()
                    if counters.predicted_bad
                ),
                key=lambda item: (-item[1], item[0].casefold(), item[0]),
            )
        return tuple(ranked[:limit])

    @property
    def processed(self) -> int:
        with self._lock:
            return self._all.total_images

    @property
    def positives(self) -> int:
        with self._lock:
            return self._all.predicted_bad

    @property
    def negatives(self) -> int:
        with self._lock:
            return self._all.predicted_good

    @property
    def product_names(self) -> tuple[str, ...]:
        with self._lock:
            return tuple(sorted(self._products, key=str.casefold))

    @property
    def product_directories(self) -> set[str]:
        with self._lock:
            return set(self._product_directories.values())


# ---- debug.logging ----

LOGGER = logging.getLogger("inspect_flux")

class _MalaysiaFormatter(logging.Formatter):
    def formatTime(self, record, datefmt=None):  # noqa: N802
        timestamp = datetime.fromtimestamp(record.created, MALAYSIA_TIMEZONE)
        return timestamp.strftime(datefmt) if datefmt else timestamp.isoformat()

class _AsyncFileHandler(logging.Handler):
    """Append logs off the inference path."""

    def __init__(self, path: Path) -> None:
        super().__init__()
        path.parent.mkdir(parents=True, exist_ok=True)
        self._file = path.open("a", encoding="utf-8")
        self._executor: ThreadPoolExecutor | None = ThreadPoolExecutor(max_workers=1)

    def emit(self, record: logging.LogRecord) -> None:
        if self._executor is None:
            return
        try:
            self._executor.submit(self._write, self.format(record))
        except Exception:  # pragma: no cover - logging must never break inference
            self.handleError(record)

    def _write(self, message: str) -> None:
        self._file.write(message + "\n")
        self._file.flush()

    def flush(self) -> None:
        if self._executor is not None:
            self._executor.submit(self._file.flush).result()

    def close(self) -> None:
        executor, self._executor = self._executor, None
        if executor is not None:
            executor.shutdown(wait=True)
            self._file.close()
        super().close()

def malaysia_now() -> datetime:
    return datetime.now(MALAYSIA_TIMEZONE)

def log_path_for(storage_root: Path, started_at: datetime) -> Path:
    timestamp = started_at.strftime(LOG_FILENAME_TIMESTAMP_FORMAT).upper()
    return storage_root / HISTORY_FOLDER / LOG_FOLDER / f"{timestamp}.txt"

def configure_logging(log_path: Path | None) -> None:
    close_logging()
    LOGGER.setLevel(logging.INFO)
    LOGGER.propagate = False
    formatter = _MalaysiaFormatter(
        "%(asctime)s | %(levelname)s | %(message)s",
        datefmt=LOG_MESSAGE_TIMESTAMP_FORMAT,
    )
    handlers: list[logging.Handler] = [logging.StreamHandler(sys.stdout)]
    if log_path:
        handlers.append(_AsyncFileHandler(log_path))
    for handler in handlers:
        handler.setFormatter(formatter)
        LOGGER.addHandler(handler)

def flush_logging() -> None:
    for handler in LOGGER.handlers:
        handler.flush()

def close_logging() -> None:
    for handler in LOGGER.handlers[:]:
        LOGGER.removeHandler(handler)
        handler.close()

def _exception_info(
    error: BaseException,
) -> tuple[type[BaseException], BaseException, TracebackType] | None:
    if error.__traceback__ is None:
        return None
    return type(error), error, error.__traceback__

def record_skipped_image(
    sample: Sample, error: Exception, errors: dict[Path, str] | None
) -> None:
    if errors is None:
        raise RuntimeError(f"failed on {sample.path}: {error}") from error
    message = f"{type(error).__name__}: {error}"
    errors[sample.path] = message
    LOGGER.error(
        "Skipped: %s | %s", sample.path, message, exc_info=_exception_info(error)
    )

def log_unreadable_image(sample: Sample, error: Exception) -> None:
    """Log an image-load failure that is tracked outside the run report."""
    message = f"{type(error).__name__}: {error}"
    LOGGER.warning("Unreadable: %s | %s", sample.path, message)

def log_progress(
    product: str,
    product_processed: int,
    product_total: int,
    processed: int,
    total: int,
    completed: int,
    elapsed_total: float,
    successful_count: int,
    positive: int,
    total_positive: int,
    top_bad_products: Sequence[tuple[str, int]] = (),
) -> bool:
    if not (
        processed == total or completed == 1 or processed % RUN_OUTPUT_INTERVAL == 0
    ):
        return False
    top_products = format_top_bad_products(top_bad_products)
    LOGGER.info(
        "Progress: product=%s; processed=%d/%d; positive=%d | "
        "total_processed=%d/%d; total_positive=%d; avg/image=%.3fs%s",
        product,
        product_processed,
        product_total,
        positive,
        processed,
        total,
        total_positive,
        elapsed_total / successful_count if successful_count else 0.0,
        f" | {top_products}" if top_products else "",
    )
    return True

def format_top_bad_products(products: Sequence[tuple[str, int]]) -> str:
    """Format the concise BAD-product progress summary."""
    if not products:
        return ""
    return "Top BAD products: " + ", ".join(
        f"{name} ({count})" for name, count in products
    )

def log_execution_stop(error: BaseException) -> None:
    if isinstance(error, SystemExit) and error.code in (None, 0):
        return
    LOGGER.critical(
        "Execution stopped: %s: %s",
        type(error).__name__,
        error,
        exc_info=_exception_info(error),
    )
    flush_logging()


# ---- input.samples ----

CSV_RESULT_COLUMN = "classification"

IMAGE_SUFFIXES = {".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff"}

HISTORY_MAX_ROWS = 100_000

HISTORY_RETAIN_ROWS = HISTORY_MAX_ROWS // 2

def _iter_image_files(directory: Path):
    """Yield image files, stopping below directories that contain images."""
    directories = [directory]
    while directories:
        current = directories.pop()
        images = []
        child_directories = []
        with os.scandir(current) as entries:
            for entry in entries:
                if entry.is_dir(follow_symlinks=False):
                    # Inspection output can live below an input directory. Do not
                    # feed generated debug images back into a later inspection.
                    if entry.name.casefold() != DEBUG_RESULTS_FOLDER.casefold():
                        child_directories.append(Path(entry.path))
                    continue
                if (
                    entry.is_file(follow_symlinks=False)
                    and Path(entry.name).suffix.casefold() in IMAGE_SUFFIXES
                ):
                    images.append(Path(entry.path))
        if images:
            yield from images
        else:
            directories.extend(child_directories)

def discover(
    paths: Path | list[Path],
    maximum_per_directory: int | None = None,
    processed_paths: set[str] | None = None,
) -> tuple[list[Sample], bool]:
    """Recursively discover image files, stopping once each root reaches its cap.

    Previously processed paths are retained for reporting but do not count toward
    ``maximum_per_directory``.
    """
    if isinstance(paths, Path):
        paths = [paths]

    discovered = []
    for path in paths:
        if path.is_dir():
            pending_count = 0
            for image_path in _iter_image_files(path):
                discovered.append(image_path)
                if not processed_paths or str(image_path) not in processed_paths:
                    pending_count += 1
                    if (
                        maximum_per_directory is not None
                        and pending_count >= maximum_per_directory
                    ):
                        break
        elif path.is_file():
            discovered.append(path)
        else:
            raise FileNotFoundError(f"input path not found: {path}")

    discovered.sort(key=str)
    if not discovered:
        raise ValueError("no images found")
    is_bad = [
        any(part.lower() == BAD_FOLDER.lower() for part in path.parts)
        for path in discovered
    ]
    labelled = any(is_bad) and not all(is_bad)
    return (
        (
            [
                Sample(path, BAD if bad else GOOD)
                for path, bad in zip(discovered, is_bad)
            ]
            if labelled
            else [Sample(path, None) for path in discovered]
        ),
        labelled,
    )

def limit_samples(
    samples: list[Sample],
    maximum: int | None = None,
    maximum_per_directory: int | None = None,
) -> list[Sample]:
    """Randomly cap each directory, then exhaust smaller directories first."""
    if maximum is None and maximum_per_directory is None:
        return samples

    groups: dict[Path, list[Sample]] = {}
    for sample in samples:
        groups.setdefault(sample.path.parent, []).append(sample)

    directories = list(groups.values())
    if (maximum is None or len(samples) <= maximum) and (
        maximum_per_directory is None
        or all(len(directory) <= maximum_per_directory for directory in directories)
    ):
        return samples

    random.shuffle(directories)
    directories.sort(key=len)
    for directory in directories:
        random.shuffle(directory)
    if maximum_per_directory is not None:
        directories = [directory[:maximum_per_directory] for directory in directories]
    return [sample for directory in directories for sample in directory][:maximum]

def _csv_image_path(value: str) -> Path:
    path = PureWindowsPath(value.strip())
    if path.root and not path.drive:
        path = PureWindowsPath(f"\\{path}")
    return Path(path)

def _site_work_week(row: Mapping[str, str]) -> int | None:
    value = (row.get("site_work_week") or "").strip()
    try:
        work_week = int(value)
    except ValueError:
        return None
    year, week = divmod(work_week, 100)
    return work_week if year and 1 <= week <= 53 else None

def csv_samples(csv_path: Path) -> list[Sample]:
    """Return unique metadata-bearing samples from the XRAY CSV export."""
    with csv_path.open(encoding="utf-8-sig", newline="") as file:
        reader = csv.DictReader(file)
        if reader.fieldnames is None:
            return []
        if "image_full_path" not in reader.fieldnames:
            raise ValueError("CSV must contain an image_full_path column")
        samples = [
            Sample(
                _csv_image_path(image_path),
                None,
                (row.get("prodgroup3") or "").strip() or None,
                (row.get("lot") or "").strip() or None,
                (row.get("visual_id") or row.get("VID") or "").strip() or None,
                _site_work_week(row),
            )
            for row in reader
            if (image_path := (row.get("image_full_path") or "").strip())
        ]

    unique_samples: dict[Path, Sample] = {}
    for sample in samples:
        unique_samples.setdefault(sample.path, sample)
    return list(unique_samples.values())

def update_csv_results(csv_path: Path, predictions: Mapping[Path, int]) -> None:
    """Atomically write processed predictions into the source CSV."""
    raw = csv_path.read_bytes()
    encoding = "utf-8-sig" if raw.startswith(b"\xef\xbb\xbf") else "utf-8"
    line_terminator = "\r\n" if b"\r\n" in raw else "\n"

    with csv_path.open(encoding="utf-8-sig", newline="") as file:
        rows = list(csv.reader(file))
    if not rows or "image_full_path" not in rows[0]:
        raise ValueError("CSV must contain an image_full_path column")

    header = rows[0]
    path_index = header.index("image_full_path")
    if CSV_RESULT_COLUMN in header:
        result_index = header.index(CSV_RESULT_COLUMN)
    else:
        result_index = len(header)
        header.append(CSV_RESULT_COLUMN)
        for row in rows[1:]:
            row.append("")

    results = {path: label_name(int(label)) for path, label in predictions.items()}
    for row in rows[1:]:
        if len(row) <= path_index or not row[path_index].strip():
            continue
        result = results.get(_csv_image_path(row[path_index]))
        if result is None:
            continue
        if len(row) <= result_index:
            row.extend([""] * (result_index + 1 - len(row)))
        row[result_index] = result

    fd, temp_name = tempfile.mkstemp(
        dir=csv_path.parent,
        prefix=f".{csv_path.name}.",
        suffix=".tmp",
    )
    os.close(fd)
    temp_path = Path(temp_name)
    try:
        with temp_path.open("w", encoding=encoding, newline="") as file:
            csv.writer(file, lineterminator=line_terminator).writerows(rows)
        os.replace(temp_path, csv_path)
    finally:
        temp_path.unlink(missing_ok=True)

def read_history(history_path: Path) -> set[str]:
    if not history_path.is_file():
        return set()
    with history_path.open(encoding="utf-8") as file:
        lines = file.readlines()

    if len(lines) >= HISTORY_MAX_ROWS:
        lines = lines[-HISTORY_RETAIN_ROWS:]
        fd, temp_name = tempfile.mkstemp(
            dir=history_path.parent,
            prefix=f".{history_path.name}.",
            suffix=".tmp",
        )
        os.close(fd)
        temp_path = Path(temp_name)
        try:
            temp_path.write_text("".join(lines), encoding="utf-8")
            os.replace(temp_path, history_path)
        finally:
            temp_path.unlink(missing_ok=True)

    return {
        fields[1]
        for line in lines
        if len(fields := line.rstrip("\n").split("\t", 2)) >= 2
    }


# ---- pipeline.interdie_filter ----

def interdie_overflow_mask(row: Measurement) -> np.ndarray:
    """Return filtered spatial inter-die overflow for one measurement."""
    bridge = row.interdie_material_mask
    if bridge is None or not np.any(bridge):
        return np.zeros_like(row.gray)
    if row.registered_gap_overflow:
        return bridge
    localized = row.localized_mask
    return filter_interdie_overflow(localized, bridge, row.interdie_gaps)


# ---- input.images ----

class ImageReadError(ValueError):
    """Raised when OpenCV cannot load an image file."""

def _resize_to_working_size(image: np.ndarray) -> np.ndarray:
    scale = IMAGE_SIZE / max(image.shape[:2])
    if scale == 1:
        return image
    interpolation = cv2.INTER_AREA if scale < 1 else cv2.INTER_LINEAR
    return cv2.resize(
        image,
        None,
        fx=scale,
        fy=scale,
        interpolation=interpolation,
    )

def crop_black_border(image: np.ndarray) -> np.ndarray:
    """Remove only all-zero outer rows and columns."""
    content = np.any(image != 0, axis=2)
    rows = np.flatnonzero(np.any(content, axis=1))
    columns = np.flatnonzero(np.any(content, axis=0))
    if not rows.size or not columns.size:
        return image
    return image[rows[0] : rows[-1] + 1, columns[0] : columns[-1] + 1]

def _annotation_mask(colour: np.ndarray) -> np.ndarray:
    """Find coloured overlays independently of exposure gain."""
    saturation = cv2.cvtColor(colour, cv2.COLOR_BGR2HSV)[:, :, 1]
    _, mask = cv2.threshold(saturation, 0, 255, cv2.THRESH_BINARY | cv2.THRESH_OTSU)
    if not np.any(mask):
        return mask

    _, labels = cv2.connectedComponents(mask)
    border_labels = np.unique(
        np.concatenate((labels[0], labels[-1], labels[:, 0], labels[:, -1]))
    )
    return np.where((mask > 0) & ~np.isin(labels, border_labels), 255, 0).astype(
        np.uint8
    )

def prepare_detection_image(gray: np.ndarray) -> np.ndarray:
    """Prepare only the localization image while preserving source exposure."""
    if gray.min() == gray.max():
        DEBUG.show("preprocessed image", image=gray)
        return gray
    height, width = gray.shape
    patch_half = max(2, round(min(height, width) * CENTER_PATCH_RATIO / 2))
    centre = gray[
        centered_slice(height // 2, patch_half, height),
        centered_slice(width // 2, patch_half, width),
    ]

    if np.median(centre) >= LOCALIZATION_DARK_CENTER_MEDIAN_THRESHOLD:
        result = gray
    else:
        # Suppress dense dark texture only when it interferes with localization.
        # Dark-boundary photometry uses the untouched source image instead.
        vertical = cv2.morphologyEx(
            gray,
            cv2.MORPH_CLOSE,
            np.ones((3, 1), np.uint8),
        )
        horizontal = cv2.morphologyEx(
            gray,
            cv2.MORPH_CLOSE,
            np.ones((1, 3), np.uint8),
        )
        closed = cv2.max(gray, cv2.min(vertical, horizontal))

        blurred = cv2.GaussianBlur(gray, (0, 0), 1.0)
        sharpened = cv2.addWeighted(gray, 1.5, blurred, -0.5, 0)
        result = cv2.addWeighted(closed, 0.5, sharpened, 0.5, 0)
    DEBUG.show("preprocessed image", image=result)
    return result

def normalize_localization_contrast(gray: np.ndarray) -> np.ndarray:
    """Stretch and lightly smooth the localization-only representation."""
    lower, upper = np.percentile(gray, (5, 95))
    if upper <= lower:
        return gray
    scaled = (gray.astype(np.float32) - lower) * (255.0 / (upper - lower))
    normalized = np.clip(scaled, 0, 255).astype(np.uint8)
    return cv2.GaussianBlur(normalized, (3, 3), 0)

def repair_warped_border(image: np.ndarray) -> np.ndarray:
    """Inpaint frame-connected black padding and its JPEG interpolation fringe."""
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    if not np.any(gray):
        return image

    black = (gray == 0).astype(np.uint8)
    _, labels = cv2.connectedComponents(black, connectivity=8)
    border_labels = np.unique(
        np.concatenate(
            (
                labels[0, :],
                labels[-1, :],
                labels[:, 0],
                labels[:, -1],
            )
        )
    )
    border_labels = border_labels[border_labels != 0]
    if not border_labels.size:
        return image

    border_mask = np.isin(labels, border_labels).astype(np.uint8)
    border_mask = cv2.dilate(border_mask, np.ones((5, 5), np.uint8))
    return cv2.inpaint(image, border_mask, INPAINT_RADIUS, cv2.INPAINT_TELEA)

def read_image(path: Path) -> np.ndarray:
    """Load a photometry-preserving grayscale image at the working resolution."""
    try:
        image = cv2.imread(str(path), cv2.IMREAD_COLOR)
    except (OSError, cv2.error) as error:
        raise ImageReadError(f"cannot read image: {path}") from error
    if image is None:
        raise ImageReadError(f"cannot read image: {path}")

    if max(image.shape[:2]) > IMAGE_SIZE:
        image = _resize_to_working_size(image)
    DEBUG.show("downscaled source image", image=image)

    outline_mask = _annotation_mask(image)
    if np.any(outline_mask):
        dilated = cv2.dilate(outline_mask, np.ones((1,) * 2, np.uint8))
        image = cv2.inpaint(image, dilated, INPAINT_RADIUS, cv2.INPAINT_TELEA)

    image = crop_black_border(image)
    image = repair_warped_border(image)

    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    return _resize_to_working_size(gray)


# ---- input.products ----

def network_product(path: Path) -> str | None:
    """Return the product captured by the configured network path, if matched."""
    windows_path = str(path).replace("/", "\\")
    match = re.match(NETWORK_PRODUCT_PATH_PATTERN, windows_path, re.IGNORECASE)
    return match.group("product") if match else None

def product_key(sample: Sample) -> str:
    """Resolve a sample product from metadata, network path, or local layout."""
    if sample.prodgroup3:
        return sample.prodgroup3
    if product := network_product(sample.path):
        return product
    parent = sample.path.parent
    return (
        parent.parent.name
        if parent.name.lower() in {BAD_FOLDER.lower(), "good"}
        else parent.name
    )


# ---- gap_detection.geometry ----

Box = tuple[int, int, int, int]

Interval = tuple[int, int]

class AxisGap(Protocol):
    orientation: str
    x0: float
    y0: float
    x1: float
    y1: float

@dataclass(frozen=True)
class InterdieGap:
    """Axis-aligned empty region between two nominal die components."""

    node_a: int
    node_b: int
    orientation: str
    x0: int
    y0: int
    x1: int
    y1: int

    @property
    def box(self) -> Box:
        return self.x0, self.y0, self.x1, self.y1

def axis_intervals(box: Box, orientation: str) -> tuple[Interval, Interval]:
    """Return cross-axis and longitudinal intervals for an oriented box."""
    x0, y0, x1, y1 = box
    if orientation == "vertical":
        return (x0, x1), (y0, y1)
    if orientation == "horizontal":
        return (y0, y1), (x0, x1)
    raise ValueError("gap orientation must be horizontal or vertical")

def interval_distance(first: Interval, second: Interval) -> int:
    if first[1] < second[0]:
        return second[0] - first[1]
    if second[1] < first[0]:
        return first[0] - second[1]
    return 0

def interval_overlap(first: Interval, second: Interval) -> Interval | None:
    start = max(first[0], second[0])
    stop = min(first[1], second[1])
    return (start, stop) if stop > start else None

def contiguous_runs(values: np.ndarray) -> list[tuple[int, int]]:
    """Return half-open intervals for contiguous truthy runs."""
    indices = np.flatnonzero(values)
    if not len(indices):
        return []
    cuts = np.flatnonzero(np.diff(indices) > 1) + 1
    return [(int(run[0]), int(run[-1] + 1)) for run in np.split(indices, cuts)]

def longest_run(values: np.ndarray) -> tuple[int, int] | None:
    return max(contiguous_runs(values), key=lambda run: run[1] - run[0], default=None)

def component_layout(
    mask: np.ndarray, *, sort_by_centroid: bool = False
) -> tuple[list[Box], list[InterdieGap]]:
    """Return component boxes and empty axis-aligned gaps between them."""
    count, _, stats, centroids = cv2.connectedComponentsWithStats(mask, 8)
    component_ids = list(range(1, count))
    if sort_by_centroid:
        component_ids.sort(
            key=lambda component_id: (
                float(centroids[component_id][1]),
                float(centroids[component_id][0]),
            )
        )

    boxes = [
        (
            int(stats[component_id, cv2.CC_STAT_LEFT]),
            int(stats[component_id, cv2.CC_STAT_TOP]),
            int(stats[component_id, cv2.CC_STAT_LEFT] + stats[component_id, cv2.CC_STAT_WIDTH]),
            int(stats[component_id, cv2.CC_STAT_TOP] + stats[component_id, cv2.CC_STAT_HEIGHT]),
        )
        for component_id in component_ids
    ]
    return boxes, _gaps_between_boxes(mask, boxes)

def _normalize_box(
    box: Box, bounds: tuple[int, int, int, int]
) -> tuple[float, float, float, float]:
    x, y, width, height = bounds
    x0, y0, x1, y1 = box
    return (
        (x0 - x) / width,
        (y0 - y) / height,
        (x1 - x) / width,
        (y1 - y) / height,
    )

def infer_layout(mask: np.ndarray) -> tuple[list[Node], list[Separator]]:
    """Infer normalized reference nodes and gaps from nominal components."""
    boxes, gaps = component_layout(mask, sort_by_centroid=True)
    if len(boxes) < 2:
        raise ValueError("multi-die registration requires at least two die components")

    bounds = cv2.boundingRect(mask)
    nodes = [Node(node_id, *_normalize_box(box, bounds)) for node_id, box in enumerate(boxes)]
    separators = [
        Separator(
            gap.node_a,
            gap.node_b,
            gap.orientation,
            *_normalize_box(gap.box, bounds),
        )
        for gap in gaps
    ]
    if not separators:
        raise ValueError("no inter-die gaps found")
    return nodes, separators

def _gaps_between_boxes(mask: np.ndarray, boxes: list[Box]) -> list[InterdieGap]:
    gaps: list[InterdieGap] = []
    for node_a, box_a in enumerate(boxes):
        for node_b, box_b in enumerate(boxes[node_a + 1 :], node_a + 1):
            gaps.extend(_pair_gaps(mask, node_a, box_a, node_b, box_b))
    return gaps

def _pair_gaps(
    mask: np.ndarray,
    node_a: int,
    box_a: Box,
    node_b: int,
    box_b: Box,
) -> list[InterdieGap]:
    ax0, ay0, ax1, ay1 = box_a
    bx0, by0, bx1, by1 = box_b
    gaps: list[InterdieGap] = []

    top, bottom = max(ay0, by0), min(ay1, by1)
    if bottom > top:
        left, right = sorted(
            ((ax0, ax1, node_a), (bx0, bx1, node_b)), key=lambda item: item[0]
        )
        x0, x1 = left[1], right[0]
        if x1 > x0 and not np.any(mask[top:bottom, x0:x1]):
            gaps.append(InterdieGap(left[2], right[2], "vertical", x0, top, x1, bottom))

    left, right = max(ax0, bx0), min(ax1, bx1)
    if right > left:
        upper, lower = sorted(
            ((ay0, ay1, node_a), (by0, by1, node_b)), key=lambda item: item[0]
        )
        y0, y1 = upper[1], lower[0]
        if y1 > y0 and not np.any(mask[y0:y1, left:right]):
            gaps.append(InterdieGap(upper[2], lower[2], "horizontal", left, y0, right, y1))
    return gaps

def gap_line_counts(gaps: Iterable[AxisGap]) -> dict[str, int]:
    """Count distinct horizontal and vertical gap lines across segments."""
    gaps = tuple(gaps)
    return {
        orientation: _merged_interval_count(
            (gap.y0, gap.y1) if orientation == "horizontal" else (gap.x0, gap.x1)
            for gap in gaps
            if gap.orientation == orientation
        )
        for orientation in ORIENTATIONS
    }

def _merged_interval_count(intervals: Iterable[tuple[float, float]]) -> int:
    merged: list[list[float]] = []
    for start, end in sorted(intervals):
        if merged and start <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], end)
        else:
            merged.append([start, end])
    return len(merged)


# ---- reference.matching ----

class _Box(Protocol):
    x0: float
    y0: float
    x1: float
    y1: float

def _box_error(first: _Box, second: _Box) -> float:
    return max(
        abs(first.x0 - second.x0),
        abs(first.y0 - second.y0),
        abs(first.x1 - second.x1),
        abs(first.y1 - second.y1),
    )

def _perfect_match(
    first: Sequence[_Box], second: Sequence[_Box], tolerance: float
) -> dict[int, int] | None:
    """Return a one-to-one assignment when every box has a close counterpart."""
    if len(first) != len(second):
        return None
    options = [
        sorted(
            (
                index
                for index, candidate in enumerate(second)
                if _box_error(item, candidate) <= tolerance
            ),
            key=lambda index: _box_error(item, second[index]),
        )
        for item in first
    ]
    if any(not candidates for candidates in options):
        return None

    assigned: dict[int, int] = {}

    def place(first_index: int, seen: set[int]) -> bool:
        for second_index in options[first_index]:
            if second_index in seen:
                continue
            seen.add(second_index)
            previous = assigned.get(second_index)
            if previous is None or place(previous, seen):
                assigned[second_index] = first_index
                return True
        return False

    for first_index in sorted(range(len(first)), key=lambda index: len(options[index])):
        if not place(first_index, set()):
            return None
    return {first_index: second_index for second_index, first_index in assigned.items()}

def _gap_counts(reference: MultiDieReference) -> tuple[int, int]:
    counts = reference_gap_counts(reference)
    return tuple(counts.get(orientation, 0) for orientation in ORIENTATIONS)

def _edge(
    separator: Separator, node_mapping: Mapping[int, int] | None = None
) -> tuple[int, int, str]:
    node_a = separator.node_a
    node_b = separator.node_b
    if node_mapping is not None:
        node_a = node_mapping[node_a]
        node_b = node_mapping[node_b]
    low, high = sorted((node_a, node_b))
    return low, high, separator.orientation

def layout_matches(
    candidate: MultiDieReference,
    layout: MultiDieReference,
    *,
    tolerance: float = RECT_ALIGN_TOL_RATIO,
) -> bool:
    """Return whether two full geometric references represent the same layout."""
    # Topology-only references are intentionally never auto-shared.
    if (
        not candidate.nodes
        or not candidate.separators
        or not layout.nodes
        or not layout.separators
    ):
        return False
    if len(candidate.nodes) != len(layout.nodes) or len(candidate.separators) != len(
        layout.separators
    ):
        return False
    if _gap_counts(candidate) != _gap_counts(layout):
        return False

    node_match = _perfect_match(candidate.nodes, layout.nodes, tolerance)
    if node_match is None:
        return False
    node_mapping = {
        candidate.nodes[candidate_index].id: layout.nodes[layout_index].id
        for candidate_index, layout_index in node_match.items()
    }

    candidate_groups: dict[tuple[int, int, str], list[Separator]] = defaultdict(list)
    layout_groups: dict[tuple[int, int, str], list[Separator]] = defaultdict(list)
    for separator in candidate.separators:
        candidate_groups[_edge(separator, node_mapping)].append(separator)
    for separator in layout.separators:
        layout_groups[_edge(separator)].append(separator)
    if candidate_groups.keys() != layout_groups.keys():
        return False

    return all(
        _perfect_match(candidate_groups[key], layout_groups[key], tolerance) is not None
        for key in candidate_groups
    )

def matching_layouts(
    candidate: MultiDieReference,
    layouts: Mapping[str, MultiDieReference],
    *,
    tolerance: float = RECT_ALIGN_TOL_RATIO,
) -> list[str]:
    """Return canonical layout ids compatible with one registered reference."""
    matches = [
        layout.product
        for layout in layouts.values()
        if layout_matches(candidate, layout, tolerance=tolerance)
    ]
    return sorted(matches, key=str.casefold)


# ---- debug.reporting ----

Summary = Mapping[str, int | float | None | tuple[int, ...]]

def _markdown_table(headers: Sequence[str], rows: Sequence[Sequence[str]]) -> str:
    def cell(value: str) -> str:
        return value.replace("|", "\\|").replace("\n", " ")

    def render(row: Sequence[str]) -> str:
        return "| " + " | ".join(cell(value) for value in row) + " |"

    return "\n".join(
        (
            render(headers),
            render(("---",) * len(headers)),
            *(render(row) for row in rows),
        )
    )

def _percentage(value: int | float | None) -> str:
    return "n/a" if value is None else f"{float(value):.2%}"

def _seconds(value: int | float | None) -> str:
    return "n/a" if value is None else f"{float(value):.3f}"

def _work_weeks(value: tuple[int, ...]) -> str:
    return (
        ", ".join(
            f"{year}-W{week:02d}"
            for year, week in (divmod(item, 100) for item in value)
        )
        or "n/a"
    )

class RunReport(ABC):
    """Shared run metadata and rendering for one reporting mode."""

    title: str
    metric_headers: tuple[str, ...]

    def __init__(
        self,
        started_at: datetime,
        ended_at: datetime,
        wall_time: float,
        stats: RunStats,
        errors: dict[Path, str] | None = None,
    ) -> None:
        self.wall_time = wall_time
        self.summaries = stats.summaries()
        self.top_bad_products = stats.top_products_by_bad()
        metrics = self.summaries[0][1]
        processed = int(metrics["total_images"])
        self.data: dict[str, object] = {
            "start_time": started_at.isoformat(timespec="seconds"),
            "end_time": ended_at.isoformat(timespec="seconds"),
            "total_seconds": round(wall_time, 3),
            "total_processed_images": processed,
            "average_seconds_per_image": (
                round(wall_time / processed, 3) if processed else None
            ),
            "skipped_image_count": len(errors or {}),
            "errors": {str(path): error for path, error in (errors or {}).items()},
            "product_directories": sorted(stats.product_directories),
        }
        self._extend_data(metrics)

    @abstractmethod
    def _extend_data(self, metrics: Summary) -> None:
        """Add mode-specific JSON fields."""

    @abstractmethod
    def _metric_values(self, summary: Summary) -> tuple[str, ...]:
        """Return mode-specific table cells."""

    def format(self) -> str:
        headers = (
            "Product",
            "Total Images",
            "Average Seconds / Image",
            "Total Time",
            *self.metric_headers,
            "Unique Lots",
            "Valid Processed Work Weeks",
        )
        rows = tuple(
            (
                name,
                str(int(summary["total_images"])),
                _seconds(
                    self.wall_time / int(summary["total_images"])
                    if name == "All Products" and summary["total_images"]
                    else summary["average_seconds_per_image"]
                ),
                _seconds(
                    self.wall_time
                    if name == "All Products"
                    else summary["total_seconds"]
                ),
                *self._metric_values(summary),
                str(int(summary["unique_lots"])),
                _work_weeks(summary["valid_processed_work_weeks"]),
            )
            for name, summary in self.summaries
        )
        table = self.title + "\n\n" + _markdown_table(headers, rows)
        if self.top_bad_products:
            table += "\n\nTop 5 Products by BAD Detections\n\n" + _markdown_table(
                ("Product", "BAD Detected"),
                tuple((name, str(count)) for name, count in self.top_bad_products),
            )
        return f"==\n{json.dumps(self.data, indent=2)}\n==\n{table}"

class LabelledRunReport(RunReport):
    title = "Run Metrics"
    metric_headers = (
        "True Positive (TP)",
        "True Negative (TN)",
        "False Negative (FN)",
        "False Positive (FP)",
        "Recall",
        "Precision",
        "Accuracy",
    )

    def _extend_data(self, metrics: Summary) -> None:
        self.data.update(
            confusion_matrix={
                "actual_good": {
                    "predicted_good": metrics["true_negatives"],
                    "predicted_bad": metrics["false_positives"],
                },
                "actual_bad": {
                    "predicted_good": metrics["false_negatives"],
                    "predicted_bad": metrics["true_positives"],
                },
            },
            recall=(
                round(float(metrics["recall"]), 6)
                if metrics["recall"] is not None
                else None
            ),
            precision=(
                round(float(metrics["precision"]), 6)
                if metrics["precision"] is not None
                else None
            ),
        )

    def _metric_values(self, summary: Summary) -> tuple[str, ...]:
        return (
            str(int(summary["true_positives"])),
            str(int(summary["true_negatives"])),
            str(int(summary["false_negatives"])),
            str(int(summary["false_positives"])),
            _percentage(summary["recall"]),
            _percentage(summary["precision"]),
            _percentage(summary["accuracy"]),
        )

class UnlabelledRunReport(RunReport):
    title = "Run Predictions"
    metric_headers = ("Predicted GOOD", "Predicted BAD")

    def _extend_data(self, metrics: Summary) -> None:
        self.data.update(
            predicted_good=metrics["predicted_good"],
            predicted_bad=metrics["predicted_bad"],
        )

    def _metric_values(self, summary: Summary) -> tuple[str, ...]:
        return (
            str(int(summary["predicted_good"])),
            str(int(summary["predicted_bad"])),
        )

def build_run_report(
    started_at: datetime,
    ended_at: datetime,
    wall_time: float,
    stats: RunStats,
    errors: dict[Path, str] | None = None,
    *,
    labelled: bool = False,
) -> RunReport:
    report_type = LabelledRunReport if labelled else UnlabelledRunReport
    return report_type(started_at, ended_at, wall_time, stats, errors)

def write_run_report(
    started_at: datetime,
    ended_at: datetime,
    wall_time: float,
    stats: RunStats,
    errors: dict[Path, str] | None = None,
    *,
    labelled: bool = False,
) -> None:
    LOGGER.info(
        "%s",
        build_run_report(
            started_at, ended_at, wall_time, stats, errors, labelled=labelled
        ).format(),
    )
    flush_logging()


# ---- pipeline.classification ----

def _dark_components(
    boundary_source: np.ndarray,
    dark_boundary: np.ndarray | None,
) -> list[tuple[int, float]]:
    """Return (area, boundary-normal depth) for every retained dark component."""
    if dark_boundary is None or not np.any(dark_boundary):
        return []

    count, labels, stats, _ = cv2.connectedComponentsWithStats(
        (dark_boundary > 0).astype(np.uint8),
        connectivity=8,
    )
    distance = boundary_depth_map(boundary_source)
    return [
        (
            int(stats[component_id, cv2.CC_STAT_AREA]),
            float(distance[labels == component_id].max()),
        )
        for component_id in range(1, count)
    ]

def dark_boundary_protrusion_metrics(
    row: Measurement, *, area_px: float | None = None,
) -> tuple[int, float]:
    """Return one component's area/depth, optionally matching a reported score."""
    components = _dark_components(row.boundary_source, row.dark_boundary_mask)
    if area_px is not None:
        components = [component for component in components if component[0] == area_px]
    if not components:
        return 0, 0.0
    if area_px is not None:
        return max(components, key=lambda component: component[1])
    return max(components, key=lambda component: component[0])

def has_interdie_overflow(row: Measurement) -> bool:
    """Return whether registered inter-die evidence indicates overflow."""
    return row.registered_gap_overflow or (
        row.has_product_reference
        and (row.expected_interdie_gap_missing or np.any(interdie_overflow_mask(row)))
    )

def predict(
    row: Measurement,
    protrusion_threshold: float,
    area_threshold: float,
) -> tuple[int, float]:
    """Return GOOD for overflow evidence and BAD for no-reflow/no-overflow."""
    if row.analysis_failed:
        return BAD, 0.0
    if has_interdie_overflow(row):
        return GOOD, 0.0

    components = _dark_components(row.boundary_source, row.dark_boundary_mask)
    qualifying = [
        (area, depth)
        for area, depth in components
        if area > area_threshold and depth > protrusion_threshold
    ]
    area_px = max((area for area, _ in components), default=0)

    if qualifying:
        # Report the area of a component that actually explains the decision.
        return GOOD, float(max(area for area, _ in qualifying))
    return BAD, float(area_px)


# ---- localization.localizer ----

@dataclass(frozen=True)
class ChipLocalization:
    """Stable die geometry and its selected foreground before structural cleanup."""

    body: np.ndarray
    gap_topology: np.ndarray
    foreground: np.ndarray

def center_seed(shape: tuple[int, int]) -> np.ndarray:
    """Return the trusted central patch identifying the primary die."""
    height, width = shape
    half = max(2, round(min(shape) * CENTER_PATCH_RATIO / 2))
    seed = np.zeros(shape, np.uint8)
    seed[
        centered_slice(height // 2, half, height),
        centered_slice(width // 2, half, width),
    ] = 255
    return seed

def _seed_connected(mask: np.ndarray, seed: np.ndarray) -> np.ndarray:
    binary = np.where(mask > 0, 255, 0).astype(np.uint8)
    return component_connected_to_seed(cv2.bitwise_or(binary, seed), seed)

def _seed_profile(gray: np.ndarray, seed: np.ndarray) -> tuple[float, float] | None:
    """Return robust centre-seed intensity and its observed variation."""
    inner = cv2.erode(seed, np.ones((3, 3), np.uint8))
    values = gray[inner > 0]
    return robust_level(values) if values.size else None

def _shade_foreground(gray: np.ndarray, seed: np.ndarray) -> np.ndarray:
    """Return material no brighter than the normal variation of the centre seed."""
    profile = _seed_profile(gray, seed)
    if profile is None:
        return seed.copy()
    level, tolerance = profile
    return _seed_connected(gray.astype(np.float32) <= level + tolerance, seed)

def _seeded_otsu(
    gray: np.ndarray, seed: np.ndarray, values: np.ndarray
) -> tuple[np.ndarray, bool]:
    """Split one image into two shades and choose the class containing the seed."""
    level, _ = cv2.threshold(values, 0, 255, cv2.THRESH_BINARY | cv2.THRESH_OTSU)
    low = gray <= level
    high = ~low
    seed_pixels = seed > 0
    low_support = np.count_nonzero(low & seed_pixels)
    high_support = np.count_nonzero(high & seed_pixels)

    if low_support == high_support:
        low_area = cv2.countNonZero(_seed_connected(low, seed))
        high_area = cv2.countNonZero(_seed_connected(high, seed))
        foreground = low if low_area <= high_area else high
    else:
        foreground = low if low_support > high_support else high
    return np.where(foreground, 255, 0).astype(np.uint8), foreground is high

def seeded_otsu_foreground(gray: np.ndarray, seed: np.ndarray) -> np.ndarray:
    """Retry centrally when broad Otsu includes material unlike the seed."""
    height, width = gray.shape
    dy, dx = max(1, height // 10), max(1, width // 10)
    broad, broad_is_high = _seeded_otsu(
        gray, seed, gray[dy : height - dy, dx : width - dx]
    )
    broad_connected = _seed_connected(broad, seed)
    broad_area = cv2.countNonZero(broad_connected)
    profile = _seed_profile(gray, seed)
    # Bright surroundings can make Otsu group a dark die with lighter substrate
    # even below the area limit. Check the selected material against the seed's
    # observed variation before trusting that broad separation.
    matches_seed = profile is None or (
        np.median(gray[broad_connected > 0]) <= profile[0] + profile[1]
    )
    if (
        not broad_is_high
        and broad_area <= gray.size * MAX_CHIP_AREA_RATIO
        and matches_seed
    ):
        return broad

    y0, y1 = height // 4, height - height // 4
    x0, x1 = width // 4, width - width // 4
    local, local_is_high = _seeded_otsu(gray, seed, gray[y0:y1, x0:x1])
    local_area = cv2.countNonZero(_seed_connected(local, seed))
    if broad_is_high and not local_is_high:
        return local
    return (
        local
        if local_area < broad_area and local_area <= gray.size * MAX_CHIP_AREA_RATIO
        else broad
    )

def _compact(mask: np.ndarray) -> bool:
    return is_compact_component(mask, RECTANGULAR_SEED_FILL_RATIO)

def _without_frame_spurs(foreground: np.ndarray) -> np.ndarray:
    """Remove thin frame branches without opening the actual die contours."""
    opened = cv2.morphologyEx(
        foreground,
        cv2.MORPH_OPEN,
        np.ones((5, 5), np.uint8),
        borderType=cv2.BORDER_CONSTANT,
        borderValue=0,
    )
    # As in structural-core repair, trust opening only when most of a component
    # survives. This protects perforated dies and whole narrow, clipped islands.
    count, labels, stats, _ = cv2.connectedComponentsWithStats(foreground, 8)
    retained = np.bincount(labels[opened > 0], minlength=count)
    stable = retained * 2 >= stats[:, cv2.CC_STAT_AREA]
    stable[0] = False
    residue = (stable[labels] & (opened == 0)).astype(np.uint8)
    frame = residue.copy()
    frame[1:-1, 1:-1] = 0
    spurs = component_connected_to_seed(residue, frame)
    return np.where(spurs > 0, 0, foreground).astype(np.uint8)

def _structural_core(raw: np.ndarray, seed: np.ndarray) -> np.ndarray:
    """Cut stable narrow substrate branches without amplifying enclosed speckles."""
    if _compact(raw):
        return raw

    _, _, seed_width, seed_height = cv2.boundingRect(seed)
    size = max(3, min(seed_width, seed_height))
    if size % 2 == 0:
        size += 1
    kernel = np.ones((size, size), np.uint8)
    core = _seed_connected(cv2.morphologyEx(raw, cv2.MORPH_OPEN, kernel), seed)
    core_area = cv2.countNonZero(core)
    seed_area = cv2.countNonZero(seed)
    raw_area = cv2.countNonZero(raw)
    if core_area <= seed_area:
        return raw

    should_repair = _compact(core) and core_area * 2 >= raw_area
    if not should_repair:
        return raw

    # Large openings can magnify tiny bright speckles into false structural cuts.
    # Only trust hole filling as stabilization when it repairs less material than
    # the opening removed; otherwise it has enclosed external background.
    if touches_image_frame(raw):
        stabilized = fill_enclosed_holes(raw, close_size=1)
        stable_core = _seed_connected(
            cv2.morphologyEx(stabilized, cv2.MORPH_OPEN, kernel), seed
        )
        raw_loss = raw_area - core_area
        fill_gain = cv2.countNonZero(stabilized) - raw_area
        stable_loss = cv2.countNonZero(stabilized) - cv2.countNonZero(stable_core)
        if raw_loss >= seed_area and stable_loss < seed_area and fill_gain <= raw_loss:
            return raw

    # The opening is shape evidence, not a replacement die contour.  Keep the
    # original thresholded pixels inside its stable bounds so branch removal
    # cannot flatten genuine edge detail into the opened kernel shape.
    x, y, width, height = cv2.boundingRect(core)
    bounded = np.zeros_like(raw)
    bounded[y : y + height, x : x + width] = raw[y : y + height, x : x + width]
    return _seed_connected(bounded, seed)

def _candidate_score(mask: np.ndarray) -> tuple[int, int]:
    """Prefer coherent geometry before simply preferring the larger threshold."""
    area = cv2.countNonZero(mask)
    if touches_image_frame(mask):
        return 0, area
    return (2 if _compact(mask) else 1), area

def _has_observable_exterior(candidate: np.ndarray) -> bool:
    """Require visible exterior, allowing large and frame-clipped material bodies.

    Holes are internal texture, not evidence that a full-frame candidate ends.
    Filling external contours also handles rings surrounding the entire image.
    """
    contours, _ = cv2.findContours(
        candidate, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
    )
    exterior = np.zeros_like(candidate)
    cv2.drawContours(exterior, contours, -1, 255, cv2.FILLED)
    return cv2.countNonZero(exterior) < candidate.size

def _primary_candidate(
    gray: np.ndarray, seed: np.ndarray, otsu_foreground: np.ndarray
) -> tuple[np.ndarray, np.ndarray]:
    """Select the stable body without discarding its originating foreground."""
    foregrounds = [
        _without_frame_spurs(raw)
        for raw in (
            _shade_foreground(gray, seed),
            _seed_connected(otsu_foreground, seed),
        )
    ]
    candidates = [(_structural_core(raw, seed), raw) for raw in foregrounds]
    minimum = gray.size * MIN_CHIP_AREA_RATIO
    candidates = [
        candidate
        for candidate in candidates
        if cv2.countNonZero(candidate[0]) >= minimum
        and _has_observable_exterior(candidate[0])
    ]
    if not candidates:
        raise ValueError("cannot localize a plausible chip region")
    return max(candidates, key=lambda candidate: _candidate_score(candidate[0]))

def _nearby_search_band(localized: np.ndarray) -> np.ndarray:
    """Return one component-scaled neighbourhood outside existing die geometry."""
    search = np.zeros_like(localized)
    count, labels = cv2.connectedComponents((localized > 0).astype(np.uint8), 8)
    for component_id in range(1, count):
        component = (labels == component_id).astype(np.uint8)
        _, _, width, height = cv2.boundingRect(component)
        radius = max(2, round(min(width, height) * 2 * OVERFLOW_SEARCH_RATIO))
        kernel = cv2.getStructuringElement(
            cv2.MORPH_RECT, (2 * radius + 1, 2 * radius + 1)
        )
        search = cv2.bitwise_or(search, cv2.dilate(component * 255, kernel))
    search[localized > 0] = 0
    return search

def _has_die_core(component: np.ndarray, minimum_side: int) -> bool:
    """Return whether a candidate contains a broad 2-D core at die scale."""
    _, _, width, height = cv2.boundingRect(component)
    if not width or not height:
        return False

    # Opening is shape evidence only. Reuse the minimum die scale rather than
    # introducing another fill ratio or morphology threshold, and keep the
    # original component unchanged when accepted.
    kernel = cv2.getStructuringElement(
        cv2.MORPH_RECT,
        (
            max(1, min(minimum_side, width)),
            max(1, min(minimum_side, height)),
        ),
    )
    opened = cv2.morphologyEx(component, cv2.MORPH_OPEN, kernel)
    return bool(cv2.countNonZero(opened))

def _wraps_localized(candidate: np.ndarray, localized: np.ndarray) -> bool:
    """Reject substrate/frame components that enclose an existing die."""
    material = candidate > 0
    candidate_x, candidate_y, candidate_width, candidate_height = cv2.boundingRect(
        candidate
    )
    candidate_x1 = candidate_x + candidate_width
    candidate_y1 = candidate_y + candidate_height
    count, labels = cv2.connectedComponents((localized > 0).astype(np.uint8), 8)
    for component_id in range(1, count):
        component = labels == component_id
        y, x = np.where(component)
        if not x.size:
            continue
        x0, x1 = int(x.min()), int(x.max()) + 1
        y0, y1 = int(y.min()), int(y.max()) + 1

        if (
            candidate_x <= x0
            and candidate_x1 >= x1
            and candidate_y <= y0
            and candidate_y1 >= y1
        ):
            return True

        left = x0 > 0 and np.any(material[y0:y1, :x0])
        right = x1 < material.shape[1] and np.any(material[y0:y1, x1:])
        top = y0 > 0 and np.any(material[:y0, x0:x1])
        bottom = y1 < material.shape[0] and np.any(material[y1:, x0:x1])
        if (left and right) or (top and bottom):
            return True
    return False

def _nearby_rectangles(
    gray: np.ndarray, otsu_foreground: np.ndarray, localized: np.ndarray
) -> list[np.ndarray]:
    """Find detached die rectangles in either adaptive Otsu polarity."""
    minimum_side = max(2, round(min(gray.shape) * MIN_RECT_SIDE_RATIO))
    tolerance = max(1, round(min(gray.shape) * RECT_ALIGN_TOL_RATIO))
    image_height, image_width = gray.shape
    candidates: list[np.ndarray] = []

    for foreground in (otsu_foreground, cv2.bitwise_not(otsu_foreground)):
        count, labels, stats, _ = cv2.connectedComponentsWithStats(
            (foreground > 0).astype(np.uint8), 8
        )
        overlapping = np.bincount(labels[localized > 0], minlength=count) > 0
        for component_id in range(1, count):
            if overlapping[component_id]:
                continue
            x, y, width, height, _ = map(int, stats[component_id])
            if not width or not height:
                continue
            if (x == 0 and x + width == image_width) or (
                y == 0 and y + height == image_height
            ):
                continue
            if min(width, height) < minimum_side and not is_border_clipped_rectangle(
                x, y, width, height, gray.shape, minimum_side, tolerance
            ):
                continue

            component = np.where(labels == component_id, 255, 0).astype(np.uint8)
            if _wraps_localized(component, localized):
                continue
            if not _has_die_core(component, minimum_side):
                continue
            candidates.append(component)
    return candidates

def _overlapping_side_candidates(
    gray: np.ndarray,
    seed: np.ndarray,
    otsu_foreground: np.ndarray,
    localized: np.ndarray,
) -> list[np.ndarray]:
    """Recover same-shade die sections hidden inside an overlapping Otsu component."""
    profile = _seed_profile(gray, seed)
    if profile is None:
        return []
    seed_level, seed_tolerance = profile

    minimum_side = max(2, round(min(gray.shape) * MIN_RECT_SIDE_RATIO))
    tolerance = max(1, round(min(gray.shape) * RECT_ALIGN_TOL_RATIO))
    image_height, image_width = gray.shape

    _, otsu_labels = cv2.connectedComponents((otsu_foreground > 0).astype(np.uint8), 8)
    localized_count, localized_labels = cv2.connectedComponents(
        (localized > 0).astype(np.uint8), 8
    )
    search = _nearby_search_band(localized) > 0

    # One-pixel Otsu bridges can join a real neighbouring die to the primary.
    # Remove only the immediate contact before splitting outside components.
    guard = (
        cv2.dilate(
            (localized > 0).astype(np.uint8),
            np.ones((3, 3), np.uint8),
        )
        > 0
    )

    candidates: list[np.ndarray] = []
    seen: set[tuple[str, int, int, int, int, int]] = set()

    for localized_id in range(1, localized_count):
        localized_component = localized_labels == localized_id
        y, x = np.where(localized_component)
        if not x.size:
            continue
        x0, x1 = int(x.min()), int(x.max()) + 1
        y0, y1 = int(y.min()), int(y.max()) + 1

        otsu_ids = np.unique(otsu_labels[localized_component])
        for otsu_id in otsu_ids[otsu_ids > 0]:
            outside = (otsu_labels == otsu_id) & ~guard
            side_regions = (
                (
                    "top",
                    outside[:y0, :],
                    (0, y0, 0, image_width),
                    (slice(0, y0), slice(x0, x1)),
                ),
                (
                    "bottom",
                    outside[y1:, :],
                    (y1, image_height, 0, image_width),
                    (slice(y1, image_height), slice(x0, x1)),
                ),
                (
                    "left",
                    outside[:, :x0],
                    (0, image_height, 0, x0),
                    (slice(y0, y1), slice(0, x0)),
                ),
                (
                    "right",
                    outside[:, x1:],
                    (0, image_height, x1, image_width),
                    (slice(y0, y1), slice(x1, image_width)),
                ),
            )

            for side, side_mask, bounds, anchor_slice in side_regions:
                if not side_mask.size or not np.any(side_mask):
                    continue
                region_count, region_labels, stats, _ = (
                    cv2.connectedComponentsWithStats(side_mask.astype(np.uint8), 8)
                )
                y_start, y_stop, x_start, x_stop = bounds

                for region_id in range(1, region_count):
                    rel_x, rel_y, width, height, area = map(int, stats[region_id])
                    x_start_region = x_start + rel_x
                    y_start_region = y_start + rel_y

                    candidate = np.zeros_like(otsu_foreground)
                    region = region_labels == region_id
                    candidate[y_start:y_stop, x_start:x_stop][region] = 255

                    anchor_y, anchor_x = anchor_slice
                    if not np.any(
                        (candidate > 0)[anchor_y, anchor_x] & search[anchor_y, anchor_x]
                    ):
                        continue

                    if side == "top":
                        gap = y0 - (y_start_region + height)
                        span = width
                        tangential_frame = (
                            x_start_region == 0 or x_start_region + width == image_width
                        )
                    elif side == "bottom":
                        gap = y_start_region - y1
                        span = width
                        tangential_frame = (
                            x_start_region == 0 or x_start_region + width == image_width
                        )
                    elif side == "left":
                        gap = x0 - (x_start_region + width)
                        span = height
                        tangential_frame = (
                            y_start_region == 0
                            or y_start_region + height == image_height
                        )
                    else:
                        gap = x_start_region - x1
                        span = height
                        tangential_frame = (
                            y_start_region == 0
                            or y_start_region + height == image_height
                        )

                    if (
                        gap < 0
                        or gap > tolerance
                        or span < minimum_side
                        or tangential_frame
                    ):
                        continue
                    if not _has_die_core(candidate, minimum_side):
                        continue

                    candidate_level = float(np.median(gray[candidate > 0]))
                    if abs(candidate_level - seed_level) > seed_tolerance:
                        continue

                    key = (
                        side,
                        x_start_region,
                        y_start_region,
                        width,
                        height,
                        area,
                    )
                    if key not in seen:
                        candidates.append(candidate)
                        seen.add(key)

    return candidates

def _localize_chip(gray: np.ndarray) -> ChipLocalization:
    """Retain body, gap topology, and selected foreground from one localization."""
    if gray.ndim != 2 or gray.dtype != np.uint8:
        raise ValueError("localization expects an 8-bit grayscale image")
    if gray.min() == gray.max():
        raise ValueError("detected chip shape occupies too much of the image")

    seed = center_seed(gray.shape)
    DEBUG.show("profile seed", seed, "Centre seed", BLUE)

    otsu_foreground = seeded_otsu_foreground(gray, seed)
    localized, foreground = _primary_candidate(gray, seed, otsu_foreground)
    DEBUG.show("localized chip candidate", localized, "Localized chip", GREEN)

    candidates = _nearby_rectangles(gray, otsu_foreground, localized)
    debug = DEBUG.buffers(gray, "potential", "retained")
    for candidate in candidates:
        debug.paint("potential", candidate)

    maximum = gray.size * MAX_CHIP_AREA_RATIO
    while candidates:
        search = _nearby_search_band(localized)
        remaining: list[np.ndarray] = []
        accepted = False
        for candidate in candidates:
            if cv2.countNonZero(cv2.bitwise_and(candidate, search)) == 0:
                remaining.append(candidate)
                continue
            combined = cv2.bitwise_or(localized, candidate)
            if cv2.countNonZero(combined) <= maximum:
                localized = combined
                accepted = True
                debug.paint("retained", candidate)
        if not accepted:
            break
        candidates = remaining

    # Hole filling is useful for the final inspection body, but registered
    # multi-die matching still needs clear enclosed separator topology.
    # fill_enclosed_holes() returns a new array, so retaining this reference is
    # enough; no extra full-frame copy is required.
    gap_topology = localized
    localized = fill_enclosed_holes(localized, close_size=1)

    # Recover valid die sections that Otsu connected weakly to an existing die.
    # This is terminal: recovered sections cannot recursively grow the search.
    side_candidates = _overlapping_side_candidates(
        gray, seed, otsu_foreground, localized
    )
    for candidate in side_candidates:
        debug.paint("potential", candidate)
        combined = cv2.bitwise_or(localized, candidate)
        if cv2.countNonZero(combined) <= maximum:
            localized = combined
            gap_topology = cv2.bitwise_or(gap_topology, candidate)
            debug.paint("retained", candidate)

    potential = debug.mask("potential")
    if potential is not None and np.any(potential):
        DEBUG.show(
            "nearby rectangle candidates",
            potential,
            "Potential rectangle",
            BLUE,
            style="outline",
        )
        DEBUG.show(
            "nearby rectangle candidates",
            debug.mask("retained"),
            "Retained rectangle",
            GREEN,
            style="outline",
        )
    # Clean the selected evidence together after die selection, so cutting a
    # frame line cannot make its detached fragments look like nearby dies.
    cleaned_foreground = _without_frame_spurs(foreground)
    removed = (foreground > 0) & (cleaned_foreground == 0)
    localized = np.where(removed, 0, localized).astype(np.uint8)
    gap_topology = np.where(removed, 0, gap_topology).astype(np.uint8)
    DEBUG.show("merged localized chip", localized, "Merged localized chip", GREEN)
    return ChipLocalization(localized, gap_topology, cleaned_foreground)

def _minimum_component_fill(mask: np.ndarray) -> float:
    """Return the least rectangular fill among localized components."""
    count, _, stats, _ = cv2.connectedComponentsWithStats(
        (mask > 0).astype(np.uint8), 8
    )
    if count <= 1:
        return 0.0
    components = stats[1:]
    boxes = components[:, cv2.CC_STAT_WIDTH] * components[:, cv2.CC_STAT_HEIGHT]
    return float(np.min(components[:, cv2.CC_STAT_AREA] / boxes))

def localize_chip_evidence(gray: np.ndarray) -> ChipLocalization:
    """Retry incomplete localization once with percentile-normalized contrast."""
    result = _localize_chip(gray)
    fill = _minimum_component_fill(result.body)
    if fill >= RECTANGULAR_SEED_FILL_RATIO:
        return result

    normalized = normalize_localization_contrast(gray)
    if np.array_equal(normalized, gray):
        return result

    DEBUG.show("contrast-normalized localization retry", image=normalized)
    try:
        candidate = _localize_chip(normalized)
    except ValueError:
        return result
    if _minimum_component_fill(candidate.body) > fill:
        DEBUG.show(
            "contrast-normalized localization selected",
            candidate.body,
            "Localized chip",
            GREEN,
        )
        return candidate
    DEBUG.show("original localization retained", result.body, "Localized chip", GREEN)
    return result

def localize_chip_with_topology(gray: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    """Return stable die geometry and the pre-hole-fill gap topology."""
    result = localize_chip_evidence(gray)
    return result.body, result.gap_topology

def localize_chip(gray: np.ndarray) -> np.ndarray:
    """Localize primary and nearby dies without GrabCut or recursive shade growth."""
    return localize_chip_evidence(gray).body


# ---- runtime ----

_RunRecord = tuple[str, Sample | None, int | None]

_QUEUE_SIZE = 1024

_PREDICTION_HEADER = ("lot_number", "prodgroup3", "image_path", "prediction")

_FAILED_READ_HEADER = ("lot_number", "prodgroup3", "image_path")

class AsyncRunWriter:
    """Serialize bounded, periodic run output off the inference path."""

    def __init__(
        self,
        results_path: Path | None,
        history_path: Path | None,
        include_metadata: bool = False,
        run_dir: Path | None = None,
    ) -> None:
        self._results_path = results_path
        self._history_path = history_path
        self._include_metadata = include_metadata
        self._prediction_path = run_dir / "prediction.csv" if run_dir else None
        self._failed_read_path = run_dir / "failed_to_read.csv" if run_dir else None
        if run_dir is not None:
            run_dir.mkdir(parents=True, exist_ok=True)
            self._ensure_csv(self._prediction_path, _PREDICTION_HEADER)
            self._ensure_csv(self._failed_read_path, _FAILED_READ_HEADER)
        self._queue: Queue[_RunRecord | None] = Queue(maxsize=_QUEUE_SIZE)
        self._failure: BaseException | None = None
        self._thread: Thread | None = Thread(target=self._run, name="run-output-writer")
        self._thread.start()

    def __enter__(self) -> "AsyncRunWriter":
        return self

    def submit(
        self,
        samples: Sequence[Sample] = (),
        predicted: Sequence[int] = (),
        unreadable_samples: Collection[Sample] = (),
    ) -> None:
        if len(samples) != len(predicted):
            raise ValueError("samples and predictions must have the same length")
        for sample, label in zip(samples, predicted, strict=True):
            self.submit_prediction(sample, int(label))
        for sample in unreadable_samples:
            self.submit_failed_read(sample)
        self.flush()

    def submit_prediction(self, sample: Sample, predicted: int) -> None:
        self._put(("prediction", sample, int(predicted)))

    def submit_failed_read(self, sample: Sample) -> None:
        self._put(("failed_read", sample, None))

    def flush(self) -> None:
        """Request an asynchronous batch flush after records already queued."""
        self._put(("flush", None, None))

    def _put(self, item: _RunRecord) -> None:
        if self._thread is None:
            raise RuntimeError("run writer is closed")
        if self._failure is not None:
            raise RuntimeError("failed to persist run outputs") from self._failure
        self._queue.put(item)

    def _run(self) -> None:
        predictions: list[tuple[Sample, int]] = []
        failed_reads: list[Sample] = []
        while (item := self._queue.get()) is not None:
            kind, sample, label = item
            if kind == "prediction":
                assert sample is not None and label is not None
                predictions.append((sample, label))
            elif kind == "failed_read":
                assert sample is not None
                failed_reads.append(sample)
            else:
                self._flush(predictions, failed_reads)

        self._flush(predictions, failed_reads)

    def _flush(
        self, predictions: list[tuple[Sample, int]], failed_reads: list[Sample]
    ) -> None:
        if not predictions and not failed_reads:
            return
        try:
            samples = [sample for sample, _ in predictions]
            labels = [label for _, label in predictions]
            self.update_run_outputs(
                self._results_path,
                self._history_path,
                samples,
                labels,
                self._include_metadata,
            )
            self._append_run_csv(
                self._prediction_path,
                _PREDICTION_HEADER,
                (
                    (
                        sample.lot or "",
                        sample.prodgroup3 or product_key(sample),
                        str(sample.path),
                        label_name(label),
                    )
                    for sample, label in predictions
                ),
            )
            self._append_run_csv(
                self._failed_read_path,
                _FAILED_READ_HEADER,
                (
                    (
                        sample.lot or "",
                        sample.prodgroup3 or product_key(sample),
                        str(sample.path),
                    )
                    for sample in failed_reads
                ),
            )
        except BaseException as error:  # noqa: BLE001 - surfaced by close()
            if self._failure is None:
                self._failure = error
        finally:
            predictions.clear()
            failed_reads.clear()

    def close(self) -> None:
        thread, self._thread = self._thread, None
        if thread is not None:
            self._queue.put(("flush", None, None))
            self._queue.put(None)
            thread.join()
        if self._failure is not None:
            raise RuntimeError("failed to persist run outputs") from self._failure

    def __exit__(self, *_exc_info) -> None:
        self.close()

    @staticmethod
    def update_run_outputs(
        results_path: Path | None,
        history_path: Path | None,
        samples: Sequence[Sample],
        predicted: Sequence[int],
        include_metadata: bool = False,
    ) -> None:
        """Append configured result and history records."""
        if results_path is not None:
            AsyncRunWriter.append_results(
                results_path, samples, predicted, include_metadata
            )
        if history_path is not None:
            AsyncRunWriter.append_history(
                history_path, [sample.path for sample in samples], predicted
            )

    @staticmethod
    def _ensure_csv(path: Path | None, header: tuple[str, ...]) -> None:
        if path is not None and (not path.exists() or not path.stat().st_size):
            with path.open("a", encoding="utf-8", newline="") as file:
                csv.writer(file).writerow(header)

    @staticmethod
    def _append_run_csv(
        path: Path | None,
        header: tuple[str, ...],
        rows: Iterable[tuple[str, ...]],
    ) -> None:
        if path is None:
            return
        batch = tuple(rows)
        if not batch:
            return
        AsyncRunWriter._ensure_csv(path, header)
        with path.open("a", encoding="utf-8", newline="") as file:
            csv.writer(file).writerows(batch)

    @staticmethod
    def append_history(
        history_path: Path,
        sources: Sequence[Path | PureWindowsPath],
        predicted: Sequence[int],
    ) -> None:
        if len(sources) != len(predicted):
            raise ValueError("history paths and predictions must have the same length")
        history_path.parent.mkdir(parents=True, exist_ok=True)
        timestamp = datetime.now(MALAYSIA_TIMEZONE).isoformat(timespec="seconds")
        with history_path.open("a", encoding="utf-8", newline="") as file:
            for source, label in zip(sources, predicted, strict=True):
                file.write(f"{timestamp}\t{source}\t{label_name(int(label))}\n")

    @staticmethod
    def append_results(
        results_path: Path,
        samples: Sequence[Sample],
        predicted: Sequence[int],
        include_metadata: bool = False,
    ) -> None:
        if len(samples) != len(predicted):
            raise ValueError("result samples and predictions must have the same length")
        bad_results = tuple(
            (sample, int(label))
            for sample, label in zip(samples, predicted, strict=True)
            if int(label) == BAD
        )
        if not bad_results:
            return
        results_path.parent.mkdir(parents=True, exist_ok=True)
        with results_path.open("a", encoding="utf-8", newline="") as file:
            writer = csv.writer(file)
            if results_path.stat().st_size == 0:
                writer.writerow(
                    ("path", "result", "prodgroup3", "lot", "VID")
                    if include_metadata
                    else ("path", "result")
                )
            writer.writerows(
                (
                    (
                        str(sample.path),
                        label_name(int(label)),
                        sample.prodgroup3 or "",
                        sample.lot or "",
                        sample.vid or "",
                    )
                    if include_metadata
                    else (str(sample.path), label_name(int(label)))
                )
                for sample, label in bad_results
            )


# ---- gap_detection.discovery ----

GapState = Literal["complete", "partial"]

GapLine = tuple[int, int, int, float, float]

@dataclass(frozen=True)
class LocalizedInterdieGap:
    """One physical separator inferred from localized material topology."""

    orientation: str
    x0: int
    y0: int
    x1: int
    y1: int
    state: GapState
    clear_fraction: float
    support_fraction: float

    @property
    def box(self) -> Box:
        return self.x0, self.y0, self.x1, self.y1

    @property
    def is_complete(self) -> bool:
        return self.state == "complete"

    @property
    def confidence(self) -> float:
        return self.clear_fraction * self.support_fraction

def _gap_analysis_mask(localized: np.ndarray) -> np.ndarray:
    mask = np.where(localized > 0, 255, 0).astype(np.uint8)
    margin = max(1, round(min(mask.shape) * RECT_ALIGN_TOL_RATIO))
    mask[:margin] = 0
    mask[-margin:] = 0
    mask[:, :margin] = 0
    mask[:, -margin:] = 0
    return mask

def _external_background(mask: np.ndarray) -> np.ndarray:
    background = (mask == 0).astype(np.uint8)
    _, labels = cv2.connectedComponents(background, 8)
    border_labels = np.unique(
        np.concatenate((labels[0], labels[-1], labels[:, 0], labels[:, -1]))
    )
    return (background > 0) & np.isin(labels, border_labels)

def _component_profile_gap(
    first: np.ndarray, second: np.ndarray
) -> tuple[Box, float] | None:
    first_points = np.nonzero(first)
    second_points = np.nonzero(second)
    if not len(first_points[0]) or not len(second_points[0]):
        return None

    left, right = (
        (first, second)
        if float(np.mean(first_points[1])) <= float(np.mean(second_points[1]))
        else (second, first)
    )
    shared = np.flatnonzero(np.any(left, axis=1) & np.any(right, axis=1))
    if not len(shared):
        return None

    left_edge = left.shape[1] - np.argmax(left[shared, ::-1], axis=1)
    right_edge = np.argmax(right[shared], axis=1)
    separated = right_edge > left_edge
    profile_clear = float(np.mean(separated))
    if profile_clear < MIN_EDGE_COVERAGE:
        return None

    clear_left = left_edge[separated]
    clear_right = right_edge[separated]
    x0 = int(np.ceil(np.quantile(clear_left, MIN_EDGE_COVERAGE)))
    x1 = int(np.floor(np.quantile(clear_right, 1.0 - MIN_EDGE_COVERAGE)))
    if x1 <= x0:
        x0 = int(round(float(np.median(clear_left))))
        x1 = int(round(float(np.median(clear_right))))
    if x1 <= x0:
        return None
    return (x0, int(shared[0]), x1, int(shared[-1] + 1)), profile_clear

def _component_longitudinal_extent(box: Box, orientation: str) -> int:
    return box[3] - box[1] if orientation == "vertical" else box[2] - box[0]

def _minimum_pair_span(first_box: Box, second_box: Box, orientation: str) -> int:
    pair_extent = min(
        _component_longitudinal_extent(first_box, orientation),
        _component_longitudinal_extent(second_box, orientation),
    )
    return max(2, round(pair_extent * MIN_GAP_FACE_SPAN_RATIO))

def _component_pair_gap(
    mask: np.ndarray,
    first: np.ndarray,
    second: np.ndarray,
    first_box: Box,
    second_box: Box,
    orientation: str,
    total_width: int,
    total_height: int,
) -> LocalizedInterdieGap | None:
    minimum_span = _minimum_pair_span(first_box, second_box, orientation)
    if orientation == "vertical":
        profiled = _component_profile_gap(first, second)
        if profiled is None:
            return None
        box, profile_clear = profiled
        span = box[3] - box[1]
        minimum_depth = max(2, round(total_width * OVERFLOW_SEARCH_RATIO))
        first_depth = first_box[2] - first_box[0]
        second_depth = second_box[2] - second_box[0]
        support_fraction = span / total_height
    else:
        profiled = _component_profile_gap(first.T, second.T)
        if profiled is None:
            return None
        transposed, profile_clear = profiled
        box = (transposed[1], transposed[0], transposed[3], transposed[2])
        span = box[2] - box[0]
        minimum_depth = max(2, round(total_height * OVERFLOW_SEARCH_RATIO))
        first_depth = first_box[3] - first_box[1]
        second_depth = second_box[3] - second_box[1]
        support_fraction = span / total_width

    if span < minimum_span or min(first_depth, second_depth) < minimum_depth:
        return None

    x0, y0, x1, y1 = box
    other_material = (mask > 0) & ~(first | second)
    if np.any(other_material[y0:y1, x0:x1]):
        return None

    corridor = mask[y0:y1, x0:x1]
    if not corridor.size:
        return None
    corridor_clear = 1.0 - float(np.count_nonzero(corridor)) / corridor.size
    if corridor_clear < MIN_EDGE_COVERAGE:
        return None

    return LocalizedInterdieGap(
        orientation,
        x0,
        y0,
        x1,
        y1,
        "complete",
        min(profile_clear, corridor_clear),
        support_fraction,
    )

def _complete_component_gaps(mask: np.ndarray) -> list[LocalizedInterdieGap]:
    count, labels, stats, _ = cv2.connectedComponentsWithStats(mask, connectivity=8)
    if count <= 2:
        return []

    _, _, total_width, total_height = cv2.boundingRect(mask)
    components = [labels == component_id for component_id in range(1, count)]
    boxes = [
        (
            int(stats[component_id, cv2.CC_STAT_LEFT]),
            int(stats[component_id, cv2.CC_STAT_TOP]),
            int(stats[component_id, cv2.CC_STAT_LEFT] + stats[component_id, cv2.CC_STAT_WIDTH]),
            int(stats[component_id, cv2.CC_STAT_TOP] + stats[component_id, cv2.CC_STAT_HEIGHT]),
        )
        for component_id in range(1, count)
    ]

    gaps: list[LocalizedInterdieGap] = []
    for first_id, first in enumerate(components):
        for second_id, second in enumerate(components[first_id + 1 :], first_id + 1):
            for orientation in ORIENTATIONS:
                gap = _component_pair_gap(
                    mask,
                    first,
                    second,
                    boxes[first_id],
                    boxes[second_id],
                    orientation,
                    total_width,
                    total_height,
                )
                if gap is not None:
                    gaps.append(gap)
    return gaps

def _opposed_support(mask: np.ndarray, depth: int) -> np.ndarray:
    height, width = mask.shape
    cumulative = np.vstack(
        (
            np.zeros((1, width), dtype=np.int32),
            np.cumsum(mask > 0, axis=0, dtype=np.int32),
        )
    )
    indices = np.arange(height)
    before = cumulative[indices] - cumulative[np.maximum(0, indices - depth)]
    after = cumulative[np.minimum(height, indices + depth + 1)] - cumulative[indices + 1]
    return (before > 0) & (after > 0)

def _record_opposed_faces(
    target: np.ndarray,
    mask: np.ndarray,
    index: int,
    start: int,
    stop: int,
    depth: int,
) -> None:
    top = max(0, index - depth)
    bottom = min(mask.shape[0], index + depth + 1)
    for x in range(start, stop):
        before = np.flatnonzero(mask[top:index, x] > 0)
        after = np.flatnonzero(mask[index + 1 : bottom, x] > 0)
        if len(before):
            target[top + int(before[-1]), x] = 255
        if len(after):
            target[index + 1 + int(after[0]), x] = 255

def _runs(values: np.ndarray) -> list[tuple[int, int]]:
    indices = np.flatnonzero(values)
    if not len(indices):
        return []
    cuts = np.flatnonzero(np.diff(indices) > 1) + 1
    return [(int(run[0]), int(run[-1] + 1)) for run in np.split(indices, cuts)]

def _longest_run(values: np.ndarray) -> tuple[int, int] | None:
    return max(_runs(values), key=lambda run: run[1] - run[0], default=None)

def _candidate_lines(
    mask: np.ndarray,
    clear_mask: np.ndarray,
    *,
    require_external_connection: bool,
    scan_bounds: tuple[int, int] | None = None,
    face_bounds: tuple[int, int] | None = None,
    minimum_clear_run_ratio: float | None = None,
) -> tuple[
    list[GapLine],
    int,
    np.ndarray | None,
    np.ndarray | None,
    np.ndarray | None,
]:
    y, x = np.nonzero(mask)
    if not len(y):
        return [], 0, None, None, None

    scan_start, scan_stop = int(y.min()), int(y.max() + 1)
    face_start, face_stop = int(x.min()), int(x.max() + 1)
    scan_length = scan_stop - scan_start
    if face_bounds is not None:
        face_start = max(face_start, face_bounds[0], 0)
        face_stop = min(face_stop, face_bounds[1], mask.shape[1])
    if face_stop <= face_start:
        return [], scan_length, None, None, None

    face_length = face_stop - face_start
    depth = max(2, round(scan_length * MIN_GAP_FACE_SPAN_RATIO))
    minimum_span = max(2, round(face_length * MIN_GAP_FACE_SPAN_RATIO))
    facing = _opposed_support(mask, depth)

    candidate = np.zeros_like(mask) if DEBUG.active else None
    retained = np.zeros_like(mask) if DEBUG.active else None
    facing_support = np.zeros_like(mask) if DEBUG.active else None
    lines: list[GapLine] = []

    iteration_start = scan_start + 1
    iteration_stop = scan_stop - 1
    if scan_bounds is not None:
        iteration_start = max(iteration_start, scan_bounds[0], 0)
        iteration_stop = min(iteration_stop, scan_bounds[1], mask.shape[0])

    for index in range(iteration_start, iteration_stop):
        for start, stop in _runs(facing[index, face_start:face_stop]):
            start += face_start
            stop += face_start
            span = stop - start
            if span < minimum_span:
                continue

            clear = clear_mask[index, start:stop]
            clear_fraction = float(np.count_nonzero(clear) / span)
            if candidate is not None and clear_fraction >= MIN_EDGE_COVERAGE * 0.5:
                candidate[index, start:stop] = 255
                assert facing_support is not None
                _record_opposed_faces(facing_support, mask, index, start, stop, depth)

            clear_run = _longest_run(clear)
            if clear_run is None:
                continue
            if minimum_clear_run_ratio is None:
                if clear_fraction < MIN_EDGE_COVERAGE:
                    continue
            elif clear_run[1] - clear_run[0] < max(
                2, round(span * minimum_clear_run_ratio)
            ):
                continue
            if require_external_connection and clear_run[0] != 0 and clear_run[1] != span:
                continue

            if retained is not None:
                retained[index, start:stop] = 255
            lines.append((index, start, stop, clear_fraction, span / face_length))

    return lines, scan_length, candidate, retained, facing_support

def _merge_partial_lines(
    lines: list[GapLine], orientation: str, max_thickness: int, shape: tuple[int, int]
) -> list[LocalizedInterdieGap]:
    if not lines:
        return []

    raster = np.zeros(shape, np.uint8)
    for index, start, stop, _, _ in lines:
        raster[index, start:stop] = 255

    count, labels, stats, _ = cv2.connectedComponentsWithStats(raster, connectivity=4)
    grouped: dict[int, list[GapLine]] = {component_id: [] for component_id in range(1, count)}
    for line in lines:
        component_id = int(labels[line[0], line[1]])
        if component_id:
            grouped[component_id].append(line)

    gaps: list[LocalizedInterdieGap] = []
    for component_id, group in grouped.items():
        if not group:
            continue
        scan_start = int(stats[component_id, cv2.CC_STAT_TOP])
        scan_stop = scan_start + int(stats[component_id, cv2.CC_STAT_HEIGHT])
        if scan_stop - scan_start > max_thickness:
            continue

        best = max(
            group,
            key=lambda line: (
                line[3] * line[4],
                line[4],
            ),
        )
        box = (
            (best[1], scan_start, best[2], scan_stop)
            if orientation == "horizontal"
            else (scan_start, best[1], scan_stop, best[2])
        )
        gaps.append(
            LocalizedInterdieGap(
                orientation,
                *box,
                "partial",
                best[3],
                best[4],
            )
        )
    return gaps

def _partial_axis_gaps(
    mask: np.ndarray,
    clear_mask: np.ndarray,
    orientation: str,
    *,
    require_external_connection: bool,
) -> tuple[
    list[LocalizedInterdieGap],
    tuple[np.ndarray | None, np.ndarray | None, np.ndarray | None],
]:
    working_mask = mask if orientation == "horizontal" else mask.T
    working_clear = clear_mask if orientation == "horizontal" else clear_mask.T
    lines, scan_length, candidate, retained, facing = _candidate_lines(
        working_mask,
        working_clear,
        require_external_connection=require_external_connection,
    )
    max_thickness = max(2, round(scan_length * 2 * OVERFLOW_SEARCH_RATIO))
    gaps = _merge_partial_lines(lines, orientation, max_thickness, working_mask.shape)
    if orientation == "vertical":
        candidate = None if candidate is None else candidate.T
        retained = None if retained is None else retained.T
        facing = None if facing is None else facing.T
    return gaps, (candidate, retained, facing)

def discover_registered_gap_candidates(
    localized: np.ndarray,
    expected: Box,
    orientation: str,
    max_shift_px: int,
) -> list[LocalizedInterdieGap]:
    """Find physical corridor candidates near one registered separator.

    Registered geometry constrains the search location and longitudinal span, so
    discovery only needs a substantial continuous clear run to locate the
    physical corridor. Gap occupancy remains a separate validation decision.
    """
    if localized.ndim != 2:
        raise ValueError("localized mask must be 2-D")
    if orientation not in ORIENTATIONS:
        raise ValueError("gap orientation must be horizontal or vertical")

    mask = _gap_analysis_mask(localized)
    if not np.any(mask):
        return []

    cross, longitudinal = axis_intervals(expected, orientation)
    working_mask = mask if orientation == "horizontal" else mask.T
    working_clear = (mask == 0) if orientation == "horizontal" else (mask == 0).T
    lines, scan_length, _, _, _ = _candidate_lines(
        working_mask,
        working_clear,
        require_external_connection=False,
        scan_bounds=(cross[0] - max_shift_px, cross[1] + max_shift_px),
        face_bounds=longitudinal,
        minimum_clear_run_ratio=MIN_GAP_FACE_SPAN_RATIO,
    )
    max_thickness = max(2, round(scan_length * 2 * OVERFLOW_SEARCH_RATIO))
    return _merge_partial_lines(lines, orientation, max_thickness, working_mask.shape)

def _same_separator_segment(
    first: LocalizedInterdieGap, second: LocalizedInterdieGap
) -> bool:
    if first.orientation != second.orientation:
        return False
    first_cross, first_long = axis_intervals(first.box, first.orientation)
    second_cross, second_long = axis_intervals(second.box, second.orientation)
    return (
        interval_overlap(first_cross, second_cross) is not None
        and interval_overlap(first_long, second_long) is not None
    )

def _interval_size(interval: tuple[int, int]) -> int:
    return max(1, interval[1] - interval[0])

def _cross_axis_collinear(
    first: tuple[int, int], second: tuple[int, int], tolerance: int
) -> bool:
    first_center = (first[0] + first[1]) / 2.0
    second_center = (second[0] + second[1]) / 2.0
    center_tolerance = max(tolerance, _interval_size(first), _interval_size(second))
    return abs(first_center - second_center) <= center_tolerance

def _connector_clear_fraction(
    mask: np.ndarray,
    first: LocalizedInterdieGap,
    second: LocalizedInterdieGap,
) -> float:
    first_cross, first_long = axis_intervals(first.box, first.orientation)
    second_cross, second_long = axis_intervals(second.box, second.orientation)
    if interval_distance(first_long, second_long) == 0:
        return 1.0

    if first_long[0] <= second_long[0]:
        long_start, long_stop = first_long[1], second_long[0]
    else:
        long_start, long_stop = second_long[1], first_long[0]
    if long_stop <= long_start:
        return 1.0

    cross_start = max(first_cross[0], second_cross[0])
    cross_stop = min(first_cross[1], second_cross[1])
    if cross_stop <= cross_start:
        center = int(
            round(
                ((first_cross[0] + first_cross[1]) + (second_cross[0] + second_cross[1]))
                / 4.0
            )
        )
        cross_start, cross_stop = center, center + 1

    connector = (
        mask[long_start:long_stop, cross_start:cross_stop]
        if first.orientation == "vertical"
        else mask[cross_start:cross_stop, long_start:long_stop]
    )
    if not connector.size:
        return 1.0
    return 1.0 - float(np.count_nonzero(connector)) / connector.size

def _merge_gap_pair(
    mask: np.ndarray,
    first: LocalizedInterdieGap,
    second: LocalizedInterdieGap,
    tolerance: int,
    total_width: int,
    total_height: int,
) -> LocalizedInterdieGap | None:
    if first.orientation != second.orientation:
        return None

    first_cross, first_long = axis_intervals(first.box, first.orientation)
    second_cross, second_long = axis_intervals(second.box, second.orientation)
    if not _cross_axis_collinear(first_cross, second_cross, tolerance):
        return None

    connector_limit = max(
        2 * tolerance,
        2 * max(_interval_size(first_cross), _interval_size(second_cross)),
    )
    if interval_distance(first_long, second_long) > connector_limit:
        return None
    connector_clear = _connector_clear_fraction(mask, first, second)
    if connector_clear < MIN_EDGE_COVERAGE:
        return None

    cross_start = min(first_cross[0], second_cross[0])
    cross_stop = max(first_cross[1], second_cross[1])
    long_start = min(first_long[0], second_long[0])
    long_stop = max(first_long[1], second_long[1])
    box = (
        (cross_start, long_start, cross_stop, long_stop)
        if first.orientation == "vertical"
        else (long_start, cross_start, long_stop, cross_stop)
    )

    x0, y0, x1, y1 = box
    corridor = mask[y0:y1, x0:x1]
    if not corridor.size:
        return None
    clear_fraction = 1.0 - float(np.count_nonzero(corridor)) / corridor.size
    if clear_fraction < MIN_EDGE_COVERAGE:
        return None

    state: GapState = "complete" if clear_fraction == 1.0 else "partial"
    long_extent = total_height if first.orientation == "vertical" else total_width
    support_fraction = min(1.0, (long_stop - long_start) / max(1, long_extent))
    return LocalizedInterdieGap(
        first.orientation,
        *box,
        state,
        clear_fraction,
        support_fraction,
    )

def _merge_collinear_gaps(
    mask: np.ndarray, gaps: list[LocalizedInterdieGap]
) -> list[LocalizedInterdieGap]:
    if len(gaps) < 2:
        return gaps
    tolerance = max(1, round(min(mask.shape) * RECT_ALIGN_TOL_RATIO))
    _, _, total_width, total_height = cv2.boundingRect(mask)
    result = list(gaps)
    changed = True
    while changed:
        changed = False
        for first_id in range(len(result)):
            for second_id in range(first_id + 1, len(result)):
                merged = _merge_gap_pair(
                    mask,
                    result[first_id],
                    result[second_id],
                    tolerance,
                    total_width,
                    total_height,
                )
                if merged is None:
                    continue
                result[first_id] = merged
                result.pop(second_id)
                changed = True
                break
            if changed:
                break
    return result

def _record_discovery_debug(
    localized: np.ndarray,
    scans: list[tuple[np.ndarray | None, np.ndarray | None, np.ndarray | None]],
) -> None:
    if not DEBUG.active:
        return
    candidate = np.zeros_like(localized)
    retained = np.zeros_like(localized)
    facing = np.zeros_like(localized)
    for scan_candidate, scan_retained, scan_facing in scans:
        if scan_candidate is not None:
            assert scan_retained is not None and scan_facing is not None
            candidate = cv2.bitwise_or(candidate, scan_candidate)
            retained = cv2.bitwise_or(retained, scan_retained)
            facing = cv2.bitwise_or(facing, scan_facing)
    rejected = cv2.bitwise_and(candidate, cv2.bitwise_not(retained))
    pane = "inter-die separator candidates"
    DEBUG.show(pane, localized, "Raw localization", GREEN, style="outline")
    DEBUG.show(pane, facing, "Opposed material support", BLUE, style="outline")
    DEBUG.show(pane, rejected, "Rejected separator candidate", RED, style="outline")
    DEBUG.show(pane, retained, "Retained separator candidate", CYAN)

def discover_localized_gaps(
    localized: np.ndarray, *, external_only: bool = True
) -> list[LocalizedInterdieGap]:
    if localized.ndim != 2:
        raise ValueError("localized mask must be 2-D")

    mask = _gap_analysis_mask(localized)
    if not np.any(mask):
        _record_discovery_debug(localized, [])
        return []

    complete = _complete_component_gaps(mask)
    clear_mask = _external_background(mask) if external_only else mask == 0
    scans = []
    partial: list[LocalizedInterdieGap] = []
    for orientation in ORIENTATIONS:
        axis_gaps, scan = _partial_axis_gaps(
            mask,
            clear_mask,
            orientation,
            require_external_connection=external_only,
        )
        scans.append(scan)
        partial.extend(
            gap
            for gap in axis_gaps
            if not any(_same_separator_segment(gap, full_gap) for full_gap in complete)
        )

    _record_discovery_debug(localized, scans)
    return _merge_collinear_gaps(mask, complete + partial)


# ---- gap_detection.facing_edges ----

def straight_gap_face_band(
    localized: np.ndarray,
    orientation: str,
    box: Box,
    depth: int,
) -> np.ndarray | None:
    """Return inward bands for sufficiently straight axis-aligned gap faces."""
    if orientation not in ORIENTATIONS:
        raise ValueError("gap orientation must be horizontal or vertical")
    if depth <= 0:
        raise ValueError("face-band depth must be positive")

    mask = localized > 0
    x0, y0, x1, y1 = box
    transpose = orientation == "vertical"
    if transpose:
        mask = mask.T
        x0, y0, x1, y1 = y0, x0, y1, x1

    height, width = mask.shape
    if (
        x0 < 0
        or y0 <= 0
        or x1 > width
        or y1 >= height
        or x1 <= x0
        or y1 <= y0
    ):
        return None

    before = mask[:y0, x0:x1]
    after = mask[y1:, x0:x1]
    paired = np.any(before, axis=0) & np.any(after, axis=0)
    span = x1 - x0
    if np.count_nonzero(paired) < span * MIN_EDGE_COVERAGE:
        return None

    columns = np.flatnonzero(paired)
    upper = y0 - 1 - np.argmax(before[::-1, columns], axis=0)
    lower = y1 + np.argmax(after[:, columns], axis=0)
    tolerance = max(1, round(min(localized.shape) * RECT_ALIGN_TOL_RATIO))
    upper_center = float(np.median(upper))
    lower_center = float(np.median(lower))
    aligned = (
        (np.abs(upper - upper_center) <= tolerance)
        & (np.abs(lower - lower_center) <= tolerance)
    )
    if np.count_nonzero(aligned) < span * MIN_EDGE_COVERAGE:
        return None

    band = np.zeros_like(mask, dtype=bool)
    for column, upper_edge, lower_edge in zip(
        columns[aligned], upper[aligned], lower[aligned], strict=True
    ):
        x = x0 + int(column)
        upper_edge = int(upper_edge)
        lower_edge = int(lower_edge)
        band[max(0, upper_edge - depth + 1) : upper_edge + 1, x] = True
        band[lower_edge : min(height, lower_edge + depth), x] = True

    band &= mask
    if transpose:
        band = band.T
    return np.where(band, 255, 0).astype(np.uint8)


# ---- gap_detection.matching ----

def _manual_axis(
    orientation: str, count: int, axis_length: int, first_id: int
) -> tuple[list[Node], list[Separator]]:
    thickness = max(0.01, 2.0 / axis_length)
    centers = [index / (count + 1) for index in range(1, count + 1)]
    starts = [0.0, *(center + thickness / 2 for center in centers)]
    ends = [*(center - thickness / 2 for center in centers), 1.0]
    ids = list(range(first_id, first_id + count + 1))
    if orientation == "horizontal":
        nodes = [Node(ids[i], 0.0, starts[i], 1.0, ends[i]) for i in range(count + 1)]
        gaps = [
            Separator(ids[i], ids[i + 1], orientation, 0.0, c - thickness / 2, 1.0, c + thickness / 2)
            for i, c in enumerate(centers)
        ]
    else:
        nodes = [Node(ids[i], starts[i], 0.0, ends[i], 1.0) for i in range(count + 1)]
        gaps = [
            Separator(ids[i], ids[i + 1], orientation, c - thickness / 2, 0.0, c + thickness / 2, 1.0)
            for i, c in enumerate(centers)
        ]
    return nodes, gaps

def resolve_manual_reference(
    reference: MultiDieReference, nominal: np.ndarray
) -> MultiDieReference | None:
    if not reference.gap_specs:
        return None
    component_count = cv2.connectedComponents((nominal > 0).astype(np.uint8), 8)[0] - 1
    if component_count == 0:
        return None
    expected = {spec.orientation: spec.count for spec in reference.gap_specs}
    if component_count > 1:
        try:
            nodes, gaps = infer_layout(nominal)
        except ValueError:
            return None
        detected = gap_line_counts(gaps)
        if any(
            detected[orientation] != expected.get(orientation, 0)
            for orientation in ORIENTATIONS
        ):
            return None
        return MultiDieReference(reference.product, tuple(nodes), tuple(gaps))

    _, _, width, height = cv2.boundingRect(nominal)
    nodes: list[Node] = []
    gaps: list[Separator] = []
    for spec in reference.gap_specs:
        axis_length = height if spec.orientation == "horizontal" else width
        axis_nodes, axis_gaps = _manual_axis(spec.orientation, spec.count, axis_length, len(nodes))
        nodes.extend(axis_nodes)
        gaps.extend(axis_gaps)
    return MultiDieReference(reference.product, tuple(nodes), tuple(gaps))

def _map_box(box: AxisGap, bounds: tuple[int, int, int, int], shape: tuple[int, int]) -> Box:
    x, y, width, height = bounds
    return (
        max(0, int(round(x + box.x0 * width))),
        max(0, int(round(y + box.y0 * height))),
        min(shape[1], int(round(x + box.x1 * width))),
        min(shape[0], int(round(y + box.y1 * height))),
    )

def _has_clear_gap_line(observed: np.ndarray, gap: Box, orientation: str) -> bool:
    x0, y0, x1, y1 = gap
    if orientation == "horizontal":
        thickness = max(1, y1 - y0)
        center = (y0 + y1) // 2
        return any(
            np.all(observed[y, x0:x1] == 0)
            for y in range(max(0, center - thickness), min(observed.shape[0], center + thickness + 1))
        )
    thickness = max(1, x1 - x0)
    center = (x0 + x1) // 2
    return any(
        np.all(observed[y0:y1, x] == 0)
        for x in range(max(0, center - thickness), min(observed.shape[1], center + thickness + 1))
    )

def _gap_corridor(observed: np.ndarray, gap: Box, orientation: str) -> np.ndarray:
    x0, y0, x1, y1 = gap
    corridor = np.zeros_like(observed)
    if orientation == "vertical":
        padding = max(1, (x1 - x0) // 2)
        left, right = max(0, x0 - padding), min(observed.shape[1], x1 + padding)
        corridor[y0:y1, left:right] = observed[y0:y1, left:right]
    else:
        padding = max(1, (y1 - y0) // 2)
        top, bottom = max(0, y0 - padding), min(observed.shape[0], y1 + padding)
        corridor[top:bottom, x0:x1] = observed[top:bottom, x0:x1]
    return corridor

def _facing_node_seed(
    nominal: np.ndarray, node: Box, gap: Box, orientation: str, first: bool
) -> np.ndarray:
    seed = np.zeros_like(nominal)
    x0, y0, x1, y1 = node
    seed[y0:y1, x0:x1] = nominal[y0:y1, x0:x1]
    gx0, gy0, gx1, gy1 = gap
    if orientation == "vertical":
        width = max(1, gx1 - gx0)
        if first:
            seed[:, : max(0, gx0 - width)] = 0
        else:
            seed[:, min(nominal.shape[1], gx1 + width) :] = 0
    else:
        height = max(1, gy1 - gy0)
        if first:
            seed[: max(0, gy0 - height), :] = 0
        else:
            seed[min(nominal.shape[0], gy1 + height) :, :] = 0
    return seed

def _shared_connection_labels(
    corridor: np.ndarray, seed_a: np.ndarray, seed_b: np.ndarray
) -> tuple[np.ndarray, set[int]]:
    joined = ((corridor > 0) | (seed_a > 0) | (seed_b > 0)).astype(np.uint8)
    _, labels = cv2.connectedComponents(joined, 8)
    labels_a = set(np.unique(labels[seed_a > 0])) - {0}
    labels_b = set(np.unique(labels[seed_b > 0])) - {0}
    return labels, labels_a & labels_b

def registered_gap_bridge_mask(
    nominal: np.ndarray, observed: np.ndarray, reference: MultiDieReference
) -> np.ndarray:
    """Return material that bridges the two nodes of a registered inter-die gap."""
    result = np.zeros_like(nominal)
    bounds = cv2.boundingRect(nominal)
    if bounds[2] == 0 or bounds[3] == 0:
        return result
    if not reference.nodes and not reference.separators:
        reference = resolve_manual_reference(reference, nominal)
        if reference is None:
            return result
    nodes = {node.id: node for node in reference.nodes}
    for gap_reference in reference.separators:
        gap = _map_box(gap_reference, bounds, nominal.shape)
        gx0, gy0, gx1, gy1 = gap
        if gx1 <= gx0 or gy1 <= gy0 or _has_clear_gap_line(observed, gap, gap_reference.orientation):
            continue
        node_a = _map_box(nodes[gap_reference.node_a], bounds, nominal.shape)
        node_b = _map_box(nodes[gap_reference.node_b], bounds, nominal.shape)
        corridor = _gap_corridor(observed, gap, gap_reference.orientation)
        seed_a = _facing_node_seed(nominal, node_a, gap, gap_reference.orientation, True)
        seed_b = _facing_node_seed(nominal, node_b, gap, gap_reference.orientation, False)
        labels, shared = _shared_connection_labels(corridor, seed_a, seed_b)
        if shared:
            region = result[gy0:gy1, gx0:gx1]
            region[np.isin(labels[gy0:gy1, gx0:gx1], list(shared))] = 255
    return result


# ---- reference.storage ----

def _read_json(path: Path) -> object:
    try:
        with path.open(encoding="utf-8") as file:
            return json.load(file)
    except json.JSONDecodeError as error:
        raise ValueError(f"invalid JSON in {path}: {error.msg}") from error

def _box(value: object, *, path: Path, field: str) -> tuple[float, float, float, float]:
    if not isinstance(value, list) or len(value) != 4:
        raise ValueError(f"{path}: {field} must be [x0, y0, x1, y1]")
    try:
        x0, y0, x1, y1 = (float(item) for item in value)
    except (TypeError, ValueError) as error:
        raise ValueError(f"{path}: {field} must contain numbers") from error
    if not (0.0 <= x0 < x1 <= 1.0 and 0.0 <= y0 < y1 <= 1.0):
        raise ValueError(
            f"{path}: {field} must satisfy " "0 <= x0 < x1 <= 1 and 0 <= y0 < y1 <= 1"
        )
    return x0, y0, x1, y1

def reference_to_data(reference: MultiDieReference) -> dict[str, object]:
    """Return the compact, human-editable JSON representation of one layout."""
    counts = reference_gap_counts(reference)
    return {
        "version": JSON_VERSION,
        "nodes": [
            {
                "id": node.id,
                "box": [
                    round(value, 6) for value in (node.x0, node.y0, node.x1, node.y1)
                ],
            }
            for node in reference.nodes
        ],
        "gaps": [
            {
                "nodes": [separator.node_a, separator.node_b],
                "orientation": separator.orientation,
                "box": [
                    round(value, 6)
                    for value in (
                        separator.x0,
                        separator.y0,
                        separator.x1,
                        separator.y1,
                    )
                ],
            }
            for separator in reference.separators
        ],
        "gap_counts": {
            orientation: counts.get(orientation, 0)
            for orientation in ORIENTATIONS
            if counts.get(orientation, 0) > 0
        },
    }

def reference_from_data(data: object, *, product: str, path: Path) -> MultiDieReference:
    """Parse and validate one layout JSON document."""
    if not isinstance(data, dict):
        raise ValueError(f"{path}: layout root must be a JSON object")
    if "version" in data and data.get("version") != JSON_VERSION:
        raise ValueError(f"{path}: unsupported layout version {data.get('version')!r}")

    raw_nodes = data.get("nodes", [])
    raw_gaps = data.get("gaps", [])
    raw_counts = data.get("gap_counts", {})
    if not isinstance(raw_nodes, list) or not isinstance(raw_gaps, list):
        raise ValueError(f"{path}: nodes and gaps must be JSON arrays")
    if not isinstance(raw_counts, dict):
        raise ValueError(f"{path}: gap_counts must be a JSON object")

    nodes: list[Node] = []
    node_ids: set[int] = set()
    for index, item in enumerate(raw_nodes):
        if not isinstance(item, dict):
            raise ValueError(f"{path}: nodes[{index}] must be a JSON object")
        node_id = item.get("id")
        if not isinstance(node_id, int) or isinstance(node_id, bool) or node_id < 0:
            raise ValueError(
                f"{path}: nodes[{index}].id must be a non-negative integer"
            )
        if node_id in node_ids:
            raise ValueError(f"{path}: duplicate node id {node_id}")
        node_ids.add(node_id)
        nodes.append(
            Node(
                node_id,
                *_box(item.get("box"), path=path, field=f"nodes[{index}].box"),
            )
        )

    separators: list[Separator] = []
    for index, item in enumerate(raw_gaps):
        if not isinstance(item, dict):
            raise ValueError(f"{path}: gaps[{index}] must be a JSON object")
        pair = item.get("nodes")
        if (
            not isinstance(pair, list)
            or len(pair) != 2
            or any(
                not isinstance(node_id, int) or isinstance(node_id, bool)
                for node_id in pair
            )
        ):
            raise ValueError(f"{path}: gaps[{index}].nodes must contain two node ids")
        node_a, node_b = pair
        if node_a == node_b or node_a not in node_ids or node_b not in node_ids:
            raise ValueError(f"{path}: gaps[{index}] references invalid nodes {pair}")
        orientation = item.get("orientation")
        if orientation not in ORIENTATIONS:
            raise ValueError(
                f"{path}: gaps[{index}].orientation must be horizontal or vertical"
            )
        separators.append(
            Separator(
                node_a,
                node_b,
                orientation,
                *_box(item.get("box"), path=path, field=f"gaps[{index}].box"),
            )
        )

    counts: dict[str, int] = {}
    for orientation, count in raw_counts.items():
        if orientation not in ORIENTATIONS:
            raise ValueError(f"{path}: invalid gap_counts orientation {orientation!r}")
        if not isinstance(count, int) or isinstance(count, bool) or count <= 0:
            raise ValueError(
                f"{path}: gap_counts.{orientation} must be a positive integer"
            )
        counts[orientation] = count

    if not nodes and not separators and not counts:
        raise ValueError(f"{path}: layout must contain geometry or gap_counts")
    if bool(nodes) != bool(separators):
        raise ValueError(f"{path}: geometric layouts require both nodes and gaps")

    if nodes:
        geometry = MultiDieReference(product, tuple(nodes), tuple(separators))
        detected = reference_gap_counts(geometry)
        if counts and any(
            counts.get(orientation, 0) != detected.get(orientation, 0)
            for orientation in ORIENTATIONS
        ):
            raise ValueError(f"{path}: gap_counts do not match gap geometry")
        if not counts:
            counts = detected

    specs = tuple(
        GapSpec(orientation, counts[orientation])
        for orientation in ORIENTATIONS
        if counts.get(orientation, 0) > 0
    )
    return MultiDieReference(product, tuple(nodes), tuple(separators), specs)

def _parse_product_groups(data: object, path: Path) -> dict[str, tuple[str, ...]]:
    if not isinstance(data, dict) or data.get("version") != JSON_VERSION:
        raise ValueError(
            f"{path}: unsupported or missing catalog version; "
            f"expected {JSON_VERSION}"
        )
    products = data.get("products")
    if not isinstance(products, dict):
        raise ValueError(f"{path}: products must be a JSON object")

    groups: dict[str, tuple[str, ...]] = {}
    layout_keys: set[str] = set()
    product_keys: set[str] = set()
    for layout, members in products.items():
        if not isinstance(layout, str) or not layout.strip():
            raise ValueError(
                f"{path}: selected product names must be non-empty strings"
            )
        layout_key = layout.casefold()
        if layout_key in layout_keys:
            raise ValueError(
                f"{path}: duplicate selected product name ignoring case: {layout}"
            )
        layout_keys.add(layout_key)
        if not isinstance(members, list) or not members:
            raise ValueError(
                f"{path}: products. {layout} must be a non-empty JSON array"
            )

        parsed: list[str] = []
        for product in members:
            if not isinstance(product, str) or not product.strip():
                raise ValueError(f"{path}: product names must be non-empty strings")
            key = product.casefold()
            if key in product_keys:
                raise ValueError(
                    f"{path}: duplicate product name ignoring case: {product}"
                )
            product_keys.add(key)
            parsed.append(product)
        groups[layout] = tuple(parsed)
    return groups

def _parse_layouts(data: object, path: Path) -> dict[str, object]:
    if not isinstance(data, dict):
        raise ValueError(f"{path}: layouts must be a JSON object")

    layouts: dict[str, object] = {}
    keys: set[str] = set()
    for layout, reference in data.items():
        if not isinstance(layout, str) or not layout.strip():
            raise ValueError(f"{path}: layout names must be non-empty strings")
        key = layout.casefold()
        if key in keys:
            raise ValueError(f"{path}: duplicate layout name ignoring case: {layout}")
        if not isinstance(reference, dict):
            raise ValueError(f"{path}: layouts.{layout} must be a JSON object")
        keys.add(key)
        layouts[layout] = reference
    return layouts

def _load_catalog(
    root: Path,
) -> tuple[dict[str, tuple[str, ...]], dict[str, object], bool]:
    path = root / PRODUCTS_FILE
    if not path.is_file():
        return {}, {}, False
    data = _read_json(path)
    groups = _parse_product_groups(data, path)
    if not isinstance(data, dict) or "layouts" not in data:
        return groups, {}, False
    return groups, _parse_layouts(data["layouts"], path), True

def _load_product_groups(root: Path) -> dict[str, tuple[str, ...]]:
    groups, _, _ = _load_catalog(root)
    return groups

def load_product_groups(root: Path) -> dict[str, tuple[str, ...]]:
    """Load layout/canonical-product -> bound product names from the catalog."""
    return _load_product_groups(root)

def load_product_bindings(root: Path) -> dict[str, tuple[str, str]]:
    """Load product -> selected layout bindings keyed case-insensitively."""
    return _product_bindings(load_product_groups(root))

def _product_bindings(
    groups: Mapping[str, Iterable[str]],
) -> dict[str, tuple[str, str]]:
    bindings: dict[str, tuple[str, str]] = {}
    for layout, products in groups.items():
        for product in products:
            bindings[product.casefold()] = (product, layout)
    return bindings

def _legacy_layout_paths(root: Path) -> dict[str, Path]:
    directory = root / LEGACY_LAYOUTS_DIR
    if not directory.is_dir():
        return {}
    paths: dict[str, Path] = {}
    for path in directory.iterdir():
        if not path.is_file() or path.suffix.casefold() != ".json":
            continue
        key = path.stem.casefold()
        if key in paths:
            raise ValueError(f"duplicate layout name ignoring case: {path.stem}")
        paths[key] = path
    return paths

def _reference_image_paths(root: Path) -> dict[str, Path]:
    directory = root / REFERENCE_IMAGES_DIR
    if not directory.is_dir():
        return {}
    paths: dict[str, Path] = {}
    for path in directory.iterdir():
        if not path.is_file():
            continue
        key = path.stem.casefold()
        if key in paths:
            raise ValueError(
                f"duplicate reference image name ignoring case: {path.stem}"
            )
        paths[key] = path
    return paths

def reference_image_path(layout_name: str, root: Path) -> Path | None:
    """Return the saved source image associated with one layout, if available."""
    return _reference_image_paths(root).get(layout_name.casefold())

def _reconciled_product_groups(
    groups: dict[str, tuple[str, ...]], layouts: dict[str, object]
) -> tuple[dict[str, list[str]], dict[str, str]]:
    actual = {name.casefold(): name for name in layouts}
    reconciled: dict[str, list[str]] = {}
    represented: set[str] = set()
    promotions: dict[str, str] = {}

    for category, members in groups.items():
        category_key = category.casefold()
        if category_key in actual:
            primary = actual[category_key]
            updated = [
                primary if product.casefold() == category_key else product
                for product in members
            ]
            if all(product.casefold() != category_key for product in members):
                updated.insert(0, primary)
        else:
            replacement = next(
                (product for product in members if product.casefold() in actual),
                None,
            )
            if replacement is None:
                continue
            replacement_key = replacement.casefold()
            primary = actual[replacement_key]
            promotions[category] = primary
            updated = [
                primary if product.casefold() == replacement_key else product
                for product in members
                if product.casefold() != category_key
            ]

        reconciled[primary] = updated
        represented.add(primary.casefold())
        represented.update(
            product.casefold() for product in updated if product.casefold() in actual
        )

    for key, name in sorted(actual.items()):
        if key not in represented:
            reconciled[name] = [name]

    return reconciled, promotions

def _synchronize_reference_images(
    root: Path, layouts: dict[str, object], promotions: dict[str, str]
) -> bool:
    changed = False
    images = _reference_image_paths(root)
    for old_layout, new_layout in promotions.items():
        old = images.get(old_layout.casefold())
        if old is None or new_layout.casefold() in images:
            continue
        destination = old.with_name(f"{new_layout}{old.suffix}")
        destination.parent.mkdir(parents=True, exist_ok=True)
        old.replace(destination)
        images.pop(old_layout.casefold(), None)
        images[new_layout.casefold()] = destination
        changed = True

    valid = {name.casefold() for name in layouts}
    for key, path in list(images.items()):
        if key not in valid:
            path.unlink(missing_ok=True)
            changed = True
    return changed

def synchronize_product_catalog(root: Path, *, force: bool = False) -> bool:
    """Reconcile the catalog, migrating legacy layout files when present."""
    groups, layouts, consolidated = _load_catalog(root)
    legacy_paths = _legacy_layout_paths(root)
    catalog_exists = (root / PRODUCTS_FILE).is_file()
    if not consolidated:
        legacy_layouts = {path.stem: _read_json(path) for path in legacy_paths.values()}
        layouts = _parse_layouts(legacy_layouts, root / PRODUCTS_FILE)
    elif legacy_paths:
        embedded = {name.casefold(): data for name, data in layouts.items()}
        for path in legacy_paths.values():
            legacy = _read_json(path)
            if not isinstance(legacy, dict):
                raise ValueError(f"{path}: layout root must be a JSON object")
            legacy.pop("version", None)
            if embedded.get(path.stem.casefold()) != legacy:
                raise ValueError(
                    f"{path}: legacy layout is missing from or differs from "
                    f"{root / PRODUCTS_FILE}"
                )
    reconciled, promotions = _reconciled_product_groups(groups, layouts)
    current = {layout: list(products) for layout, products in groups.items()}
    changed = reconciled != current
    migration_needed = bool(legacy_paths) or (catalog_exists and not consolidated)
    if changed or migration_needed or (force and not catalog_exists):
        _write_catalog(root, reconciled, layouts)
        changed = True
    if consolidated or (root / PRODUCTS_FILE).is_file():
        for path in legacy_paths.values():
            path.unlink(missing_ok=True)
            changed = True
        legacy_directory = root / LEGACY_LAYOUTS_DIR
        if legacy_directory.is_dir() and not any(legacy_directory.iterdir()):
            legacy_directory.rmdir()
    return _synchronize_reference_images(root, layouts, promotions) or changed

def load_layout(layout_name: str, root: Path) -> MultiDieReference | None:
    """Load one embedded layout by id without parsing unrelated layouts."""
    _, layouts, _ = _load_catalog(root)
    selected = next(
        (
            (name, data)
            for name, data in layouts.items()
            if name.casefold() == layout_name.casefold()
        ),
        None,
    )
    if selected is None:
        return None
    name, data = selected
    return reference_from_data(data, product=name, path=root / PRODUCTS_FILE)

def load_bound_layouts(
    root: Path, layout_names: Iterable[str] | None = None
) -> dict[str, MultiDieReference]:
    """Load each layout referenced by the product catalog exactly once."""
    groups, stored, _ = _load_catalog(root)
    indexed = {name.casefold(): (name, data) for name, data in stored.items()}
    layouts: dict[str, MultiDieReference] = {}
    for layout_name in (groups if layout_names is None else layout_names):
        key = layout_name.casefold()
        selected = indexed.get(key)
        if selected is None:
            raise ValueError(f"{root / PRODUCTS_FILE}: unknown layout {layout_name!r}")
        name, data = selected
        layouts[key] = reference_from_data(
            data, product=name, path=root / PRODUCTS_FILE
        )
    return layouts

def load_reference(product: str, root: Path) -> MultiDieReference | None:
    """Load only the layout bound to one product."""
    synchronize_product_catalog(root)
    groups, layouts, _ = _load_catalog(root)
    binding = _product_bindings(groups).get(product.casefold())
    if binding is None:
        return None
    canonical_product, layout_name = binding
    selected = next(
        (
            (name, data)
            for name, data in layouts.items()
            if name.casefold() == layout_name.casefold()
        ),
        None,
    )
    if selected is None:
        raise ValueError(f"{root / PRODUCTS_FILE}: unknown layout {layout_name!r}")
    name, data = selected
    layout = reference_from_data(data, product=name, path=root / PRODUCTS_FILE)
    return replace(layout, product=canonical_product)

def load_references(
    root: Path, *, excluded_products: Collection[str] = ()
) -> dict[str, MultiDieReference]:
    """Load registered references except for excluded product keys."""
    synchronize_product_catalog(root)
    path = root / PRODUCTS_FILE
    if not root.is_dir() or not path.is_file():
        return {}

    return load_references_from_config(path, excluded_products=excluded_products)

def load_references_from_config(
    path: Path, *, excluded_products: Collection[str] = ()
) -> dict[str, MultiDieReference]:
    """Load registered references directly from one consolidated config file."""
    data = _read_json(path)
    groups = _parse_product_groups(data, path)
    if not isinstance(data, dict) or "layouts" not in data:
        raise ValueError(f"{path}: layouts must be a JSON object")
    stored = _parse_layouts(data["layouts"], path)

    excluded = {product.casefold() for product in excluded_products}
    bindings = {
        key: binding
        for key, binding in _product_bindings(groups).items()
        if key not in excluded
    }
    indexed = {name.casefold(): (name, layout) for name, layout in stored.items()}
    layouts: dict[str, MultiDieReference] = {}
    for layout_name in {name for _, name in bindings.values()}:
        key = layout_name.casefold()
        selected = indexed.get(key)
        if selected is None:
            raise ValueError(f"{path}: unknown layout {layout_name!r}")
        name, layout = selected
        layouts[key] = reference_from_data(layout, product=name, path=path)

    references: dict[str, MultiDieReference] = {}
    ordered = sorted(bindings.items(), key=lambda item: item[1][0].casefold())
    for key, (product, layout_name) in ordered:
        layout = layouts[layout_name.casefold()]
        references[key] = replace(layout, product=product)
    return references

_INVALID_FILENAME = re.compile(r'[<>:"/\\|?*\x00-\x1f]')

def _write_json(path: Path, data: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.tmp")
    with temporary.open("w", encoding="utf-8", newline="\n") as file:
        json.dump(data, file, indent=2, ensure_ascii=False)
        file.write("\n")
    temporary.replace(path)

def _catalog(root: Path) -> tuple[dict[str, list[str]], dict[str, object]]:
    groups, layouts, _ = _load_catalog(root)
    return {layout: list(products) for layout, products in groups.items()}, layouts

def _write_catalog(
    root: Path, groups: dict[str, list[str]], layouts: dict[str, object]
) -> Path:
    path = root / PRODUCTS_FILE
    ordered = {
        layout: sorted(
            products,
            key=lambda product: (
                product.casefold() != layout.casefold(),
                product.casefold(),
            ),
        )
        for layout, products in sorted(
            groups.items(), key=lambda item: item[0].casefold()
        )
        if products
    }
    ordered_layouts = {
        layout: {key: value for key, value in reference.items() if key != "version"}
        for layout, reference in sorted(
            layouts.items(), key=lambda item: item[0].casefold()
        )
    }
    _write_json(
        path,
        {"version": JSON_VERSION, "products": ordered, "layouts": ordered_layouts},
    )
    return path

def _safe_layout_name(product: str) -> str:
    name = _INVALID_FILENAME.sub("_", product).strip(" .")
    return name or "layout"

def _unique_layout_name(layouts: dict[str, object], product: str) -> str:
    base = _safe_layout_name(product)
    name = base
    index = 2
    existing = {layout.casefold() for layout in layouts}
    while name.casefold() in existing:
        name = f"{base}-{index}"
        index += 1
    return name

def _store_reference_image(
    source: Path, layout_name: str, root: Path, *, replace_existing: bool
) -> Path:
    if not source.is_file():
        raise FileNotFoundError(source)
    directory = root / REFERENCE_IMAGES_DIR
    directory.mkdir(parents=True, exist_ok=True)
    existing = reference_image_path(layout_name, root)
    if existing is not None and not replace_existing:
        return existing

    destination = directory / f"{layout_name}{source.suffix.lower()}"
    if existing is not None and existing != destination:
        existing.unlink(missing_ok=True)
    if source.resolve() != destination.resolve():
        shutil.copy2(source, destination)
    return destination

def _active_layouts(root: Path) -> dict[str, MultiDieReference]:
    return load_bound_layouts(root)

def _group_key(groups: dict[str, list[str]], layout: str) -> str | None:
    key = layout.casefold()
    return next((name for name in groups if name.casefold() == key), None)

def bind_products(products: list[str], layout: str, root: Path) -> Path:
    if not products:
        raise ValueError("at least one product name is required")

    groups, layouts = _catalog(root)
    target_name = next(
        (name for name in layouts if name.casefold() == layout.casefold()), None
    )
    if target_name is None:
        raise ValueError(f"unknown layout: {layout}")
    bindings = _product_bindings(groups)
    target_group = _group_key(groups, target_name) or target_name
    groups.setdefault(target_group, [])

    seen: set[str] = set()
    for product in products:
        if not product.strip():
            raise ValueError("product name cannot be empty")
        key = product.casefold()
        if key in seen:
            continue
        seen.add(key)
        existing = bindings.get(key)
        canonical_product = existing[0] if existing is not None else product

        for group_products in groups.values():
            group_products[:] = [
                item for item in group_products if item.casefold() != key
            ]
        groups[target_group].append(canonical_product)

    return _write_catalog(root, groups, layouts)

def bind_product(product: str, layout: str, root: Path) -> Path:
    """Bind one product to an existing layout without duplicating geometry."""
    return bind_products([product], layout, root)

def delete_products(products: list[str], root: Path) -> tuple[str, ...]:
    """Delete product bindings and layouts no longer used by any product."""
    if not products:
        raise ValueError("at least one product name is required")
    if "*" in products and products != ["*"]:
        raise ValueError("'*' cannot be combined with product names")

    groups, layouts = _catalog(root)
    bindings = _product_bindings(groups)
    if products == ["*"]:
        selected = list(bindings.values())
    else:
        selected = []
        missing: list[str] = []
        seen: set[str] = set()
        for product in products:
            key = product.casefold()
            if key in seen:
                continue
            seen.add(key)
            binding = bindings.get(key)
            if binding is None:
                missing.append(product)
            else:
                selected.append(binding)
        if missing:
            raise ValueError(f"unknown product(s): {', '.join(missing)}")

    removed_layouts: list[str] = []
    for product, layout_name in selected:
        group = _group_key(groups, layout_name)
        if group is None:
            continue
        groups[group] = [
            item for item in groups[group] if item.casefold() != product.casefold()
        ]
        if product.casefold() == group.casefold() or not groups[group]:
            removed_layouts.append(group)
        if not groups[group]:
            groups.pop(group)

    for layout_name in removed_layouts:
        stored_name = next(
            (name for name in layouts if name.casefold() == layout_name.casefold()),
            None,
        )
        if stored_name is not None:
            layouts.pop(stored_name)

    reconciled, promotions = _reconciled_product_groups(
        {layout: tuple(members) for layout, members in groups.items()}, layouts
    )
    _write_catalog(root, reconciled, layouts)
    _synchronize_reference_images(root, layouts, promotions)

    return tuple(product for product, _ in selected)

def rename_product(old_product: str, new_product: str, root: Path) -> Path:
    """Rename one bound product and its layout/image when it owns the category."""
    new_product = new_product.strip()
    if not new_product:
        raise ValueError("product name cannot be empty")

    groups, layouts = _catalog(root)
    bindings = _product_bindings(groups)
    old = bindings.get(old_product.casefold())
    if old is None:
        raise ValueError(f"unknown product: {old_product}")
    collision = bindings.get(new_product.casefold())
    if collision is not None and collision[0].casefold() != old[0].casefold():
        raise ValueError(f"product already exists: {new_product}")

    canonical, layout_name = old
    group = _group_key(groups, layout_name)
    if group is None:
        raise ValueError(f"unknown layout: {layout_name}")
    members = [
        new_product if product.casefold() == canonical.casefold() else product
        for product in groups[group]
    ]

    target_layout = group
    stored_layout = next(
        (name for name in layouts if name.casefold() == group.casefold()), None
    )
    if canonical.casefold() == group.casefold() and stored_layout is not None:
        target_layout = _safe_layout_name(new_product)
        other_layout = load_layout(target_layout, root)
        if other_layout is not None and target_layout.casefold() != group.casefold():
            raise ValueError(f"layout already exists: {target_layout}")

        image = reference_image_path(group, root)
        if stored_layout != target_layout:
            layouts[target_layout] = layouts.pop(stored_layout)
        if image is not None:
            image_target = image.with_name(f"{target_layout}{image.suffix}")
            if image != image_target:
                image.replace(image_target)
        groups.pop(group)
        groups[target_layout] = members
    else:
        groups[group] = members

    return _write_catalog(root, groups, layouts)

def _matching_layout(reference: MultiDieReference, root: Path) -> str | None:
    matches = matching_layouts(reference, _active_layouts(root))
    if len(matches) > 1:
        raise ValueError(
            "ambiguous layout match for "
            f"{reference.product}: {', '.join(matches)}; choose a layout explicitly"
        )
    return matches[0] if matches else None

def preview_reference(reference: MultiDieReference, root: Path) -> MultiDieReference:
    """Return the geometry that save_reference would bind, without writing files."""
    match = _matching_layout(reference, root)
    if match is None:
        return reference
    layout = load_layout(match, root)
    if layout is None:
        raise ValueError(f"unknown matched layout: {match}")
    return replace(layout, product=reference.product)

def save_reference(
    reference: MultiDieReference,
    root: Path,
    source_image: Path | None = None,
) -> Path:
    """Persist one registration and its source image when image-driven."""
    root.mkdir(parents=True, exist_ok=True)
    groups, layouts = _catalog(root)
    bindings = _product_bindings(groups)
    match = _matching_layout(reference, root)
    if match is not None:
        path = bind_product(reference.product, match, root)
        if source_image is not None:
            _store_reference_image(source_image, match, root, replace_existing=False)
        return path

    existing = bindings.get(reference.product.casefold())
    if existing is not None:
        current_layout = existing[1]
        users = sum(
            1
            for _, layout_name in bindings.values()
            if layout_name.casefold() == current_layout.casefold()
        )
        layout_name = (
            current_layout
            if users == 1
            else _unique_layout_name(layouts, reference.product)
        )
    else:
        layout_name = _unique_layout_name(layouts, reference.product)

    layouts[layout_name] = reference_to_data(reference)
    existing_product = bindings.get(reference.product.casefold())
    canonical_product = existing_product[0] if existing_product else reference.product
    for members in groups.values():
        members[:] = [
            product
            for product in members
            if product.casefold() != reference.product.casefold()
        ]
    groups.setdefault(layout_name, []).append(canonical_product)
    path = _write_catalog(root, groups, layouts)
    if source_image is not None:
        _store_reference_image(source_image, layout_name, root, replace_existing=True)
    return path


# ---- debug.rendering ----

def _outline(mask: np.ndarray) -> np.ndarray:
    """Draw outer edges and holes, including visible image-frame contacts."""
    binary = (mask > 0).astype(np.uint8)
    interior = cv2.erode(
        binary,
        np.ones((3, 3), np.uint8),
        borderType=cv2.BORDER_CONSTANT,
        borderValue=0,
    )
    return np.where((binary > 0) & (interior == 0), 255, 0).astype(np.uint8)

def _dotted_outline(mask: np.ndarray) -> np.ndarray:
    """Return a sparse one-pixel dotted outline for audit geometry."""
    outline = _outline(mask)
    y, x = np.indices(mask.shape)
    return np.where((outline > 0) & ((x + y) % 4 == 0), 255, 0).astype(np.uint8)

def render_overlays(
    image: np.ndarray,
    overlays: Iterable[DebugOverlay],
    alpha: float = OVERLAY_ALPHA,
) -> np.ndarray:
    """Blend semantic colored masks over an image without darkening same-color overlap."""
    if image.ndim == 2:
        canvas = cv2.cvtColor(image, cv2.COLOR_GRAY2BGR)
    elif image.ndim == 3 and image.shape[2] == 3:
        canvas = image.copy()
    else:
        raise ValueError("debug image must be grayscale or BGR")

    if not 0.0 <= alpha <= 1.0:
        raise ValueError("overlay alpha must be between 0 and 1")

    grouped: OrderedDict[tuple[tuple[int, int, int], float], np.ndarray] = OrderedDict()
    for item in overlays:
        mask, color, style, item_alpha = (
            item.mask,
            item.color,
            item.style,
            item.alpha,
        )
        if mask.shape != image.shape[:2]:
            raise ValueError("overlay mask must match image dimensions")
        blend_alpha = alpha if item_alpha is None else item_alpha
        if not 0.0 <= blend_alpha <= 1.0:
            raise ValueError("overlay alpha must be between 0 and 1")
        if style == "outline":
            visible = _outline(mask)
        elif style == "dotted":
            visible = _dotted_outline(mask)
        else:
            visible = mask
        key = (color, blend_alpha)
        if key not in grouped:
            grouped[key] = np.zeros_like(visible)
        grouped[key][visible > 0] = 255

    for (color, blend_alpha), mask in grouped.items():
        selected = mask > 0
        if not np.any(selected):
            continue
        pixels = canvas[selected].astype(np.float32)
        canvas[selected] = np.rint(
            pixels * (1.0 - blend_alpha) + np.asarray(color, np.float32) * blend_alpha
        ).astype(np.uint8)
    return canvas

def _gap_details(row: Measurement) -> str:
    counts = (
        ("H", row.interdie_horizontal_gap_count),
        ("V", row.interdie_vertical_gap_count),
    )
    return ", ".join(f"{count} ({axis})" for axis, count in counts if count) or "0"

def _gap_clear(row: Measurement) -> str:
    if not row.has_product_reference:
        return "nil"
    return str(not has_interdie_overflow(row)).lower()

def _detected_gap_mask(row: Measurement) -> np.ndarray:
    complete, partial = localized_gap_masks(row.gray.shape, row.interdie_gaps)
    detected = cv2.bitwise_or(complete, partial)
    if row.detected_registered_gap_mask is not None:
        detected = cv2.bitwise_or(detected, row.detected_registered_gap_mask)
    return detected

def _evaluated_gap_mask(row: Measurement) -> np.ndarray:
    return (
        row.evaluated_interdie_gap_mask
        if row.evaluated_interdie_gap_mask is not None
        else np.zeros_like(row.gray)
    )

def _bridge_mask(row: Measurement) -> np.ndarray:
    return interdie_overflow_mask(row)

def _dark_mask(row: Measurement) -> np.ndarray:
    mask = row.dark_boundary_mask
    return mask if isinstance(mask, np.ndarray) else np.zeros_like(row.gray)

def _gap_masks(row: Measurement) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    """Return evaluated corridors, overflow evidence, and detected gap geometry."""
    return _evaluated_gap_mask(row), _bridge_mask(row), _detected_gap_mask(row)

def final_overlays(row: Measurement) -> tuple[DebugOverlay, ...]:
    """Return the common final inspection evidence shown by both debug modes."""
    material = row.boundary_source
    return (
        DebugOverlay(material, GREEN, "Observed material", "outline"),
        DebugOverlay(
            _detected_gap_mask(row),
            BLUE,
            "Detected inter-die gap",
            alpha=DETECTED_GAP_ALPHA,
        ),
        DebugOverlay(
            _evaluated_gap_mask(row),
            RED,
            "Evaluated gap corridor",
            "dotted",
        ),
        DebugOverlay(_bridge_mask(row), RED, "Inter-die overflow"),
        DebugOverlay(_dark_mask(row), RED, "Dark boundary evidence"),
    )

def record_final(row: Measurement) -> None:
    """Record the final inspection evidence through the active debug capture."""
    for item in final_overlays(row):
        DEBUG.show(
            "final inspection",
            item.mask,
            item.label,
            item.color,
            style=item.style,
            alpha=item.alpha,
            final=True,
        )

def _put_label(
    canvas: np.ndarray,
    text: str,
    origin: tuple[int, int],
    color: tuple[int, int, int],
    *,
    scale: float = 0.38,
) -> None:
    """Draw a compact readable annotation with a dark backing box."""
    x, y = origin
    (width, height), baseline = cv2.getTextSize(
        text, cv2.FONT_HERSHEY_SIMPLEX, scale, 1
    )
    x = max(2, min(x, canvas.shape[1] - width - 3))
    y = max(height + 3, min(y, canvas.shape[0] - baseline - 3))
    cv2.rectangle(
        canvas,
        (x - 2, y - height - 2),
        (x + width + 2, y + baseline + 2),
        (20, 20, 20),
        -1,
    )
    cv2.putText(
        canvas,
        text,
        (x, y),
        cv2.FONT_HERSHEY_SIMPLEX,
        scale,
        color,
        1,
        cv2.LINE_AA,
    )

def _annotate_interdie(canvas: np.ndarray, row: Measurement) -> None:
    bridge = (
        row.interdie_material_mask
        if row.interdie_material_mask is not None
        else np.zeros_like(row.gray)
    )
    for gap in row.interdie_gaps:
        x0, y0, x1, y1 = gap.box
        bridge_px = int(np.count_nonzero(bridge[y0:y1, x0:x1]))
        text = (
            f"{gap.orientation[0].upper()} {gap.state} "
            f"C{gap.clear_fraction:.0%} F{gap.support_fraction:.0%} B{bridge_px}"
        )
        _put_label(canvas, text, (x0 + 2, max(14, y0 - 3)), BLUE)

    if row.expected_interdie_gap_missing:
        missing = (
            f"EXPECTED GAP MISSING: H={row.missing_interdie_horizontal_gap_count} "
            f"V={row.missing_interdie_vertical_gap_count}"
        )
        _put_label(canvas, missing, (4, 16), RED, scale=0.42)

def _fit_text_scale(text: str, width: int, preferred: float = 0.48) -> float:
    measured = cv2.getTextSize(text, cv2.FONT_HERSHEY_SIMPLEX, preferred, 1)[0][0]
    if measured <= width:
        return preferred
    return preferred * max(1, width - 2) / max(1, measured)

def _draw_footer(
    debug: np.ndarray,
    row: Measurement,
    predicted: int,
    score: float,
) -> None:
    image_height = row.gray.shape[0]
    if row.analysis_failed:
        # Remain visible even when a very narrow crop forces tiny footer text.
        cv2.line(
            debug, (2, image_height + 2), (debug.shape[1] - 3, image_height + 2), RED, 2
        )
    dark = row.dark_boundary_mask is not None and np.any(row.dark_boundary_mask)
    _, depth_px = dark_boundary_protrusion_metrics(row, area_px=score)
    status = " | Analysis: failed" if row.analysis_failed else ""
    text = (
        f"Pred: {label_name(predicted)} | Area: {score:.2f}px | Depth: {depth_px:.2f}px | "
        f"Dark: {dark} | Gaps: {_gap_details(row)} | Gap clear: {_gap_clear(row)}{status}"
    )
    scale = _fit_text_scale(text, debug.shape[1] - 12)
    cv2.putText(
        debug,
        text,
        (6, image_height + 18),
        cv2.FONT_HERSHEY_SIMPLEX,
        scale,
        (0, 0, 255) if row.analysis_failed else (235, 235, 235),
        2 if row.analysis_failed else 1,
        cv2.LINE_AA,
    )

    entries = (
        (GREEN, "observed material", "outline"),
        (BLUE, "detected gap", "25% fill"),
        (RED, "evaluated registered gap", "dotted"),
        (RED, "inter-die / dark overflow", "fill"),
    )
    x = 8
    y = image_height + 40
    for color, label, style in entries:
        if style == "dotted":
            for offset in range(0, 13, 4):
                cv2.circle(debug, (x + offset, y - 8), 1, color, -1)
                cv2.circle(debug, (x + offset, y + 4), 1, color, -1)
                cv2.circle(debug, (x, y - 8 + offset), 1, color, -1)
                cv2.circle(debug, (x + 12, y - 8 + offset), 1, color, -1)
        else:
            thickness = 2 if style == "outline" else -1
            cv2.rectangle(debug, (x, y - 8), (x + 12, y + 4), color, thickness)
        display = f"{label} ({style})" if style != "fill" else label
        cv2.putText(
            debug,
            display,
            (x + 17, y + 3),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.34,
            (225, 225, 225),
            1,
            cv2.LINE_AA,
        )
        text_width = cv2.getTextSize(display, cv2.FONT_HERSHEY_SIMPLEX, 0.34, 1)[0][0]
        x += 17 + text_width + 14

def draw_debug(row: Measurement, predicted: int, score: float, output: Path) -> None:
    """Render detected and evaluated inter-die geometry used by inspection."""
    source = row.source_gray if row.source_gray is not None else row.gray
    original = cv2.cvtColor(source, cv2.COLOR_GRAY2BGR)
    canvas = render_overlays(
        row.gray,
        final_overlays(row),
    )
    _annotate_interdie(canvas, row)

    pair = cv2.hconcat([original, canvas])
    debug = cv2.copyMakeBorder(
        pair,
        2,
        FOOTER_HEIGHT,
        2,
        2,
        cv2.BORDER_CONSTANT,
        value=(20, 20, 20),
    )
    _draw_footer(debug, row, predicted, score)

    output.parent.mkdir(parents=True, exist_ok=True)
    _save_debug(debug, output)

def _save_debug(debug: np.ndarray, output: Path) -> None:
    """Persist one completed debug image from the background writer."""
    if not cv2.imwrite(str(output), debug):
        raise ValueError(f"cannot write debug image: {output}")

def _write_debug_bundle(
    row: Measurement,
    predicted: int,
    score: float,
    output: Path | None,
    raw_output: Path | None,
) -> None:
    if output is not None:
        draw_debug(row, predicted, score, output)
    if raw_output is not None:
        raw_output.parent.mkdir(parents=True, exist_ok=True)
        copy2(row.sample.path, raw_output)

class DebugWriter:
    """Bounded background writer so network debug I/O cannot stall inference."""

    def __init__(self, enabled: bool) -> None:
        self._executor = (
            ThreadPoolExecutor(max_workers=DEBUG_WRITE_THREADS) if enabled else None
        )
        self._slots = BoundedSemaphore(DEBUG_WRITE_QUEUE_SIZE)
        self._jobs: dict[Future[None], tuple[int, Sample]] = {}
        self.errors: list[tuple[int, Sample, Exception]] = []

    def __enter__(self) -> "DebugWriter":
        return self

    def submit(
        self,
        index: int,
        row: Measurement,
        predicted: int,
        score: float,
        output: Path | None,
        raw_output: Path | None,
    ) -> None:
        if self._executor is None:
            return
        self._slots.acquire()
        future = self._executor.submit(
            _write_debug_bundle, row, predicted, score, output, raw_output
        )
        future.add_done_callback(lambda _: self._slots.release())
        self._jobs[future] = (index, row.sample)

    def __exit__(self, *_exc_info) -> None:
        if self._executor is None:
            return
        for future in as_completed(self._jobs):
            index, sample = self._jobs[future]
            try:
                future.result()
            except Exception as error:  # noqa: BLE001
                self.errors.append((index, sample, error))
        self._executor.shutdown(wait=True)
        self._executor = None


# ---- boundary_evidence.gap_filter ----

GapRegion = tuple[str, Box]

MaskSlice = tuple[slice, slice]

def _gap_span(orientation: str, box: Box) -> MaskSlice:
    x0, y0, x1, y1 = box
    if orientation == "horizontal":
        return slice(None), slice(x0, x1)
    if orientation == "vertical":
        return slice(y0, y1), slice(None)
    raise ValueError("gap orientation must be horizontal or vertical")

def _gap_face_corridor(
    shape: tuple[int, int], orientation: str, box: Box, depth: int
) -> np.ndarray:
    x0, y0, x1, y1 = box
    corridor = np.zeros(shape, dtype=bool)
    if orientation == "vertical":
        corridor[:, max(0, x0 - depth) : x0] = True
        corridor[:, x1 : min(shape[1], x1 + depth)] = True
    elif orientation == "horizontal":
        corridor[max(0, y0 - depth) : y0, :] = True
        corridor[y1 : min(shape[0], y1 + depth), :] = True
    else:
        raise ValueError("gap orientation must be horizontal or vertical")
    return corridor

def _gap_dark_exclusion(
    dark_boundary: np.ndarray,
    localized: np.ndarray,
    orientation: str,
    box: Box,
    outer_boundary: np.ndarray,
) -> tuple[MaskSlice, np.ndarray] | None:
    if not is_valid_gap_fill_fraction(gap_fill_fraction(localized, box)):
        return None
    face_band = straight_gap_face_band(
        localized, orientation, box, DARK_BOUNDARY_ANCHOR_DEPTH_PX
    )
    if face_band is None:
        return None

    candidate = np.where(dark_boundary > 0, 255, 0).astype(np.uint8)
    face_seed = np.where((candidate > 0) & (face_band > 0), 255, 0).astype(np.uint8)
    if not np.any(face_seed):
        return None

    gap_connected = component_connected_to_seed(candidate, face_seed) > 0
    face_corridor = _gap_face_corridor(
        dark_boundary.shape, orientation, box, DARK_BOUNDARY_ANCHOR_DEPTH_PX
    )
    exterior_seed = np.where(
        gap_connected & (outer_boundary > 0) & ~face_corridor, 255, 0
    ).astype(np.uint8)
    if np.any(exterior_seed):
        protected = component_connected_to_seed(candidate, exterior_seed) > 0
        gap_connected &= ~protected

    span = _gap_span(orientation, box)
    return span, np.where(gap_connected[span], 255, 0).astype(np.uint8)

def gap_facing_dark_exclusion_mask(
    dark_boundary: np.ndarray,
    localized: np.ndarray,
    gaps: Iterable[GapRegion],
) -> np.ndarray:
    """Build the combined exclusion mask for valid, empty gap faces."""
    exclusion = np.zeros_like(dark_boundary)
    _, outer_boundary = boundary_search_geometry(localized > 0, radius=1)
    for orientation, box in gaps:
        rejected = _gap_dark_exclusion(
            dark_boundary, localized, orientation, box, outer_boundary
        )
        if rejected is None:
            continue
        span, rejected_mask = rejected
        np.maximum(exclusion[span], rejected_mask, out=exclusion[span])
    return exclusion

def filter_gap_facing_dark_evidence(
    dark_boundary: np.ndarray,
    localized: np.ndarray,
    gaps: Iterable[GapRegion],
) -> np.ndarray:
    """Remove dark evidence anchored to straight faces of valid empty gaps."""
    exclusion = gap_facing_dark_exclusion_mask(dark_boundary, localized, gaps)
    result = dark_boundary.copy()
    result[exclusion > 0] = 0
    return result


# ---- gap_detection.validation ----

@dataclass(frozen=True)
class InterdieEvidence:
    gaps: tuple[LocalizedInterdieGap, ...]
    bridge_mask: np.ndarray
    expected_gap_missing: bool = False
    expected_counts: tuple[int, int] | None = None
    missing_counts: tuple[int, int] = (0, 0)

def gap_fill_fraction(mask: np.ndarray, box: Box) -> float:
    """Return material occupancy inside one bounded gap region."""
    x0, y0, x1, y1 = box
    height, width = mask.shape
    if not (0 <= x0 < x1 <= width and 0 <= y0 < y1 <= height):
        return 1.0
    region = mask[y0:y1, x0:x1]
    return float(np.count_nonzero(region)) / region.size if region.size else 1.0

def is_valid_gap_fill_fraction(fill_fraction: float) -> bool:
    """Return whether gap occupancy is within the configured valid limit."""
    return float(fill_fraction) <= MAX_VALID_PARTIAL_GAP_OVERFLOW_RATIO

def is_valid_interdie_gap(localized: np.ndarray, gap: LocalizedInterdieGap) -> bool:
    return gap.is_complete or is_valid_gap_fill_fraction(
        gap_fill_fraction(localized, gap.box)
    )

def _gap_line_groups(
    gaps: Iterable[LocalizedInterdieGap], orientation: str
) -> list[list[LocalizedInterdieGap]]:
    oriented = sorted(
        (gap for gap in gaps if gap.orientation == orientation),
        key=lambda gap: gap.y0 if orientation == "horizontal" else gap.x0,
    )
    groups: list[list[LocalizedInterdieGap]] = []
    group_stop = -1
    for gap in oriented:
        start = gap.y0 if orientation == "horizontal" else gap.x0
        stop = gap.y1 if orientation == "horizontal" else gap.x1
        if groups and start <= group_stop:
            groups[-1].append(gap)
            group_stop = max(group_stop, stop)
        else:
            groups.append([gap])
            group_stop = stop
    return groups

def localized_gap_masks(
    shape: tuple[int, int], gaps: Iterable[LocalizedInterdieGap]
) -> tuple[np.ndarray, np.ndarray]:
    complete = np.zeros(shape, np.uint8)
    partial = np.zeros(shape, np.uint8)
    for gap in gaps:
        x0, y0, x1, y1 = gap.box
        target = complete if gap.is_complete else partial
        target[y0:y1, x0:x1] = 255
    return complete, partial

def partial_gap_bridge_mask(
    localized: np.ndarray, gaps: Iterable[LocalizedInterdieGap]
) -> np.ndarray:
    """Return raw material inside detected partial gap corridors."""
    bridge = np.zeros_like(localized)
    for gap in gaps:
        if gap.is_complete:
            continue
        x0, y0, x1, y1 = gap.box
        bridge[y0:y1, x0:x1] = localized[y0:y1, x0:x1]
    return bridge

def _select_expected_gap_lines(
    gaps: tuple[LocalizedInterdieGap, ...], expected: Mapping[str, int]
) -> list[LocalizedInterdieGap]:
    selected: list[LocalizedInterdieGap] = []
    for orientation in ORIENTATIONS:
        groups = _gap_line_groups(gaps, orientation)
        groups.sort(
            key=lambda group: (
                all(gap.is_complete for gap in group),
                max(gap.confidence for gap in group),
            ),
            reverse=True,
        )
        for group in groups[: expected.get(orientation, 0)]:
            selected.extend(group)
    return selected

def physical_gap_counts(gaps: Iterable[LocalizedInterdieGap]) -> dict[str, int]:
    """Count merged physical gap corridors by orientation."""
    gaps = tuple(gaps)
    return {
        orientation: sum(gap.orientation == orientation for gap in gaps)
        for orientation in ORIENTATIONS
    }

def _count_tuple(counts: Mapping[str, int]) -> tuple[int, int]:
    return counts.get("horizontal", 0), counts.get("vertical", 0)

def _missing_counts(
    detected: Mapping[str, int], expected: Mapping[str, int]
) -> dict[str, int]:
    return {
        orientation: max(0, expected.get(orientation, 0) - detected.get(orientation, 0))
        for orientation in ORIENTATIONS
    }

def filter_interdie_overflow(
    localized: np.ndarray,
    bridge: np.ndarray,
    gaps: Iterable[LocalizedInterdieGap],
) -> np.ndarray:
    """Keep bridge material only inside gaps rejected by gap validation."""
    overflow = np.zeros_like(bridge)
    for gap in gaps:
        if is_valid_interdie_gap(localized, gap):
            continue
        x0, y0, x1, y1 = gap.box
        overflow[y0:y1, x0:x1] = bridge[y0:y1, x0:x1]
    return overflow

def _record_interdie_evidence(localized: np.ndarray, evidence: InterdieEvidence) -> None:
    complete, partial = localized_gap_masks(localized.shape, evidence.gaps)
    detected = cv2.bitwise_or(complete, partial)
    observed_bridge = filter_interdie_overflow(localized, evidence.bridge_mask, evidence.gaps)
    notes = [
        (
            f"{gap.orientation[0].upper()} {gap.state}: "
            f"clear {gap.clear_fraction:.1%}, facing {gap.support_fraction:.1%}, "
            f"bridge {int(np.count_nonzero(evidence.bridge_mask[gap.y0:gap.y1, gap.x0:gap.x1]))}px"
        )
        for gap in evidence.gaps
    ]
    if evidence.expected_counts is not None:
        expected_h, expected_v = evidence.expected_counts
        missing_h, missing_v = evidence.missing_counts
        notes.append(
            f"expected H={expected_h} V={expected_v}; missing H={missing_h} V={missing_v}"
        )
    pane = "localized inter-die gaps"
    if evidence.expected_gap_missing:
        pane += " (expected gap missing)"
    DEBUG.show(pane, localized, "Raw localization", GREEN, style="outline")
    DEBUG.show(pane, detected, "Detected inter-die gap", BLUE, alpha=DETECTED_GAP_ALPHA)
    DEBUG.show(pane, observed_bridge, "Observed partial-gap bridge", RED, notes=notes)

def analyze_interdie(
    localized: np.ndarray,
    reference: MultiDieReference | None,
) -> InterdieEvidence:
    """Resolve raw inter-die evidence against the localized mask."""
    gaps = tuple(discover_localized_gaps(localized))

    if reference is None:
        evidence = InterdieEvidence(gaps, partial_gap_bridge_mask(localized, gaps))
        _record_interdie_evidence(localized, evidence)
        return evidence

    expected = reference_gap_counts(reference)
    detected = physical_gap_counts(gaps)
    missing_by_axis = _missing_counts(detected, expected)

    if reference.separators:
        bridge = registered_gap_bridge_mask(localized, localized, reference)
    else:
        bridge = partial_gap_bridge_mask(
            localized,
            _select_expected_gap_lines(gaps, expected),
        )

    evidence = InterdieEvidence(
        gaps,
        bridge,
        expected_gap_missing=any(missing_by_axis.values()),
        expected_counts=_count_tuple(expected),
        missing_counts=_count_tuple(missing_by_axis),
    )
    _record_interdie_evidence(localized, evidence)
    return evidence


# ---- debug.pipeline ----

def _frame(canvas: np.ndarray, title: str) -> np.ndarray:
    labelled = cv2.copyMakeBorder(
        canvas,
        LABEL_HEIGHT,
        BORDER,
        BORDER,
        BORDER,
        cv2.BORDER_CONSTANT,
        value=(40, 40, 40),
    )
    cv2.putText(
        labelled,
        title,
        (4, 15),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.45,
        (255, 255, 255),
        1,
        cv2.LINE_AA,
    )
    return labelled

def _draw_notes(canvas: np.ndarray, notes: list[str]) -> None:
    if not notes:
        return
    lines = notes[:MAX_NOTE_LINES]
    if len(notes) > MAX_NOTE_LINES:
        lines[-1] = f"{lines[-1]}  (+{len(notes) - MAX_NOTE_LINES} more)"
    height = len(lines) * NOTE_LINE_HEIGHT + 8
    y0 = max(0, canvas.shape[0] - height)
    shade = canvas.copy()
    cv2.rectangle(shade, (0, y0), (canvas.shape[1], canvas.shape[0]), (10, 10, 10), -1)
    canvas[y0:] = cv2.addWeighted(canvas[y0:], 0.35, shade[y0:], 0.65, 0)
    for index, line in enumerate(lines):
        cv2.putText(
            canvas,
            line,
            (5, y0 + 15 + index * NOTE_LINE_HEIGHT),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.36,
            (240, 240, 240),
            1,
            cv2.LINE_AA,
        )

def _tile(pane: DebugPane, gray: np.ndarray) -> np.ndarray:
    canvas = render_overlays(pane.image if pane.image is not None else gray, pane.overlays)
    scale = TILE_SIZE / max(canvas.shape[:2])
    canvas = cv2.resize(canvas, None, fx=scale, fy=scale)
    padded = np.zeros((TILE_SIZE, TILE_SIZE, 3), np.uint8)
    padded[: canvas.shape[0], : canvas.shape[1]] = canvas
    _draw_notes(padded, pane.notes)
    return _frame(padded, pane.name)

def _legend_tile(panes: list[DebugPane]) -> np.ndarray:
    entries: list[tuple[str, tuple[int, int, int], str, float | None]] = []
    seen: set[tuple[str, tuple[int, int, int], str, float | None]] = set()
    for pane in panes:
        for item in pane.overlays:
            key = (item.label, item.color, item.style, item.alpha)
            if item.label and key not in seen:
                seen.add(key)
                entries.append(key)
    canvas = np.zeros((TILE_SIZE, TILE_SIZE, 3), np.uint8)
    y = 20
    for label, color, style, alpha in entries:
        if y + LEGEND_LINE_HEIGHT > TILE_SIZE:
            break
        cv2.rectangle(canvas, (10, y - 8), (24, y + 6), color, 2 if style == "outline" else -1)
        suffix = " (outline)" if style == "outline" else ""
        if alpha is not None and style == "fill":
            suffix = f" ({alpha:.0%} fill)"
        cv2.putText(canvas, f"{label}{suffix}", (30, y + 3), cv2.FONT_HERSHEY_SIMPLEX, 0.34, (230, 230, 230), 1, cv2.LINE_AA)
        y += LEGEND_LINE_HEIGHT
    return _frame(canvas, "overlay legend")

def render_grid(panes: list[DebugPane], gray: np.ndarray, columns: int) -> np.ndarray:
    """Render captured panes and their legend into a labelled pipeline grid."""
    if not panes:
        raise ValueError("no pipeline debug panes were recorded")
    tiles = [_tile(pane, gray) for pane in panes]
    tiles.append(_legend_tile(panes))
    rows: list[np.ndarray] = []
    for start in range(0, len(tiles), columns):
        row = tiles[start : start + columns]
        row += [np.zeros_like(tiles[0])] * (columns - len(row))
        rows.append(cv2.hconcat(row))
    return cv2.vconcat(rows)


# ---- debug.run ----

@dataclass(frozen=True)
class _Candidate:
    score: float
    path: Path
    metrics: tuple[tuple[str, float], ...]

class ClassifierCandidateCache:
    """Keep diagnostic candidates nearest each classification boundary."""

    def __init__(self, thresholds: Mapping[str, float], limit: int = 20) -> None:
        self._thresholds = tuple(thresholds.items())
        self._limit = limit
        self._candidates: dict[int, list[_Candidate]] = {GOOD: [], BAD: []}

    def add(
        self,
        path: Path,
        predicted: int,
        metric_values: Mapping[str, float],
        *,
        gap_eligible: bool = True,
    ) -> None:
        if predicted not in self._candidates or not self._thresholds:
            return
        # A GOOD verdict driven by failed inter-die gap evidence has no meaningful
        # protrusion score, so it does not belong among lowest-scoring GOOD candidates.
        if predicted == GOOD and not gap_eligible:
            return
        metrics = tuple((name, metric_values[name]) for name, _ in self._thresholds)
        score = sum(
            value / threshold
            for (_, value), (_, threshold) in zip(metrics, self._thresholds)
        )
        candidates = self._candidates[predicted]
        candidates.append(_Candidate(score, path, metrics))
        candidates.sort(
            key=lambda candidate: (
                -candidate.score if predicted == BAD else candidate.score,
                str(candidate.path),
            )
        )
        del candidates[self._limit :]

    def log(self) -> None:
        for predicted, heading in (
            (GOOD, "Lowest-scoring GOOD"),
            (BAD, "Highest-scoring BAD"),
        ):
            candidates = self._candidates[predicted]
            LOGGER.info("%s candidates: %d", heading, len(candidates))
            for rank, candidate in enumerate(candidates, 1):
                details = " | ".join(
                    f"{name}={value:.6f}" for name, value in candidate.metrics
                )
                LOGGER.info(
                    "%d. %s | combined_score=%.6f | %s",
                    rank,
                    candidate.path,
                    candidate.score,
                    details,
                )

def add_cli_arguments(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--save-debug",
        action=argparse.BooleanOptionalAction,
        default=False,
        help="save debug overlays",
    )
    parser.add_argument(
        "--no-raw",
        action="store_true",
        help="with --save-debug, do not copy original images",
    )
    parser.add_argument(
        "--miss-only",
        action="store_true",
        help="with --save-debug, save misses or unlabelled samples predicted bad",
    )

def _debug_directory(sample: Sample, output_dir: Path) -> Path:
    return output_dir / product_key(sample) / (sample.lot or "unknown-lot")

def debug_path(row: Measurement, output_dir: Path) -> Path:
    """Return the stable destination for one debug overlay."""
    return _debug_directory(row.sample, output_dir) / row.sample.path.name

def raw_debug_path(row: Measurement, output_dir: Path) -> Path:
    """Return the stable destination for one original debug source image."""
    return _debug_directory(row.sample, output_dir) / "raw" / row.sample.path.name

def _miss(actual: int | None, predicted: int) -> str | None:
    if actual is None:
        return "BAD" if predicted == BAD else None
    if actual == BAD and predicted == GOOD:
        return "FN"
    if actual == GOOD and predicted == BAD:
        return "FP"
    return None

class DebugRunOutput:
    """Own optional overlay routing and asynchronous debug-image errors."""

    def __init__(self, args: argparse.Namespace) -> None:
        self.enabled = args.save_debug
        self.selected = 0
        self._output_dir = args.output_dir
        self._prod_dir = getattr(args, "prod_dir", None) if self.enabled else None
        self._miss_only = getattr(args, "miss_only", False)
        self._no_raw = getattr(args, "no_raw", False)
        self._writer = DebugWriter(self.enabled)

    def __enter__(self) -> "DebugRunOutput":
        self._writer.__enter__()
        return self

    def submit(
        self, index: int, row: Measurement, predicted: int, score: float
    ) -> None:
        miss = _miss(row.sample.label, predicted) if self._miss_only else None
        selected = self.enabled and (not self._miss_only or miss)
        if selected:
            self.selected += 1
            self._writer.submit(
                index,
                row,
                predicted,
                score,
                debug_path(row, self._output_dir),
                None if self._no_raw else raw_debug_path(row, self._output_dir),
            )
        if selected and self._prod_dir is not None:
            self._writer.submit(
                index,
                row,
                predicted,
                score,
                None,
                self._prod_dir / product_key(row.sample) / row.sample.path.name,
            )

    def __exit__(self, *exc_info) -> None:
        self._writer.__exit__(*exc_info)

    @property
    def errors(self) -> list[tuple[int, Sample, Exception]]:
        return self._writer.errors


# ---- pipeline.detection ----

def _reference_for(
    sample: Sample,
    references: Mapping[str, MultiDieReference] | None,
) -> MultiDieReference | None:
    product = product_key(sample)
    if references is None:
        return load_reference(product, MULTIDIE_REFERENCE_ROOT)
    return references.get(product.casefold()) or references.get(product)

def measure(
    sample: Sample,
    gray: np.ndarray | None = None,
    references: Mapping[str, MultiDieReference] | None = None,
) -> Measurement:
    source_gray = read_image(sample.path) if gray is None else gray
    gray = prepare_detection_image(source_gray)
    photometry_gray = source_gray

    try:
        localization = localize_chip_evidence(gray)
    except ValueError:
        empty = np.zeros_like(gray)
        result = Measurement(
            sample=sample,
            gray=gray,
            localized_mask=empty,
            analysis_failed=True,
            source_gray=source_gray,
        )
        record_final(result)
        return result

    localized_mask = localization.body
    gap_topology_mask = localization.gap_topology
    reference = _reference_for(sample, references)
    registered = evaluate_registered_gaps(gap_topology_mask, reference)
    detected_registered_gap_mask: np.ndarray | None = None
    evaluated_gap_mask: np.ndarray | None = None

    if registered is not None:
        detected_registered_gap_mask = registered.detected_mask
        evaluated_gap_mask = registered.evaluated_mask
        if registered.overflow:
            result = Measurement(
                sample=sample,
                gray=gray,
                interdie_material_mask=registered.material_mask,
                has_product_reference=True,
                registered_gap_overflow=True,
                localized_mask=localized_mask,
                detected_registered_gap_mask=detected_registered_gap_mask,
                evaluated_interdie_gap_mask=evaluated_gap_mask,
                source_gray=source_gray,
            )
            record_final(result)
            return result

    if registered is not None:
        assert reference is not None
        expected = reference_gap_counts(reference)
        gap_counts = expected
        expected_h = expected.get("horizontal", 0)
        expected_v = expected.get("vertical", 0)
        missing_h = missing_v = 0
        gaps = ()
        bridge_mask = np.zeros_like(localized_mask)
        expected_missing = False
        dark_boundary_gaps = [
            (item.separator.orientation, item.detected_box)
            for item in registered.observations
            if item.detected_box is not None
        ]
    else:
        gap_evidence = analyze_interdie(localized_mask, reference)
        gap_counts = physical_gap_counts(gap_evidence.gaps)
        gaps = gap_evidence.gaps
        bridge_mask = gap_evidence.bridge_mask
        expected_missing = gap_evidence.expected_gap_missing
        expected_h = expected_v = None
        if gap_evidence.expected_counts is not None:
            expected_h, expected_v = gap_evidence.expected_counts
        missing_h, missing_v = gap_evidence.missing_counts
        dark_boundary_gaps = [(gap.orientation, gap.box) for gap in gaps]

    boundary = analyze_dark_boundary(
        photometry_gray,
        localized_mask,
        localization.foreground,
        dark_boundary_gaps,
    )

    result = Measurement(
        sample=sample,
        gray=gray,
        dark_boundary_mask=boundary.dark_mask,
        boundary_material_mask=boundary.material_mask,
        interdie_material_mask=bridge_mask,
        has_product_reference=reference is not None,
        expected_interdie_gap_missing=expected_missing,
        interdie_horizontal_gap_count=gap_counts.get("horizontal", 0),
        interdie_vertical_gap_count=gap_counts.get("vertical", 0),
        localized_mask=localized_mask,
        interdie_gaps=gaps,
        expected_interdie_horizontal_gap_count=expected_h,
        expected_interdie_vertical_gap_count=expected_v,
        missing_interdie_horizontal_gap_count=missing_h,
        missing_interdie_vertical_gap_count=missing_v,
        detected_registered_gap_mask=detected_registered_gap_mask,
        evaluated_interdie_gap_mask=evaluated_gap_mask,
        source_gray=source_gray,
    )
    record_final(result)
    return result


# ---- boundary_evidence.detector ----

_WEAK_CUTOFF_RATIO = 0.60

_MIN_SEARCH_RADIUS_PX = 2

_SEARCH_TOLERANCE_RADIUS_RATIO = 0.10

_MIN_SEARCH_TOLERANCE_PX = 1

def dark_boundary_mask(
    gray: np.ndarray,
    source: np.ndarray,
    gap_regions: Iterable[GapRegion] = (),
    *,
    gap_source: np.ndarray | None = None,
) -> np.ndarray:
    """Return adaptive dark overflow evidence near observed material boundaries.

    ``source`` controls photometry and search geometry. An optional stable
    ``gap_source`` keeps recovered material out of gap validity decisions.
    """
    result = np.zeros_like(source)
    count, labels, stats, _ = cv2.connectedComponentsWithStats(
        (source > 0).astype(np.uint8), 8
    )
    gray_float = gray.astype(np.float32)

    debug = DEBUG.buffers(
        source, "band", "calibration", "bright", "candidates", "frame", "retention", "raw"
    )
    calibration_notes: list[str] = []

    overflow_sigma, overflow_floor = _dark_boundary_overflow_cutoff_parameters(
        DARK_BOUNDARY_SENSITIVITY
    )

    for component_id in range(1, count):
        whole_component = labels == component_id
        width = int(stats[component_id, cv2.CC_STAT_WIDTH])
        height = int(stats[component_id, cv2.CC_STAT_HEIGHT])
        radius = max(
            _MIN_SEARCH_RADIUS_PX,
            round(min(width, height) * OVERFLOW_SEARCH_RATIO),
        )
        tolerance = max(
            _MIN_SEARCH_TOLERANCE_PX,
            round(radius * _SEARCH_TOLERANCE_RADIUS_RATIO),
        )
        search_band, boundary = boundary_search_geometry(whole_component, radius)
        band = (search_band > 0) & whole_component
        boundary = boundary > 0
        if np.count_nonzero(band) < _MIN_PHOTOMETRIC_SUPPORT_PX:
            continue

        values = _dark_boundary_masked_blur(gray_float, whole_component)

        reference = _dark_boundary_normal_surface(values, whole_component)
        global_darkness = (reference - values) / reference
        calibration = _dark_boundary_calibration_support(global_darkness, whole_component)
        cutoff = _dark_boundary_robust_cutoff(
            global_darkness,
            calibration.mask,
            sigma=overflow_sigma,
            floor=overflow_floor,
        )
        if DEBUG.active:
            finite = whole_component & np.isfinite(global_darkness)
            excluded = finite & ~calibration.mask
            debug.paint("calibration", calibration.mask)
            debug.paint("bright", excluded)
            fraction = np.count_nonzero(excluded) / max(1, np.count_nonzero(finite))
            calibration_notes.append(
                f"component {component_id}: bright excluded {fraction:.1%}; "
                f"iterations {calibration.iterations}; {calibration.reason}"
            )
        if cutoff is None:
            debug.note(f"component {component_id}: insufficient finite calibration samples")
            continue

        strong = (global_darkness > cutoff) & band
        weak = (global_darkness > _WEAK_CUTOFF_RATIO * cutoff) & band
        raw_candidates = (
            component_connected_to_seed(
                (weak | strong).astype(np.uint8),
                strong.astype(np.uint8),
            )
            > 0
        )

        candidates = raw_candidates.copy()
        frame_rejects = _dark_boundary_frame_sandwich_rejects(
            candidates,
            strong,
            whole_component,
            tolerance,
            radius,
        )
        candidates &= ~frame_rejects
        retained = _dark_boundary_retain_boundary_components(
            values,
            candidates,
            strong,
            whole_component,
            boundary,
            radius,
        )
        raw_darkness = (reference - gray_float) / reference
        raw_supported = _dark_boundary_raw_supported_components(
            retained,
            raw_darkness,
            cutoff,
        )
        result[raw_supported] = 255

        debug.paint("band", band)
        debug.paint("candidates", raw_candidates)
        debug.paint("frame", raw_candidates & frame_rejects)
        debug.paint("retention", candidates & ~retained)
        debug.paint("raw", retained & ~raw_supported)
        if DEBUG.active:
            maximum = float(np.max(global_darkness[band]))
            status = "; unattainable cutoff" if cutoff >= maximum else ""
            debug.note(
                f"component {component_id}: R {radius}px; cutoff {cutoff:.3f}; "
                f"max {maximum:.3f}{status}"
            )
            debug.note(
                f"strong {np.count_nonzero(strong)}; weak {np.count_nonzero(weak)}"
            )

    # Recovery must not change whether an existing gap is empty or straight.
    gap_geometry = source if gap_source is None else gap_source
    filtered = filter_gap_facing_dark_evidence(result, gap_geometry, gap_regions)
    if DEBUG.active:
        DEBUG.show(
            "dark boundary calibration", debug.mask("calibration"),
            "Calibration support", GREEN, notes=calibration_notes,
        )
        DEBUG.show(
            "dark boundary calibration", debug.mask("bright"),
            "Bright calibration outliers", CYAN,
        )
        DEBUG.show(
            "dark boundary search",
            source,
            "Observed material",
            GREEN,
            style="outline",
        )
        DEBUG.show(
            "dark boundary search",
            debug.mask("band"),
            "Boundary search band",
            BLUE,
            style="outline",
        )
        DEBUG.show(
            "dark boundary candidates",
            debug.mask("candidates"),
            "Dark candidate",
            YELLOW,
            notes=debug.notes,
        )
        DEBUG.show(
            "dark boundary filtering",
            debug.mask("frame"),
            "Frame sandwich rejection",
            CYAN,
        )
        DEBUG.show(
            "dark boundary filtering",
            debug.mask("retention"),
            "Rejected by boundary retention",
            MAGENTA,
        )
        DEBUG.show(
            "dark boundary filtering",
            debug.mask("raw"),
            "Raw photometry rejection",
            BLUE,
        )
        DEBUG.show(
            "dark boundary filtering",
            result & ~filtered,
            "Gap-facing rejection",
            YELLOW,
        )
        DEBUG.show(
            "retained dark boundary evidence",
            source,
            "Observed material",
            GREEN,
            style="outline",
        )
        DEBUG.show(
            "retained dark boundary evidence",
            filtered,
            "Dark boundary evidence",
            RED,
        )
    return filtered

def analyze_dark_boundary(
    gray: np.ndarray,
    body: np.ndarray,
    foreground: np.ndarray,
    gap_regions: Iterable[GapRegion] = (),
) -> BoundaryEvidence:
    """Use one dark-evidence decision for both recovery and classification."""
    proposed = boundary_material_proposals(body, foreground)
    provisional = cv2.bitwise_or(body, proposed)
    dark = dark_boundary_mask(gray, provisional, gap_regions, gap_source=body)
    restored = supported_boundary_material(proposed, dark)
    material = cv2.bitwise_or(body, restored)
    if DEBUG.active:
        DEBUG.show("boundary material recovery", proposed, "Proposed foreground", YELLOW)
        DEBUG.show("boundary material recovery", restored, "Supported recovery", GREEN)
    return BoundaryEvidence(material, dark)


# ---- gap_detection.registered ----

@dataclass(frozen=True)
class RegisteredGapObservation:
    """One registered separator aligned to observed inter-die gap geometry."""

    separator: Separator
    expected_box: Box
    box: Box
    fill_fraction: float
    offset_px: int
    detected_box: Box | None = None

@dataclass(frozen=True)
class RegisteredGapEvaluation:
    """Usable registered corridors and their early overflow decision."""

    observations: tuple[RegisteredGapObservation, ...]
    detected_mask: np.ndarray
    evaluated_mask: np.ndarray
    material_mask: np.ndarray
    overflow: bool

def _map_reference_box(
    box: Separator,
    bounds: tuple[int, int, int, int],
    shape: tuple[int, int],
) -> Box:
    x, y, width, height = bounds
    return (
        max(0, int(round(x + box.x0 * width))),
        max(0, int(round(y + box.y0 * height))),
        min(shape[1], int(round(x + box.x1 * width))),
        min(shape[0], int(round(y + box.y1 * height))),
    )

def _match_score(
    expected: Box, gap: LocalizedInterdieGap
) -> tuple[int, int, float] | None:
    expected_cross, expected_long = axis_intervals(expected, gap.orientation)
    gap_cross, gap_long = axis_intervals(gap.box, gap.orientation)
    long_overlap = interval_overlap(expected_long, gap_long)
    if long_overlap is None:
        return None

    expected_width = expected_cross[1] - expected_cross[0]
    gap_width = gap_cross[1] - gap_cross[0]
    distance = interval_distance(expected_cross, gap_cross)
    if distance > REGISTERED_GAP_MAX_SHIFT_PX:
        return None

    overlap_area = (long_overlap[1] - long_overlap[0]) * min(expected_width, gap_width)
    expected_center = sum(expected_cross) / 2.0
    gap_center = sum(gap_cross) / 2.0
    return overlap_area, -round(abs(gap_center - expected_center)), gap.confidence

def _overlap_box(expected: Box, gap: LocalizedInterdieGap) -> tuple[Box, int] | None:
    expected_cross, expected_long = axis_intervals(expected, gap.orientation)
    gap_cross, _ = axis_intervals(gap.box, gap.orientation)
    thickness = min(
        expected_cross[1] - expected_cross[0], gap_cross[1] - gap_cross[0]
    )
    if thickness <= 0:
        return None

    expected_center = sum(expected_cross) / 2.0
    cross_start = int(round(expected_center - thickness / 2.0))
    cross_start = min(max(cross_start, gap_cross[0]), gap_cross[1] - thickness)
    cross = cross_start, cross_start + thickness
    offset = int(round(sum(cross) / 2.0 - expected_center))
    if gap.orientation == "horizontal":
        return (expected_long[0], cross[0], expected_long[1], cross[1]), offset
    return (cross[0], expected_long[0], cross[1], expected_long[1]), offset

def _observation(
    localized: np.ndarray,
    separator: Separator,
    expected: Box,
    gaps: list[LocalizedInterdieGap],
) -> RegisteredGapObservation | None:
    x0, y0, x1, y1 = expected
    if x1 <= x0 or y1 <= y0:
        return None
    candidates = [
        (score, gap)
        for gap in gaps
        if gap.orientation == separator.orientation
        and (score := _match_score(expected, gap)) is not None
    ]
    if not candidates:
        return RegisteredGapObservation(
            separator, expected, expected, gap_fill_fraction(localized, expected), 0
        )

    _, gap = max(candidates, key=lambda item: item[0])
    aligned = _overlap_box(expected, gap)
    if aligned is None:
        return None
    box, offset = aligned
    return RegisteredGapObservation(
        separator,
        expected,
        box,
        gap_fill_fraction(localized, box),
        offset,
        gap.box,
    )

def registered_gap_observations(
    localized: np.ndarray, reference: MultiDieReference | None
) -> tuple[RegisteredGapObservation, ...]:
    """Measure explicit registered gaps against nearby physical corridors."""
    if reference is None or not reference.separators:
        return ()
    bounds = cv2.boundingRect(localized)
    if bounds[2] == 0 or bounds[3] == 0:
        return ()

    observations = []
    for separator in reference.separators:
        expected = _map_reference_box(separator, bounds, localized.shape)
        gaps = discover_registered_gap_candidates(
            localized, expected, separator.orientation, REGISTERED_GAP_MAX_SHIFT_PX
        )
        observation = _observation(localized, separator, expected, gaps)
        if observation is not None:
            observations.append(observation)
    return tuple(observations)

def _boxes_mask(shape: tuple[int, int], boxes: list[Box]) -> np.ndarray:
    mask = np.zeros(shape, np.uint8)
    for x0, y0, x1, y1 in boxes:
        if x1 > x0 and y1 > y0:
            mask[y0:y1, x0:x1] = 255
    return mask

def evaluate_registered_gaps(
    gap_topology: np.ndarray, reference: MultiDieReference | None
) -> RegisteredGapEvaluation | None:
    """Evaluate every registered separator and record its diagnostic pane."""
    observations = registered_gap_observations(gap_topology, reference)
    if (
        reference is None
        or not reference.separators
        or len(observations) != len(reference.separators)
    ):
        return None

    detected = _boxes_mask(
        gap_topology.shape,
        [item.detected_box for item in observations if item.detected_box is not None],
    )
    evaluated = _boxes_mask(gap_topology.shape, [item.box for item in observations])
    material = cv2.bitwise_and(gap_topology, evaluated)
    overflow = any(
        not is_valid_gap_fill_fraction(item.fill_fraction) for item in observations
    )
    notes = [
        f"{item.separator.orientation[0].upper()} fill={item.fill_fraction:.1%}; "
        f"offset={item.offset_px:+d}px"
        for item in observations
    ]
    notes.append(
        f"registered-gap decision: {'early GOOD' if overflow else 'clear; continue'}"
    )
    pane = "registered gap precheck"
    DEBUG.show(pane, gap_topology, "Gap topology", GREEN, style="outline")
    DEBUG.show(pane, detected, "Detected inter-die gap", BLUE, alpha=DETECTED_GAP_ALPHA)
    DEBUG.show(pane, evaluated, "Evaluated gap corridor", RED, style="dotted")
    DEBUG.show(pane, material, "Localized material in registered gap", RED, notes=notes)
    return RegisteredGapEvaluation(observations, detected, evaluated, material, overflow)


# ---- cli ----

PrefetchedSample = tuple[int, Sample, np.ndarray | None, Exception | None, float]

MeasuredSample = tuple[int, Sample, Measurement | None, Exception | None, float, float]

def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "data_dirs",
        nargs="*",
        type=Path,
        metavar="DIR",
        help="directories to recursively scan for image files",
    )
    add_cli_arguments(parser)
    parser.add_argument(
        "--csv",
        nargs="+",
        type=Path,
        help="one or more CSV exports with image_full_path network paths to inspect",
    )
    parser.add_argument(
        "--debug-site",
        default=None,
        metavar="SITE",
        help=(
            "restrict storage to one site subdirectory under STORAGE_ROOT "
            "(e.g. --debug-site CD -> STORAGE_ROOT/CD); only one site at a time"
        ),
    )
    parser.add_argument(
        "--production",
        action="store_true",
        help="with --save-debug, --debug-site, and --prod-dir, copy raw images to the specified folder",
    )
    parser.add_argument(
        "--prod-dir",
        type=Path,
        metavar="PATH",
        help="production raw-image root; copies go under PATH/<product>/<image filename>",
    )
    for name, setting, help_text in (
        ("history", USE_HISTORY, "read and update processed-image history"),
        ("network", USE_NETWORK, "write artifacts to the network storage root"),
    ):
        parser.add_argument(
            f"--use-{name}",
            f"--{name}",
            dest=f"use_{name}",
            action=argparse.BooleanOptionalAction,
            default=None,
            help=f"{help_text} (default: settings.py={setting})",
        )
    parser.add_argument(
        "--batch-size",
        type=int,
        default=DEFAULT_BATCH_SIZE,
        help=f"images to process per batch (default: {DEFAULT_BATCH_SIZE})",
    )
    parser.add_argument(
        "--max",
        dest="max_images",
        type=int,
        help="maximum images to randomly process, prioritizing smaller directories",
    )
    parser.add_argument(
        "--max-per-dir",
        type=int,
        help="maximum images to randomly process from each directory",
    )
    parser.add_argument(
        "-i",
        "--image",
        "--images",
        dest="images",
        nargs="+",
        type=Path,
        metavar="FILE",
        help="infer only these image files instead of scanning DATA_DIR",
    )
    parser.add_argument(
        "-t",
        "--threshold",
        type=float,
        default=PROTRUSION_THRESHOLD_PX,
        help="minimum dark-boundary protrusion depth in pixels for a good reflow",
    )
    parser.add_argument(
        "--area-threshold",
        type=float,
        default=PROTRUSION_AREA_THRESHOLD_PX,
        help="minimum largest dark-boundary component area in pixels for a good reflow",
    )
    parser.add_argument(
        "--skip-mask",
        nargs="+",
        metavar="PRODUCT",
        default=(),
        help="ignore registered masks for PRODUCT; use '*' to ignore all masks",
    )
    parser.add_argument(
        "--product-config",
        type=Path,
        default=MULTIDIE_REFERENCE_ROOT / PRODUCTS_FILE,
        metavar="PATH",
        help=(
            "consolidated product config file or containing directory; relative "
            "paths use the current "
            f"working directory (default: {MULTIDIE_REFERENCE_ROOT / PRODUCTS_FILE})"
        ),
    )
    args = parser.parse_args()
    if args.csv and args.images:
        parser.error("--csv cannot be combined with --images")
    if args.batch_size < 1:
        parser.error("--batch-size must be at least 1")
    if args.max_images is not None and args.max_images < 1:
        parser.error("--max must be at least 1")
    if args.max_per_dir is not None and args.max_per_dir < 1:
        parser.error("--max-per-dir must be at least 1")
    if "*" in args.skip_mask and args.skip_mask != ["*"]:
        parser.error("--skip-mask '*' cannot be combined with product names")
    if args.production and (args.debug_site or "").upper() not in ("CD", "VN", "KM", "PG"):
        parser.error("--production requires --debug-site CD, VN, KM, or PG")
    if args.production and not args.save_debug:
        parser.error("--production requires --save-debug")
    if args.production and args.prod_dir is None:
        parser.error("--production requires --prod-dir")
    if args.prod_dir is not None and not args.production:
        parser.error("--prod-dir requires --production")
    args.output_dir = STORAGE_ROOT / DEBUG_RESULTS_FOLDER
    args.use_history = USE_HISTORY if args.use_history is None else args.use_history
    args.use_network = USE_NETWORK if args.use_network is None else args.use_network
    args.product_config = args.product_config.expanduser()
    if not args.product_config.is_absolute():
        args.product_config = Path.cwd() / args.product_config
    if args.product_config.is_dir():
        args.product_config /= PRODUCTS_FILE
    return args

def _try_call(function, *call_args):
    started = perf_counter()
    try:
        return function(*call_args), None, perf_counter() - started
    except Exception as error:  # noqa: BLE001
        return None, error, perf_counter() - started

def _prefetch_samples(
    samples: list[Sample], csv: Path | None
) -> Iterator[PrefetchedSample]:
    if not csv:
        for index, sample in enumerate(samples):
            yield index, sample, None, None, 0.0
        return

    with ThreadPoolExecutor(
        max_workers=min(NETWORK_READ_THREADS, len(samples))
    ) as executor:
        futures = {
            executor.submit(_try_call, read_image, sample.path): (index, sample)
            for index, sample in enumerate(samples)
        }
        for future in as_completed(futures):
            index, sample = futures[future]
            gray, error, read_seconds = future.result()
            yield index, sample, gray, error, read_seconds

def _measure_sample(
    sample: Sample,
    gray: np.ndarray | None,
    references: Mapping[str, MultiDieReference] | None,
) -> Measurement:
    if references is None:
        return measure(sample) if gray is None else measure(sample, gray)
    return (
        measure(sample, references=references)
        if gray is None
        else measure(sample, gray, references)
    )

def _measurement_results(
    samples: list[Sample],
    args: argparse.Namespace,
    references: Mapping[str, MultiDieReference] | None = None,
) -> Iterator[MeasuredSample]:
    with ThreadPoolExecutor(max_workers=min(THREAD_COUNT, len(samples))) as executor:
        futures = {}
        for index, sample, gray, error, read_seconds in _prefetch_samples(
            samples, args.csv
        ):
            if error is not None:
                yield index, sample, None, error, read_seconds, 0.0
                continue
            future = executor.submit(
                _try_call, _measure_sample, sample, gray, references
            )
            futures[future] = (index, sample, read_seconds)

        for future in as_completed(futures):
            index, sample, read_seconds = futures[future]
            result, error, measure_seconds = future.result()
            if error is not None:
                yield index, sample, None, error, read_seconds, measure_seconds
                continue
            yield index, sample, result, None, read_seconds, measure_seconds

def process(
    samples: list[Sample],
    args: argparse.Namespace,
    errors: dict[Path, str] | None = None,
    stats: RunStats | None = None,
    progress_total: int | None = None,
    completed_before: int = 0,
    run_started: float | None = None,
    references: Mapping[str, MultiDieReference] | None = None,
    candidates: ClassifierCandidateCache | None = None,
    product_remaining: Mapping[str, int] | None = None,
    product_totals: Mapping[str, int] | None = None,
    unreadable_paths: set[Path] | None = None,
    run_writer: AsyncRunWriter | None = None,
) -> tuple[list[Measurement | Sample], np.ndarray, np.ndarray]:
    cv2.setNumThreads(1)
    if not samples:
        return [], np.array([], dtype=int), np.array([], dtype=float)

    completed_rows: dict[int, tuple[Measurement | Sample, int, float, bool]] = {}
    pending_writes: set[int] = set()
    next_write = 0
    total = progress_total or len(samples)
    area_threshold = getattr(args, "area_threshold", PROTRUSION_AREA_THRESHOLD_PX)
    run_started = perf_counter() if run_started is None else run_started
    stats = stats or RunStats()
    remaining = dict(product_remaining or {})
    batch_started = perf_counter()
    first_result_seconds = 0.0
    read_seconds = measure_seconds = 0.0
    slowest_read = slowest_measure = 0.0
    debug_submit_seconds = run_writer_submit_seconds = 0.0

    with DebugRunOutput(args) as debug_output:
        for completed, outcome in enumerate(
            _measurement_results(samples, args, references), 1
        ):
            index, sample, row, error, read_duration, measure_duration = outcome
            if completed == 1:
                first_result_seconds = perf_counter() - batch_started
            read_seconds += read_duration
            measure_seconds += measure_duration
            slowest_read = max(slowest_read, read_duration)
            slowest_measure = max(slowest_measure, measure_duration)
            product = product_key(sample)
            product_folded = product.casefold()
            if product_folded in remaining:
                remaining[product_folded] -= 1
            if error is not None:
                if isinstance(error, ImageReadError):
                    if unreadable_paths is not None:
                        unreadable_paths.add(sample.path)
                    log_unreadable_image(sample, error)
                    if run_writer is not None:
                        submit_started = perf_counter()
                        run_writer.submit_failed_read(sample)
                        run_writer_submit_seconds += perf_counter() - submit_started
                else:
                    record_skipped_image(sample, error, errors)
            else:
                assert row is not None
                try:
                    label, score = predict(row, args.threshold, area_threshold)
                    submit_started = perf_counter()
                    try:
                        debug_output.submit(index, row, label, score)
                    finally:
                        debug_submit_seconds += perf_counter() - submit_started
                except Exception as error:  # noqa: BLE001
                    record_skipped_image(sample, error, errors)
                else:
                    completed_rows[index] = (
                        sample if debug_output.enabled else row,
                        label,
                        score,
                        not has_interdie_overflow(row),
                    )
                    stats.record(sample, label, product)
            if run_writer is not None:
                # Preserve input order in result/history CSVs despite concurrent
                # completion, advancing past failed images without writing predictions.
                pending_writes.add(index)
                while next_write in pending_writes:
                    result = completed_rows.get(next_write)
                    if result is not None:
                        submit_started = perf_counter()
                        run_writer.submit_prediction(samples[next_write], result[1])
                        run_writer_submit_seconds += perf_counter() - submit_started
                    pending_writes.remove(next_write)
                    next_write += 1

            processed = completed_before + completed
            product_total = (product_totals or {}).get(product_folded, 0)
            product_summary = stats.summary(product)
            logged_progress = log_progress(
                product,
                product_total - remaining.get(product_folded, 0),
                product_total,
                processed,
                total,
                completed,
                perf_counter() - run_started,
                stats.processed,
                int(product_summary["predicted_bad"]),
                stats.positives,
                stats.top_products_by_bad(),
            )
            if logged_progress and run_writer is not None:
                submit_started = perf_counter()
                run_writer.flush()
                run_writer_submit_seconds += perf_counter() - submit_started

        debug_drain_started = perf_counter()

    LOGGER.info(
        "Batch timing: images=%d | wall=%.3fs | first_result=%.3fs | "
        "read_worker_total=%.3fs (max=%.3fs) | infer_worker_total=%.3fs "
        "(max=%.3fs) | debug_selected=%d | debug_submit=%.3fs | "
        "debug_drain=%.3fs | run_output_submit=%.3fs",
        len(samples),
        perf_counter() - batch_started,
        first_result_seconds,
        read_seconds,
        slowest_read,
        measure_seconds,
        slowest_measure,
        debug_output.selected,
        debug_submit_seconds,
        perf_counter() - debug_drain_started,
        run_writer_submit_seconds,
    )

    for index, sample, error in debug_output.errors:
        record_skipped_image(sample, error, errors)
        completed_rows.pop(index, None)

    ordered = [completed_rows[index] for index in sorted(completed_rows)]
    if candidates is not None:
        for row, label, score, gap_eligible in ordered:
            candidates.add(
                _sample(row).path,
                label,
                {"protrusion_area_px": score},
                gap_eligible=gap_eligible,
            )
    return (
        [row for row, _, _, _ in ordered],
        np.asarray([label for _, label, _, _ in ordered], dtype=int),
        np.asarray([score for _, _, score, _ in ordered], dtype=float),
    )

def _sample(row: Measurement | Sample) -> Sample:
    return row.sample if isinstance(row, Measurement) else row

def _load_samples(
    args: argparse.Namespace, processed_paths: set[str] | None = None
) -> tuple[list[Sample], bool]:
    if args.csv:
        return csv_samples(args.csv), False
    if args.images:
        return discover(args.images)
    data_dirs = getattr(args, "data_dirs", None)
    if data_dirs is None:
        data_dir = getattr(args, "data_dir", None)
        data_dirs = [data_dir] if data_dir else []
    paths = data_dirs[0] if len(data_dirs) == 1 else data_dirs
    maximum_per_directory = getattr(args, "max_per_dir", None)
    if maximum_per_directory is None:
        return discover(paths)
    return discover(
        paths,
        maximum_per_directory=maximum_per_directory,
        processed_paths=processed_paths,
    )

def _load_run_references(
    skip_mask: Collection[str],
    product_config: Path = MULTIDIE_REFERENCE_ROOT / PRODUCTS_FILE,
) -> dict[str, MultiDieReference]:
    if len(skip_mask) == 1 and "*" in skip_mask:
        return {}
    return load_references_from_config(product_config, excluded_products=skip_mask)

def _run(args: argparse.Namespace) -> None:
    started = perf_counter()
    started_at = malaysia_now()
    use_history = getattr(args, "use_history", USE_HISTORY)
    use_network = getattr(args, "use_network", USE_NETWORK)
    storage_root = (
        STORAGE_ROOT
        if use_network == USE_NETWORK
        else NETWORK_STORAGE_ROOT if use_network else Path.cwd()
    )
    if getattr(args, "debug_site", None):
        storage_root = storage_root / args.debug_site
    logging_started = perf_counter()
    configure_logging(log_path_for(storage_root, started_at))
    logging_setup_seconds = perf_counter() - logging_started

    try:
        run_timestamp = started_at.strftime(RUN_FILENAME_TIMESTAMP_FORMAT).upper()
        # An unmodified default was baked in at parse time from the unadjusted
        # STORAGE_ROOT, so it must be rebased onto this run's storage_root here.
        if args.output_dir == STORAGE_ROOT / DEBUG_RESULTS_FOLDER:
            args.output_dir = storage_root / DEBUG_RESULTS_FOLDER
        args.output_dir = args.output_dir / run_timestamp
        results_path = (
            None
            if args.csv
            else storage_root / RESULTS_FOLDER / f"{run_timestamp}{RESULTS_FILE_SUFFIX}"
        )
        run_dir = storage_root / RUN_FOLDER / run_timestamp
        history_path = (
            storage_root / HISTORY_FOLDER / HISTORY_FILE if use_history else None
        )

        batch_size = getattr(args, "batch_size", DEFAULT_BATCH_SIZE)
        area_threshold = getattr(args, "area_threshold", PROTRUSION_AREA_THRESHOLD_PX)
        LOGGER.info(
            "Debug output folder: %s | Config: storage=%s | history=%s | batch=%d | "
            "read_threads=%d | infer_threads=%d",
            args.output_dir,
            "network" if use_network else "local",
            use_history,
            batch_size,
            NETWORK_READ_THREADS,
            THREAD_COUNT,
        )
        debug_site = getattr(args, "debug_site", None)
        production_root = getattr(args, "prod_dir", None)
        LOGGER.info(
            "Image storage: debug_site=%s | debug=%s | production_raw=%s",
            debug_site.upper() if debug_site else "none",
            args.output_dir if args.save_debug else "disabled",
            production_root / "<product_name>" / "<image_filename>"
            if args.save_debug and production_root is not None
            else "disabled",
        )
        LOGGER.info(
            "protrusion_threshold=%.6f | protrusion_area_threshold=%.6f",
            args.threshold,
            area_threshold,
        )

        skip_mask = getattr(args, "skip_mask", ())
        product_config = getattr(args, "product_config", None)
        references_started = perf_counter()
        references = (
            _load_run_references(skip_mask)
            if product_config is None
            else _load_run_references(skip_mask, product_config)
        )
        references_seconds = perf_counter() - references_started
        product_masks = sorted(
            (reference.product for reference in references.values()), key=str.casefold
        )
        LOGGER.info(
            "Loaded product masks: %d | products=%s",
            len(product_masks),
            ", ".join(product_masks) or "none",
        )

        history_started = perf_counter()
        processed = read_history(history_path) if history_path is not None else set()
        history_seconds = perf_counter() - history_started
        input_started = perf_counter()
        samples, labelled = _load_samples(args, processed)
        pending = [sample for sample in samples if str(sample.path) not in processed]
        pending = limit_samples(
            pending,
            getattr(args, "max_images", None),
            getattr(args, "max_per_dir", None),
        )
        input_seconds = perf_counter() - input_started
        LOGGER.info(
            "Setup timing: log=%.3fs | references=%.3fs | history=%.3fs | input=%.3fs",
            logging_setup_seconds,
            references_seconds,
            history_seconds,
            input_seconds,
        )
        LOGGER.info(
            "Images: total=%d | skipped=%d | to_process=%d | product_config=%s",
            len(samples),
            len(samples) - len(pending),
            len(pending),
            str(
                any(product_key(sample).casefold() in references for sample in pending)
            ).lower(),
        )

        stats = RunStats()
        errors: dict[Path, str] = {}
        candidates = ClassifierCandidateCache(
            {**CLASSIFIER_THRESHOLDS, "protrusion_area_px": area_threshold}
        )
        csv_results: dict[Path, int] = {}
        pending_product_counts = Counter(
            product_key(sample).casefold() for sample in pending
        )
        pending_product_totals = pending_product_counts.copy()
        pending_product_names = {
            product_key(sample).casefold(): product_key(sample) for sample in pending
        }
        product_started: dict[str, float] = {}

        run_output_started = perf_counter()
        with AsyncRunWriter(results_path, history_path, run_dir=run_dir) as run_writer:
            LOGGER.info("Run output setup: %.3fs", perf_counter() - run_output_started)
            for start in range(0, len(pending), batch_size):
                batch = pending[start : start + batch_size]
                batch_started = perf_counter()
                for sample in batch:
                    product_started.setdefault(
                        product_key(sample).casefold(), batch_started
                    )
                batch_rows, batch_predicted, batch_scores = process(
                    batch,
                    args,
                    errors=errors,
                    stats=stats,
                    progress_total=len(pending),
                    completed_before=start,
                    run_started=started,
                    references=references,
                    candidates=candidates,
                    product_remaining=pending_product_counts,
                    product_totals=pending_product_totals,
                    run_writer=run_writer,
                )
                successful_samples = [_sample(row) for row in batch_rows]
                if args.csv:
                    csv_results.update(
                        (sample.path, int(label))
                        for sample, label in zip(
                            successful_samples, batch_predicted, strict=True
                        )
                    )

                # The writer snapshots only Sample metadata and labels, so image-backed
                # measurements from this completed batch can be reclaimed immediately.
                del batch_rows, batch_predicted, batch_scores, successful_samples

                for sample in batch:
                    product = product_key(sample)
                    product_key_folded = product.casefold()
                    pending_product_counts[product_key_folded] -= 1
                    if not pending_product_counts[product_key_folded]:
                        stats.set_elapsed(
                            perf_counter() - product_started[product_key_folded],
                            pending_product_names[product_key_folded],
                        )
                        summary = stats.summary(
                            pending_product_names[product_key_folded]
                        )
                        LOGGER.info(
                            "Finished processing product type: %s | images_processed=%d | "
                            "positive=%d | total_time=%.3fs",
                            pending_product_names[product_key_folded],
                            int(summary["total_images"]),
                            int(summary["predicted_bad"]),
                            float(summary["total_seconds"]),
                        )

            run_output_close_started = perf_counter()

        LOGGER.info(
            "Run output drain: %.3fs", perf_counter() - run_output_close_started
        )

        if args.csv and csv_results:
            csv_update_started = perf_counter()
            update_csv_results(args.csv, csv_results)
            LOGGER.info("Input CSV update: %.3fs", perf_counter() - csv_update_started)

        candidates.log()
        write_run_report(
            started_at,
            malaysia_now(),
            perf_counter() - started,
            stats,
            errors,
            labelled=labelled,
        )
    except BaseException as error:
        log_execution_stop(error)
        raise
    finally:
        close_logging()

def main() -> None:
    args = parse_args()
    csv_paths = args.csv if isinstance(args.csv, list) else [args.csv]
    for csv_path in csv_paths:
        run_args = copy(args)
        run_args.csv = csv_path
        _run(run_args)

if __name__ == "__main__":
    try:
        main()
    except (FileNotFoundError, OSError, ValueError, cv2.error) as error:
        sys.exit(f"error: <{error}>")

