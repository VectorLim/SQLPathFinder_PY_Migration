DEBUG_WRITE_QUEUE_SIZE = 32

RUN_OUTPUT_INTERVAL = 25

TILE_SIZE = 320

LABEL_HEIGHT = 22

BORDER = 2

LEGEND_LINE_HEIGHT = 18

NOTE_LINE_HEIGHT = 16

MAX_NOTE_LINES = 4

OVERLAY_ALPHA = 1

FOOTER_HEIGHT = 56


# ---- boundary_evidence.material ----

@dataclass(frozen=True)
class BoundaryEvidence:
    """Accepted material geometry and dark evidence from the same evaluation."""

    material_mask: np.ndarray
    dark_mask: np.ndarray

def boundary_material_proposals(
    body: np.ndarray, foreground: np.ndarray,
) -> np.ndarray:
    """Propose omitted foreground attached to exactly one existing die.

    A proposal may touch the image frame. It must not join separate die masks:
    that would merge their photometric calibration and boundary search geometry.
    """
    omitted = ((foreground > 0) & (body == 0)).astype(np.uint8)
    _, owners = cv2.connectedComponents((body > 0).astype(np.uint8), connectivity=8)
    count, labels = cv2.connectedComponents(omitted, connectivity=8)
    proposed = np.zeros_like(body)
    adjacency = np.ones((3, 3), np.uint8)
    for component_id in range(1, count):
        component = labels == component_id
        adjacent = cv2.dilate(component.astype(np.uint8), adjacency) > 0
        touched = np.unique(owners[adjacent & (owners > 0)])
        if len(touched) == 1:
            proposed[component] = 255
    return proposed

def supported_boundary_material(
    proposed: np.ndarray, dark: np.ndarray,
) -> np.ndarray:
    """Accept complete proposals supported by the detector's retained evidence.

    There is no separate recovery contrast test. Keeping the complete supported
    foreground preserves a nodule's geometry beyond the boundary search band.
    """
    count, labels = cv2.connectedComponents(
        (proposed > 0).astype(np.uint8), connectivity=8,
    )
    accepted = np.zeros(count, dtype=bool)
    accepted[np.unique(labels[dark > 0])] = True
    accepted[0] = False
    return np.where(accepted[labels], 255, 0).astype(np.uint8)


