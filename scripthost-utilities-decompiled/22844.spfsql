# ---- boundary_evidence.photometry ----

_OVERFLOW_SIGMA_BASE = 2.0

_OVERFLOW_FLOOR_BASE = 0.05

_OVERFLOW_FLOOR_PER_SENSITIVITY = 0.02

_MIN_PHOTOMETRIC_SUPPORT_PX = 20

_SURFACE_DARK_TAIL_QUANTILE = 0.30

_SURFACE_RESIDUAL_UPPER_QUANTILE = 0.95

_SURFACE_FIT_ITERATIONS = 2

_MIN_CUTOFF_VALUES = 10

_MAD_SCALE = 1.4826

_MIN_NORMALIZED_NOISE = 0.002

_CALIBRATION_BRIGHT_SIGMA = 3.0

_CALIBRATION_MAX_ITERATIONS = 30

_LOCAL_REFERENCE_REACH_RADIUS_RATIO = 2

_MIN_LOCAL_REFERENCE_PX = 10

_RIM_MIN_BOUNDARY_CONTACT = 0.8

_RIM_MAX_LOCAL_CONTRAST = 0.15

_RAW_DARKNESS_FLOOR = 0.005

_RAW_DARKNESS_CUTOFF_RATIO = 0.10

_MIN_RAW_SUPPORT_RATIO = 0.20

def _dark_boundary_overflow_cutoff_parameters(
    sensitivity: float,
) -> tuple[float, float]:
    """Map the user knob to bounded noise-aware threshold parameters."""
    sensitivity = max(0.0, float(sensitivity))
    return (
        _OVERFLOW_SIGMA_BASE + sensitivity,
        _OVERFLOW_FLOOR_BASE + _OVERFLOW_FLOOR_PER_SENSITIVITY * sensitivity,
    )

def _dark_boundary_masked_blur(
    gray: np.ndarray, support: np.ndarray
) -> np.ndarray:
    """Smooth texture without blending substrate into the localized die."""
    weights = support.astype(np.float32)
    # A 3x3 blur suppresses pixel texture without broadening boundary structure.
    numerator = cv2.GaussianBlur(gray * weights, (3, 3), 0)
    denominator = cv2.GaussianBlur(weights, (3, 3), 0)
    return numerator / np.maximum(denominator, 1e-6)

def _dark_boundary_normal_surface(
    values: np.ndarray, support: np.ndarray
) -> np.ndarray:
    """Fit expected die illumination while trimming the dark residual tail."""
    y, x = np.where(support > 0)
    if len(x) < _MIN_PHOTOMETRIC_SUPPORT_PX:
        level = float(np.median(values[support > 0])) if len(x) else 1.0
        return np.full(values.shape, max(1.0, level), np.float32)

    height, width = values.shape
    xn = (x - (width - 1) / 2.0) / max(1.0, float(width))
    yn = (y - (height - 1) / 2.0) / max(1.0, float(height))
    observed = values[y, x].astype(np.float32)
    design = np.column_stack((np.ones(len(x), np.float32), xn, yn)).astype(
        np.float32
    )

    keep = observed >= np.quantile(observed, _SURFACE_DARK_TAIL_QUANTILE)
    if np.count_nonzero(keep) < _MIN_PHOTOMETRIC_SUPPORT_PX:
        keep[:] = True
    coefficients = np.linalg.lstsq(design[keep], observed[keep], rcond=None)[0]
    for _ in range(_SURFACE_FIT_ITERATIONS):
        residual = observed - design @ coefficients
        lower, upper = np.quantile(
            residual,
            (_SURFACE_DARK_TAIL_QUANTILE, _SURFACE_RESIDUAL_UPPER_QUANTILE),
        )
        keep = (residual >= lower) & (residual <= upper)
        if np.count_nonzero(keep) < _MIN_PHOTOMETRIC_SUPPORT_PX:
            break
        coefficients = np.linalg.lstsq(design[keep], observed[keep], rcond=None)[0]

    yy, xx = np.indices(values.shape, dtype=np.float32)
    xx = (xx - (width - 1) / 2.0) / max(1.0, float(width))
    yy = (yy - (height - 1) / 2.0) / max(1.0, float(height))
    reference = coefficients[0] + coefficients[1] * xx + coefficients[2] * yy
    return np.maximum(reference.astype(np.float32), 1.0)

@dataclass(frozen=True)
class _CalibrationSupport:
    mask: np.ndarray
    iterations: int
    converged: bool
    reason: str

def _dark_boundary_calibration_support(
    score: np.ndarray, valid: np.ndarray,
) -> _CalibrationSupport:
    """Exclude bright outliers from calibration, never from detection geometry.

    Bright structures have negative darkness residuals. One-sided clipping keeps
    dark evidence in the population while preventing bright structures from
    dominating the subsequent brighter-half noise estimate. The multiplier is
    independent of detection sensitivity and all state is component-local.
    """
    support = (valid > 0) & np.isfinite(score)
    if np.count_nonzero(support) < _MIN_CUTOFF_VALUES:
        return _CalibrationSupport(support, 0, False, "insufficient samples")

    for iteration in range(1, _CALIBRATION_MAX_ITERATIONS + 1):
        values = np.asarray(score[support], np.float32)
        centre = float(np.median(values))
        spread = max(
            _MIN_NORMALIZED_NOISE,
            _MAD_SCALE * float(np.median(np.abs(values - centre))),
        )
        selected = support & (score >= centre - _CALIBRATION_BRIGHT_SIGMA * spread)
        if np.array_equal(selected, support):
            return _CalibrationSupport(support, iteration, True, "converged")
        if np.count_nonzero(selected) < _MIN_CUTOFF_VALUES:
            return _CalibrationSupport(support, iteration, False, "minimum support")
        support = selected
    return _CalibrationSupport(support, _CALIBRATION_MAX_ITERATIONS, False, "iteration limit")

def _dark_boundary_robust_cutoff(
    score: np.ndarray,
    valid: np.ndarray,
    *,
    sigma: float,
    floor: float,
) -> float | None:
    """Estimate normal variation without forcing a dark class on a clean die."""
    values = np.asarray(score[valid], np.float32)
    values = values[np.isfinite(values)]
    if values.size < _MIN_CUTOFF_VALUES:
        return None

    normal = values[values <= np.median(values)]
    if normal.size < _MIN_CUTOFF_VALUES // 2:
        normal = values
    centre = float(np.median(normal))
    noise = _MAD_SCALE * float(np.median(np.abs(normal - centre)))
    return max(
        float(floor),
        centre + float(sigma) * max(_MIN_NORMALIZED_NOISE, noise),
    )

def suppress_weak_optical_rim(
    values: np.ndarray,
    candidates: np.ndarray,
    support: np.ndarray,
    boundary: np.ndarray,
    radius: int,
) -> np.ndarray:
    """Remove a weak perimeter background while preserving its darker defects.

    A component median cannot distinguish an entirely weak rim from a weak rim
    joined to a real dark patch. Assess the connected rim's background first,
    then retain its local excess for the same shape and coherence assessment as
    other candidates. Its variation must be explained by nearby material noise;
    a more variable real boundary must not be flattened into an optical rim.
    """
    count, labels, stats, _ = cv2.connectedComponentsWithStats(candidates.astype(np.uint8), 8)
    kept = candidates.copy()
    perimeter = max(1, int(np.count_nonzero(boundary)))
    adjacency = np.ones((3, 3), np.uint8)
    reach = max(1, _LOCAL_REFERENCE_REACH_RADIUS_RATIO * radius)
    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * reach + 1,) * 2)
    for region_id in range(1, count):
        # A pixel can contact at most nine contour samples through 3x3 dilation.
        if 9 * stats[region_id, cv2.CC_STAT_AREA] <= _RIM_MIN_BOUNDARY_CONTACT * perimeter:
            continue
        region = labels == region_id
        contact = np.count_nonzero(
            boundary & (cv2.dilate(region.astype(np.uint8), adjacency) > 0)
        ) / perimeter
        if contact <= _RIM_MIN_BOUNDARY_CONTACT:
            continue
        nearby = (cv2.dilate(region.astype(np.uint8), kernel) > 0) & support & ~region
        if np.count_nonzero(nearby) < _MIN_LOCAL_REFERENCE_PX:
            nearby = support & ~region
        if np.count_nonzero(nearby) < _MIN_LOCAL_REFERENCE_PX:
            continue
        nearby_values = values[nearby]
        normal = float(np.median(nearby_values))
        if normal <= 1.0:
            continue
        region_values = values[region]
        region_spread = np.median(np.abs(region_values - np.median(region_values)))
        normal_spread = np.median(np.abs(nearby_values - normal))
        if region_spread > normal_spread:
            continue
        contrast = (normal - region_values) / normal
        if np.median(contrast) < _RIM_MAX_LOCAL_CONTRAST:
            kept[region] = contrast >= _RIM_MAX_LOCAL_CONTRAST
    return kept

def _dark_boundary_raw_supported_components(
    retained: np.ndarray, raw_darkness: np.ndarray, cutoff: float
) -> np.ndarray:
    """Validate components on raw pixels without shaving their detected edges."""
    count, labels = cv2.connectedComponents(retained.astype(np.uint8), 8)
    if count <= 1:
        return retained

    threshold = max(
        _RAW_DARKNESS_FLOOR,
        _RAW_DARKNESS_CUTOFF_RATIO * cutoff,
    )
    supported = np.zeros_like(retained, dtype=bool)
    for region_id in range(1, count):
        region = labels == region_id
        if np.mean(raw_darkness[region] > threshold) >= _MIN_RAW_SUPPORT_RATIO:
            supported |= region
    return supported


# ---- core.boundary_band ----

def _boundary_band_outer_edge(inside: np.ndarray) -> np.ndarray:
    binary = np.where(inside, 255, 0).astype(np.uint8)
    contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)
    edge = np.zeros_like(binary)
    cv2.drawContours(edge, contours, -1, 255, 1)
    return edge

def boundary_depth_map(component: np.ndarray) -> np.ndarray:
    """Measure depth from the same external contour used by boundary searches.

    Image-frame pixels are contour pixels too. Default erosion borders would
    omit them and can turn a thin frame strip into a very deep apparent defect.
    """
    edge = _boundary_band_outer_edge(component > 0) > 0
    if not np.any(edge):
        return np.zeros(component.shape, np.float32)
    return cv2.distanceTransform(np.where(edge, 0, 1).astype(np.uint8), cv2.DIST_L2, 5)

def boundary_search_geometry(
    component: np.ndarray,
    radius: int,
) -> tuple[np.ndarray, np.ndarray]:
    """Return the frame-aware search band and its reusable outer edge."""
    inside = component > 0
    edge = _boundary_band_outer_edge(inside)
    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (2 * radius + 1,) * 2)
    band = cv2.dilate(edge, kernel) > 0
    return np.where(band, 255, 0).astype(np.uint8), edge


# ---- boundary_evidence.local_edge ----

_MAX_AREA_R2 = 1.5

_MAX_TANGENT_SPAN_R = 2.0

_MAX_NORMAL_SPAN_R = 1.25

_MAX_AXIS_DEVIATION_DEG = 12.0

_MAX_FLANK_RESIDUAL_R = 0.09

_MAX_CONTOUR_DEPARTURE_R = 0.12

def is_small_spot_on_straight_edge(
    points: np.ndarray,
    contours: list[np.ndarray],
    shape: tuple[int, int],
    radius: int,
) -> bool:
    """Assess pixel coordinates (x, y) before any density fragmentation.

    The supporting line uses median slopes between opposite flanks and a median
    intercept. A spot's contact with the contour does not exempt it. Conversely,
    smoothness elsewhere on the die never substitutes for local flank support.
    Contours are ordered (N, 2) arrays, cached once per material component.
    """
    if not len(points) or len(points) > _MAX_AREA_R2 * radius**2 or not contours:
        return False
    center = points.mean(axis=0)
    distances = [np.sum((arc - center) ** 2, axis=1) for arc in contours]
    arc_id = min(range(len(contours)), key=lambda i: distances[i].min())
    arc = contours[arc_id]
    nearest = int(distances[arc_id].argmin())
    origin = arc[nearest]
    n = len(arc)
    if n < 7:
        return False
    half = max(2, round(0.35 * radius))
    tangent = arc[(nearest + half) % n] - arc[(nearest - half) % n]
    norm = np.linalg.norm(tangent)
    if norm < 1e-6:
        return False
    u = tangent / norm
    v = np.array([-u[1], u[0]])
    relative = points - origin
    t, q = relative @ u, relative @ v
    tmin, tmax = t.min(), t.max()
    if (
        tmax - tmin + 1 > _MAX_TANGENT_SPAN_R * radius
        or np.ptp(q) + 1 > _MAX_NORMAL_SPAN_R * radius
    ):
        return False

    span = min(n // 2 - 1, math.ceil(2.5 * radius))
    local = arc[(nearest + np.arange(-span, span + 1)) % n]
    height, width = shape
    if np.any(
        (local[:, 0] <= 0) | (local[:, 0] >= width - 1)
        | (local[:, 1] <= 0) | (local[:, 1] >= height - 1)
    ):
        return False
    relative = local - origin
    lt, ln = relative @ u, relative @ v
    margin = max(1.0, 0.15 * radius)
    left = (lt >= tmin - margin - radius) & (lt <= tmin - margin)
    right = (lt >= tmax + margin) & (lt <= tmax + margin + radius)
    if np.count_nonzero(left) < 3 or np.count_nonzero(right) < 3:
        return False

    # Vectorized cross-flank slopes avoid a Python loop for every point pair.
    dt = lt[right][None, :] - lt[left][:, None]
    dn = ln[right][None, :] - ln[left][:, None]
    slope = float(np.median(dn / dt))
    flanks = left | right
    intercept = float(np.median(ln[flanks] - slope * lt[flanks]))
    direction = u + slope * v
    angle = math.degrees(math.atan2(direction[1], direction[0]))
    if abs((angle + 45) % 90 - 45) > _MAX_AXIS_DEVIATION_DEG:
        return False
    residual = np.abs(ln - (slope * lt + intercept))
    under_spot = (lt >= tmin - margin) & (lt <= tmax + margin)
    return bool(
        np.any(under_spot)
        and np.quantile(residual[flanks], 0.90) <= _MAX_FLANK_RESIDUAL_R * radius
        and residual[under_spot].max() <= _MAX_CONTOUR_DEPARTURE_R * radius
    )


