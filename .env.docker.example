# Copy to .env for Docker Compose. Do not commit the resulting file.
APP_PORT=8765
VG2C_GIT_CREDENTIALS_FILE=./secrets/git-credentials
VG2C_WORKSPACE_RETENTION_SECONDS=86400
VG2C_CLEANUP_INTERVAL_SECONDS=3600
VG2C_MAX_UPLOAD_BYTES=104857600
VG2C_MAX_FILE_COUNT=100
VG2C_MAX_WORKSPACE_BYTES=524288000
VG2C_COOKIE_SECURE=false
