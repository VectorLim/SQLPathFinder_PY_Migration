{
  "name": "vg2c-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "generate:contracts": "python ../../../scripts/generate_frontend_contracts.py",
    "check:contracts": "python ../../../scripts/generate_frontend_contracts.py --check",
    "typecheck": "tsc -b",
    "test:state": "node --experimental-strip-types src/workspaceState.test.ts",
    "test": "npm run check:contracts && npm run typecheck && npm run test:state",
    "build": "npm run check:contracts && tsc -b && vite build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "6.0.2",
    "vite": "8.1.5"
  }
}
